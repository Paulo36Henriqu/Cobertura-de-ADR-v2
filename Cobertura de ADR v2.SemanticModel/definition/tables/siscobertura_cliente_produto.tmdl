	/// Unidade de segmentação do cliente (grupo econômico ou raiz de CNPJ/CPF); clientes fora da segmentação viram um grupo próprio (C + cliente_id). Base dos cálculos de cobertura por grupo.
	column grupo_chave =
			VAR _u = RELATED ( segclientes_vw_clientes_atual[unidade] )
			RETURN IF ( ISBLANK ( _u ), "C" & siscobertura_cliente_produto[cliente_id], _u )
		dataType: string
		isHidden
		lineageTag: f26090ae-0481-4dce-b2bc-6825ff9505a5

