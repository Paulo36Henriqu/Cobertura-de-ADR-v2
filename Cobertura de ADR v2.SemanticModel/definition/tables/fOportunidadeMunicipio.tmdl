/// Grupo econômico (unidade) × propriedade × município da ADR (siscobertura_cidade), só grupos com ≥ 100 ha. oportunidade = MAX(0, venda média da faixa − faturamento anualizado do grupo) × peso da área da propriedade no total mapeado do grupo (inclusive fora da ADR).
table fOportunidadeMunicipio
	lineageTag: 6c4a2d6e-24f8-4c3e-b510-e5062a8c476a

	column unidade
		isHidden
		lineageTag: e6588136-f511-42ba-a306-d448001f8c0e
		isNameInferred
		sourceColumn: [unidade]

	column cliente_id
		isHidden
		lineageTag: da5f5e11-a72d-4aa4-ba2d-a2fd9049ef37
		isNameInferred
