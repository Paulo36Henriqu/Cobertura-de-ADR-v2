	partition fOportunidadeMunicipio = calculated
		mode: import
		source =
				VAR _r =
				    SELECTCOLUMNS (
				        FILTER ( segclientes_vw_propriedades_atual, segclientes_vw_propriedades_atual[id_ibge] <> "" ),
				        "unidade", RELATED ( segclientes_vw_clientes_atual[unidade] ),
				        "cliente_id", segclientes_vw_propriedades_atual[cliente_id],
				        "propriedade_id", segclientes_vw_propriedades_atual[propriedade_id],
				        "id_ibge", INT ( VALUE ( segclientes_vw_propriedades_atual[id_ibge] ) ),
				        "area", IF ( segclientes_vw_propriedades_atual[sobreposta], 0, segclientes_vw_propriedades_atual[area_ha] )
				    )
				VAR _g =
				    GROUPBY ( _r, [unidade], [cliente_id], [propriedade_id], [id_ibge], "area_ha", SUMX ( CURRENTGROUP (), [area] ) )
				VAR _c =
				    ADDCOLUMNS (
				        _g,
				        "area_grupo", LOOKUPVALUE ( segclientes_vw_unidades_atual[area_ha], segclientes_vw_unidades_atual[unidade], [unidade] ),
				        "faturamento_grupo", LOOKUPVALUE ( segclientes_vw_unidades_atual[faturamento_base], segclientes_vw_unidades_atual[unidade], [unidade] ),
				        "area_mapeada_grupo", SUMX ( FILTER ( _g, [unidade] = EARLIER ( [unidade] ) ), [area_ha] ),
				        "props_grupo", COUNTROWS ( FILTER ( _g, [unidade] = EARLIER ( [unidade] ) ) )
				    )
				VAR _f =
				    ADDCOLUMNS (
				        _c,
				        "faixa", MAXX ( FILTER ( dFaixaArea, [area_grupo] >= dFaixaArea[min_ha] && [area_grupo] < dFaixaArea[max_ha] ), dFaixaArea[faixa] ),
				        "venda_media_faixa", MAXX ( FILTER ( dFaixaArea, [area_grupo] >= dFaixaArea[min_ha] && [area_grupo] < dFaixaArea[max_ha] ), dFaixaArea[venda_media] ),
				        "peso", IF ( [area_mapeada_grupo] > 0, [area_ha] / [area_mapeada_grupo], 1 / [props_grupo] )
				    )
				VAR _adr = ALLNOBLANKROW ( siscobertura_cidade[id_ibge] )
				RETURN
				    SELECTCOLUMNS (
				        FILTER ( _f, NOT ISBLANK ( [faixa] ) && [id_ibge] IN _adr ),
				        "unidade", [unidade],
				        "cliente_id", [cliente_id],
				        "propriedade_id", [propriedade_id],
				        "id_ibge", [id_ibge],
				        "faixa", [faixa],
				        "area_ha", [area_ha],
				        "area_grupo", [area_grupo],
				        "peso", [peso],
				        "faturamento_grupo", [faturamento_grupo],
				        "venda_media_faixa", [venda_media_faixa],
				        "faturamento_rateado", [faturamento_grupo] * [peso],
				        "oportunidade", MAX ( 0, [venda_media_faixa] - [faturamento_grupo] ) * [peso]
				    )

