	partition c360_maquinas = m
		mode: import
		source =
				let
				  Fonte = Sql.Database("10.14.152.11", "DB_MKT", [Query = "WITH cli AS (SELECT cliente_id, documento FROM DB_MKT.dbo.segclientes_vw_clientes_atual), con AS (SELECT UPPER(LTRIM(RTRIM(PIN))) pin, status, ModeloMTG, ROW_NUMBER() OVER (PARTITION BY UPPER(LTRIM(RTRIM(PIN))) ORDER BY Data_Referencia DESC) rn FROM OPERATION_CENTER.dbo.HISTORICO_MAQUINAS_CONECTADAS WHERE Data_Referencia >= DATEADD(day, -30, GETDATE())), tel AS (SELECT UPPER(LTRIM(RTRIM(Numero_Serie_Maquina))) pin, Horas_Operacao_Motor_Vida_Util horas, Hora_Ultima_Chamada_Conhecida ultima_chamada, Ultima_Latitude_Conhecida lat, Ultima_Longitude_Conhecida lon, ROW_NUMBER() OVER (PARTITION BY UPPER(LTRIM(RTRIM(Numero_Serie_Maquina))) ORDER BY Data_Final DESC) rn FROM OPERATION_CENTER.dbo.DADOS_MAQUINA_RELATORIO WHERE Horas_Operacao_Motor_Vida_Util > 0), ops AS (SELECT UPPER(LTRIM(RTRIM(serialNumber))) pin, MAX(CAST(isCsc AS int)) csc FROM OPERATION_CENTER.dbo.EQUIPAMENTS_OPS GROUP BY UPPER(LTRIM(RTRIM(serialNumber)))), gar AS (SELECT UPPER(LTRIM(RTRIM(PIN))) pin, MAX(Expires) garantia_ate, MAX(CASE WHEN Expires >= CAST(GETDATE() AS date) THEN Warranty_Type END) garantia_tipo FROM OPERATION_CENTER.dbo.DADOS_GARANTIA GROUP BY UPPER(LTRIM(RTRIM(PIN)))), alt AS (SELECT UPPER(LTRIM(RTRIM(d.PIN))) pin, COUNT(*) alertas_30d, SUM(CASE WHEN a.Severity = 'HIGH' THEN 1 ELSE 0 END) alertas_criticos_30d FROM OPERATION_CENTER.dbo.Alertas a JOIN (SELECT DISTINCT ID_m, PIN FROM OPERATION_CENTER.dbo.DADOS_ID_m) d ON d.ID_m = a.ID_m WHERE a.Time >= DATEADD(day, -30, GETDATE()) AND a.Severity IN ('HIGH', 'MEDIUM') GROUP BY UPPER(LTRIM(RTRIM(d.PIN)))), tck AS (SELECT UPPER(LTRIM(RTRIM(serialNumber))) pin, COUNT(*) tickets_12m FROM OPERATION_CENTER.dbo.Exc_TICKETS WHERE createdDate >= DATEADD(month, -12, GETDATE()) AND ISNULL(Is_Deleted, 0) = 0 GROUP BY UPPER(LTRIM(RTRIM(serialNumber)))), prb AS (SELECT UPPER(LTRIM(RTRIM(NumeroSerieUltimoModelo))) pin, MAX(CategoriaProbabilidadeCompra) prob_compra, MAX(Recomendacao5Modelos) modelos_recomendados, MAX(PorcentagemProbabilidadeCompra) prob_compra_pct FROM OPERATION_CENTER.dbo.PROB_COMPRA_CLIENTE_CLG GROUP BY UPPER(LTRIM(RTRIM(NumeroSerieUltimoModelo)))) SELECT cli.cliente_id, c.chassi, c.modelo, c.produto, c.categoria_modelo, c.marca, c.ano_modelo, c.idade_anos, c.vida_util_anos, CASE WHEN c.vida_util_anos > 0 AND c.idade_anos > c.vida_util_anos THEN N'Fora da vida útil' ELSE 'Ativa' END AS situacao_vida, ISNULL(SUBSTRING(con.status, 3, 40), CASE WHEN c.marca LIKE 'JOHN DEERE%' THEN N'Não cadastrada' END) AS status_conexao, CASE WHEN con.status LIKE '1.%' THEN 1 ELSE 0 END AS conectada, ISNULL(ops.csc, 0) AS csc, con.ModeloMTG AS modem, tel.horas, tel.ultima_chamada, tel.lat, tel.lon, gar.garantia_ate, gar.garantia_tipo, ISNULL(alt.alertas_30d, 0) alertas_30d, ISNULL(alt.alertas_criticos_30d, 0) alertas_criticos_30d, ISNULL(tck.tickets_12m, 0) tickets_12m, prb.prob_compra, prb.prob_compra_pct, prb.modelos_recomendados FROM DB_MKT.dbo.siscobertura_chassis c JOIN cli ON cli.documento = c.cgccpf LEFT JOIN con ON con.pin = UPPER(LTRIM(RTRIM(c.chassi))) AND con.rn = 1 AND c.chassi <> '' LEFT JOIN tel ON tel.pin = UPPER(LTRIM(RTRIM(c.chassi))) AND tel.rn = 1 AND c.chassi <> '' LEFT JOIN ops ON ops.pin = UPPER(LTRIM(RTRIM(c.chassi))) AND c.chassi <> '' LEFT JOIN gar ON gar.pin = UPPER(LTRIM(RTRIM(c.chassi))) AND c.chassi <> '' LEFT JOIN alt ON alt.pin = UPPER(LTRIM(RTRIM(c.chassi))) AND c.chassi <> '' LEFT JOIN tck ON tck.pin = UPPER(LTRIM(RTRIM(c.chassi))) AND c.chassi <> '' LEFT JOIN prb ON prb.pin = UPPER(LTRIM(RTRIM(c.chassi))) AND c.chassi <> ''"])
				in
				  Fonte

