			defaultHierarchy: LocalDateTable_042f9e4b-de03-4758-9212-cef753069b42.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// CPF inteiro ou raiz do CNPJ (8 dígitos). O faturamento vem por chave_doc e se repete nas filiais: some uma vez por chave (mesma regra de segmentacao.chave_documento).
	column chave_doc =
			VAR _d = segclientes_vw_clientes_atual[documento]
			RETURN IF ( LEN ( _d ) = 14, LEFT ( _d, 8 ), _d )
		dataType: string
		isHidden
		lineageTag: 2eff8623-8981-4523-9999-11a80c57fc3a

	/// Nome da unidade de segmentação (grupo econômico cadastrado ou raiz de CNPJ/CPF). Nomes repetidos recebem o código da unidade.
	column grupo_nome =
			VAR _u = segclientes_vw_clientes_atual[unidade]
			VAR _nome = LOOKUPVALUE ( segclientes_vw_unidades_atual[nome], segclientes_vw_unidades_atual[unidade], _u )
			VAR _nome2 = COALESCE ( _nome, segclientes_vw_clientes_atual[grupo_economico], segclientes_vw_clientes_atual[nome] )
			VAR _rep = COUNTROWS ( FILTER ( segclientes_vw_unidades_atual, segclientes_vw_unidades_atual[nome] = _nome2 ) ) > 1
			RETURN IF ( _rep, _nome2 & " (" & _u & ")", _nome2 )
		dataType: string
		displayFolder: Grupo econômico
		lineageTag: a42f8a6e-a8dc-4768-b147-89aa101f96fd

	/// Grupo econômico cadastrado no CRM (unidade G…) ou consolidação por raiz de CNPJ/CPF (unidade D…).
	column grupo_tipo = IF ( LEFT ( segclientes_vw_clientes_atual[unidade], 1 ) = "G", "Grupo econômico", "CNPJ raiz / CPF" )
		dataType: string
		displayFolder: Grupo econômico
		lineageTag: 582a9ac7-6e49-4c2f-95b1-858e1c6703ed

