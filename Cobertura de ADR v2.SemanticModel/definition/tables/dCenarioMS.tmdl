/// Cenários de indústria. Moderado = indústria informada (projetada). Conservador e Agressivo variam por sub-região × produto (cálculo em dFolgaCenario): folga = renovação pela demanda (demanda ÷ vida útil) ÷ indústria; cobertura = parque JD válido ÷ demanda (máx. 100%); amplitude = Amplitude Base − cobertura. Agressivo = 1 + Intensidade × (folga − 1) × amplitude; Conservador = 1 − Intensidade × amplitude ÷ folga; o ajuste fica entre Piso e Teto. Edite os parâmetros aqui (DATATABLE).
table dCenarioMS
	lineageTag: 8f46e804-c844-4684-bc02-41a55bd1b755

	column Cenário
		lineageTag: 017ddde7-e155-496d-b2ab-005b7ddcc4cf
		isNameInferred
		sourceColumn: [Cenário]
		sortByColumn: Ordem

	column Ordem
		isHidden
		lineageTag: b8e4a3a7-3d4c-4bad-84e4-01804329b061
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ordem]

	column Descrição
		dataType: string
		lineageTag: f2f89308-46f7-4182-a262-c33e91f87d4e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Descrição]

	column Intensidade
		dataType: double
		formatString: 0%
		lineageTag: ec668674-d60c-491a-bcd6-663ea15c148f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Intensidade]

	column Piso
		dataType: double
		formatString: 0%
		lineageTag: fa049a7a-4b07-4564-8255-1aa50930ebd0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Piso]

	column Teto
		dataType: double
		formatString: 0%
		lineageTag: 49fa4e16-38b3-4f93-96d5-6e77064d94e2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Teto]

	column 'Amplitude Base'
		dataType: double
		formatString: 0.0
		lineageTag: 3b21c878-2268-4605-aa0d-ef5de75928d1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Amplitude Base]

	partition dCenarioMS = calculated
		mode: import
		source =
				DATATABLE (
				    "Cenário", STRING,
				    "Ordem", INTEGER,
				    "Intensidade", DOUBLE,
				    "Piso", DOUBLE,
				    "Teto", DOUBLE,
				    "Amplitude Base", DOUBLE,
				    "Descrição", STRING,
				    {
				        { "Conservador", 1, 0.20, 0.05, 0.30, 1.5, "Recua 20% × amplitude ÷ folga: cai mais onde a folga é pequena e a cobertura da frota JD é baixa (mín. 5%, máx. 30%)" },
				        { "Moderado", 2, 0, 0, 0, 1.5, "Indústria informada (base do Sistema de Cobertura)" },
				        { "Agressivo", 3, 0.50, 0.05, 0.50, 1.5, "Avança 50% da folga × amplitude: sobe mais onde a renovação supera a indústria e a cobertura da frota JD é baixa (mín. 5%, máx. 50%)" }
				    }
				)

