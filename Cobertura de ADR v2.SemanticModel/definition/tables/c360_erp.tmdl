	partition c360_erp = m
		mode: import
		source =
				let
				  Fonte = Sql.Database("10.14.152.11", "DB_MKT", [Query = "WITH cli AS (SELECT cliente_id, documento FROM DB_MKT.dbo.segclientes_vw_clientes_atual) SELECT cli.cliente_id, r.qtd_titulos_abertos, r.saldo_aberto, r.saldo_vencido, r.qtd_titulos_vencidos, r.maior_atraso_dias, r.proximo_vencimento, r.ultima_compra_balcao, r.balcao_valor_12m, r.balcao_nfs_12m, r.os_12m, r.os_abertas, r.ultima_os, r.data_atualizacao FROM DB_MKT.dbo.c360_erp_resumo r JOIN cli ON cli.documento = r.documento"])
				in
