	column chave_sr = UPPER ( siscobertura_param_metas_cen[filial] ) & "|" & siscobertura_param_metas_cen[sub_regiao]
		dataType: string
		isHidden
		lineageTag: 9c8fc3d2-81bd-49a1-a114-c7f3a661226b

	/// Filial · sub-região (CENs do zoneamento, igual ao CRM). Se a SR não existir no zoneamento, usa o CEN do CSV.
	column rotulo =
			VAR f = UPPER ( siscobertura_param_metas_cen[filial] )
			VAR sr = siscobertura_param_metas_cen[sub_regiao]
			VAR s = MAXX ( FILTER ( siscobertura_projecao_industria, UPPER ( siscobertura_projecao_industria[filial] ) = f ), siscobertura_projecao_industria[filial_sigla] )
			VAR cens =
			    CONCATENATEX (
			        DISTINCT ( SELECTCOLUMNS ( FILTER ( siscobertura_cidade, UPPER ( siscobertura_cidade[filial] ) = f && siscobertura_cidade[sub_regiao] = sr && NOT ISBLANK ( siscobertura_cidade[cen_agricola] ) ), "c", siscobertura_cidade[cen_agricola] ) ),
			        [c], ", ", [c], ASC
			    )
			RETURN COALESCE ( s, f ) & " · " & sr & "  (" & IF ( cens = "", siscobertura_param_metas_cen[cen] & " ⚠", cens ) & ")"
		dataType: string
		lineageTag: dd074574-c3a8-4119-9902-93ddeb8e7d0e

