	measure 'Status Cobertura Clientes' = ```
			
					VAR p = [% Cobertura Clientes]
					RETURN SWITCH ( TRUE (), ISBLANK ( p ), "Sem demanda", p < 0.1, "Crítico", p < 0.2, "Atenção", p < 0.4, "Adequado", "Coberto" )
			```
		displayFolder: Cobertura\2. Cores e status
		lineageTag: e373733e-1c91-41d3-82f6-8dab51bd8b84

	/// Ganhas FY só dos produtos cujo produto ou grupo tem indústria parametrizada (base do M.S. e do % da meta).
	measure 'Ganhas FY (base M.S.)' = CALCULATE ( [Ganhas FY], KEEPFILTERS ( siscobertura_projecao_produto[base_ms] = TRUE () ) )
		formatString: #,0
		isHidden
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: f223ec41-f3d5-4b1e-8aec-c66c8473d80d

	measure 'Rótulo Produtos' =
			VAR _sel = VALUES ( dProduto[produto] )
			RETURN
			    IF (
			        NOT ISFILTERED ( dProduto ) || COUNTROWS ( _sel ) = COUNTROWS ( ALL ( dProduto[produto] ) ),
			        "TODOS OS PRODUTOS",
			        CONCATENATEX ( _sel, dProduto[produto], " • ", CALCULATE ( MIN ( dProduto[ordem] ) ), ASC )
			    )
		displayFolder: Cobertura\7. Rótulos
		lineageTag: 5b2be49c-dff4-4650-94a2-cc13d2ba4979

	measure 'Título Painel Indústria' =
			VAR af = CALCULATE ( MAX ( siscobertura_projecao_industria[ano_fiscal] ), REMOVEFILTERS () )
			RETURN [Rótulo Produtos] & "  ·  ANO FISCAL FY" & RIGHT ( af, 2 )
		displayFolder: Cobertura\7. Rótulos
		lineageTag: 343ce7cd-4968-4c81-a2cf-dda0eebf6ea8

	measure 'Título Meta CEN' =
			"META × GANHAS POR FILIAL · SUB-REGIÃO  ·  "
			    & IF ( ISFILTERED ( dProduto ), [Rótulo Produtos] & " (meta rateada pelo mix)", "TR + CA" )
		displayFolder: Cobertura\7. Rótulos
		lineageTag: e9b8361a-5f72-4e4f-8daa-82c35f9f1a33

	measure 'Título Projeção Cidade' = "PROJEÇÃO POR CIDADE × PRODUTO  ·  " & [Rótulo Produtos]
		displayFolder: Cobertura\7. Rótulos
		lineageTag: 4b2126a5-5dc9-44b9-9a27-a18b2921c453

	measure 'Aviso Indústria' =
			VAR _sem =
			    FILTER (
			        VALUES ( dProduto[produto] ),
			        NOT ISBLANK ( dProduto[produto] )
			            && CALCULATE ( SUM ( siscobertura_projecao_produto[industria_estado] ) ) = 0
			    )
			RETURN
			    IF (
			        COUNTROWS ( _sem ) > 0,
			        "⚠ Sem indústria parametrizada: "
			            & CONCATENATEX ( _sem, dProduto[produto], ", ", CALCULATE ( MIN ( dProduto[ordem] ) ), ASC )
			            & " — indicadores de indústria/meta ficam zerados (cadastre o código em industria.csv). Ganhas/abertas/perdidas aparecem normalmente.",
			        "✓ Indústria parametrizada para todos os produtos selecionados"
			    )
		displayFolder: Cobertura\7. Rótulos
		lineageTag: 63735ae5-6ca1-46a7-8b58-39d2269b6a52

	/// Cor de fonte legível sobre [Cor Cobertura]: branco em vermelho/verde-escuro, grafite em laranja/verde-claro/cinza.
	measure 'Fonte Cobertura' =
