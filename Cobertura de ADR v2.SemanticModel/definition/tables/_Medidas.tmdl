	measure 'CI Sub Motivo Nº1' =
			VAR m = [CI Motivo Nº1 Perda]
			VAR q = CALCULATE ( [CI Perdidas], ci_motivo_perda[motivo] = m )
			RETURN IF ( ISBLANK ( m ), "", FORMAT ( DIVIDE ( q, [CI Perdidas c/ Motivo] ), "0.0%" ) & " das com motivo" & IF ( m = "Outros", ": genérico demais", "" ) )
		displayFolder: Inteligência Competitiva\8. Cards
