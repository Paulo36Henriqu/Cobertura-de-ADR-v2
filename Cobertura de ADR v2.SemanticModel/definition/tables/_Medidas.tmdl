	measure 'CI Sub Perdas por Preço' = VAR q = [CI Perdas por Preço] RETURN FORMAT ( DIVIDE ( q, [CI Perdidas] ), "0.0%" ) & " das perdidas · " & FORMAT ( DIVIDE ( q, [CI Perdidas c/ Motivo] ), "0.0%" ) & " das com motivo"
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: 5803d310-7bcb-4ea7-890d-cf2172a9ca40

	measure 'CI Sub Maior Δ' =
			VAR _t = CALCULATETABLE ( ci_oportunidades, KEEPFILTERS ( ci_oportunidades[resultado] IN { "Ganha", "Perdida", "Cancelada" } ), KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
			VAR _r = TOPN ( 1, _t, ci_oportunidades[delta_preco], DESC, ci_oportunidades[id], ASC )
			VAR pu = MAXX ( _r, ci_oportunidades[preco_unitario] )
			VAR pc = MAXX ( _r, ci_oportunidades[preco_concorrente] )
			VAR txtPu = IF ( pu >= 1e6, "R$ " & FORMAT ( pu / 1e6, "#,0.00" ) & " Mi", "R$ " & FORMAT ( pu / 1e3, "#,0" ) & " mil" )
			VAR txtPc = IF ( pc >= 1e6, "R$ " & FORMAT ( pc / 1e6, "#,0.00" ) & " Mi", "R$ " & FORMAT ( pc / 1e3, "#,0" ) & " mil" )
			RETURN IF ( ISEMPTY ( _r ), "", MAXX ( _r, ci_oportunidades[modelo] & " × " & ci_oportunidades[modelo_concorrente_label] ) & " (" & txtPu & " × " & txtPc & ")" )
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: 82a1ac34-07c8-42f6-a350-e3359969856c

	measure 'CI Cor KPI % Concorrente' = VAR p = [CI % P+C c/ Concorrente] RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#222222", p < 0.30, "#C0392B", p < 0.60, "#E67E22", "#2E7D32" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: c0f3c9d9-80ff-47de-8d6f-e98115d65aa2

	measure 'CI Cor KPI Vitória' = VAR p = [CI Vitória Confronto %] RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#222222", p < 0.25, "#C0392B", p < 0.40, "#E67E22", "#2E7D32" )
