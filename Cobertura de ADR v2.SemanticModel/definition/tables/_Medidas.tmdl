	measure 'CI Maior Δ Preço' = CALCULATE ( MAX ( ci_oportunidades[delta_preco] ), KEEPFILTERS ( ci_oportunidades[resultado] IN { "Ganha", "Perdida", "Cancelada" } ) )
		formatString: +0%;-0%;0%
		displayFolder: Inteligência Competitiva\5. Preço
