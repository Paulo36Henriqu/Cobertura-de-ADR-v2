	measure 'C360 Sub Pós-venda' =
			VAR _osab = SUM ( c360_erp[os_abertas] )
			VAR _tk = CALCULATE ( COUNTROWS ( c360_tickets ), c360_tickets[status] = "Aberto" )
			RETURN FORMAT ( COALESCE ( _osab, 0 ), "#,0" ) & " OS abertas · " & FORMAT ( COALESCE ( _tk, 0 ), "#,0" ) & " tickets EC"
		displayFolder: Cliente 360\1. Cartões
