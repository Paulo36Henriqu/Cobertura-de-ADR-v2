	measure 'CI Sub Perdidas' = FORMAT ( [CI % Perdidas], "0.0%" ) & " · R$ " & FORMAT ( [CI Valor Perdidas] / 1e6, "#,0" ) & " Mi"
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: 31d4edd7-6c73-4aa6-9242-606a539f9c07

	measure 'CI Sub Canceladas' = FORMAT ( [CI % Canceladas], "0.0%" ) & " · R$ " & FORMAT ( [CI Valor Canceladas] / 1e6, "#,0" ) & " Mi"
		displayFolder: Inteligência Competitiva\8. Cards
