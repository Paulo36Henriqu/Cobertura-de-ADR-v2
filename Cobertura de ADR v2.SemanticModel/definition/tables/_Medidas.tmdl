	/// Perdidas no FY. Filtro/linha de CEN usa o CEN dono da oportunidade no CRM.
	measure 'CRM Perdidas FY' =
			VAR _cens = VALUES ( siscobertura_cidade[cen_agricola] )
			RETURN
			    IF (
			        ISFILTERED ( siscobertura_cidade[cen_agricola] ),
			        CALCULATE (
			            SUM ( siscobertura_crm_cen[crm_perdidas_fy] ),
			            REMOVEFILTERS ( siscobertura_cidade[cen_agricola] ),
			            KEEPFILTERS ( TREATAS ( _cens, siscobertura_crm_cen[cen] ) )
			        ),
			        SUM ( siscobertura_crm_cen[crm_perdidas_fy] )
			    )
		formatString: #,0
		displayFolder: Cobertura\1. Base
		lineageTag: 173b3f1b-1c33-439b-bdf2-630ad46e3c10

	/// Nome do consultor no CRM para o CEN do contexto (rótulo de zoneamento).
	measure 'Consultor CEN' =
			VAR c = SELECTEDVALUE ( siscobertura_cidade[cen_agricola] )
			RETURN IF ( NOT ISBLANK ( c ), COALESCE ( LOOKUPVALUE ( siscobertura_cen[cen_nome], siscobertura_cen[cen], c ), c ) )
		displayFolder: Cobertura\7. Rótulos
		lineageTag: 2395479a-55bb-49ce-bca8-dde742db4b2c

	/// Negócios encerrados (ganha + perdida + cancelada).
	measure 'CI Encerradas' = CALCULATE ( COUNTROWS ( ci_oportunidades ), KEEPFILTERS ( ci_oportunidades[resultado] IN { "Ganha", "Perdida", "Cancelada" } ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: 6832725e-5743-4885-9bf2-79dc93c6d526

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'CI Ganhas' = CALCULATE ( COUNTROWS ( ci_oportunidades ), KEEPFILTERS ( ci_oportunidades[resultado] = "Ganha" ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: ad348f12-d395-46e2-841a-02e5cad5e16e

	measure 'CI Perdidas' = CALCULATE ( COUNTROWS ( ci_oportunidades ), KEEPFILTERS ( ci_oportunidades[resultado] = "Perdida" ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: 77aa3fd8-8be3-4475-a290-24ecb56e9b08

	measure 'CI Canceladas' = CALCULATE ( COUNTROWS ( ci_oportunidades ), KEEPFILTERS ( ci_oportunidades[resultado] = "Cancelada" ) )
