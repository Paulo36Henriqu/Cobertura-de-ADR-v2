/// Tabela apenas para organizar as medidas do relatório.
table _Medidas
	lineageTag: 5df97023-11b8-4843-a2a3-d9b3de97c80c

	/// Quantidade de clientes (linhas do CRM) na execução mais recente.
	measure Clientes = COUNTROWS ( segclientes_vw_clientes_atual )
		formatString: #,0
		displayFolder: Visão geral\1. Unidades
		lineageTag: 1757071e-438e-4f3d-a021-42d0394e9ff4

	/// Quantidade de unidades (grupo econômico / raiz de CNPJ).
	measure Unidades = DISTINCTCOUNT ( segclientes_vw_clientes_atual[unidade] )
		formatString: #,0
		displayFolder: Visão geral\1. Unidades
		lineageTag: 3a846185-4d60-4d51-9292-4f9ecba64bc2

	/// Unidades com potencial calculado (potencial_base > 0), que entram na matriz Power Sales.
	measure 'Unidades na Matriz' =
			COUNTROWS (
			    FILTER (
			        VALUES ( segclientes_vw_clientes_atual[unidade] ),
			        CALCULATE ( MAX ( segclientes_vw_clientes_atual[potencial_base] ) ) > 0
			    )
			)
		formatString: #,0
		displayFolder: Visão geral\1. Unidades
		lineageTag: 985b29da-b192-4504-a3a1-db3456b8b55a

	/// Unidades sem potencial calculado (fora da matriz).
	measure 'Unidades Sem Potencial' = [Unidades] - [Unidades na Matriz]
		formatString: #,0
		displayFolder: Visão geral\1. Unidades
		lineageTag: 6ffaf040-6e07-4fb7-bf58-a0547db712ff

	/// Soma do potencial anual das unidades (potencial_base contado uma vez por unidade).
	measure 'Potencial Total' =
			SUMX (
			    VALUES ( segclientes_vw_clientes_atual[unidade] ),
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[potencial_base] ) )
			)
		formatString: \R$ #,0.0
		displayFolder: Visão geral\2. Potencial
		lineageTag: 3d7895f6-57c1-4296-af81-87786c6b7175

	/// Potencial total ÷ unidades na matriz.
	measure 'Potencial Médio por Unidade' = DIVIDE ( [Potencial Total], [Unidades na Matriz] )
		formatString: \R$ #,0.0
		displayFolder: Visão geral\2. Potencial
		lineageTag: 6cfab21a-967d-49f8-9474-939ab4af2416

	/// Faturamento anualizado de todas as unidades (faturamento_base contado uma vez por unidade).
	measure 'Faturamento Total' =
			SUMX (
			    VALUES ( segclientes_vw_clientes_atual[unidade] ),
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[faturamento_base] ) )
			)
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: Visão geral\3. Faturamento
		lineageTag: be413c7e-c627-4ffd-9856-4b34ef54c7f8

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Faturamento anualizado das unidades com potencial calculado.
	measure 'Faturamento na Matriz' =
			SUMX (
			    FILTER (
			        VALUES ( segclientes_vw_clientes_atual[unidade] ),
			        CALCULATE ( MAX ( segclientes_vw_clientes_atual[potencial_base] ) ) > 0
			    ),
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[faturamento_base] ) )
			)
		formatString: \R$ #,0.0
		displayFolder: Visão geral\3. Faturamento
		lineageTag: 25a85a68-51c5-4da2-830e-c778afc1cae7

	/// Faturamento anualizado das unidades sem potencial calculado.
	measure 'Faturamento Sem Potencial' = [Faturamento Total] - [Faturamento na Matriz]
		formatString: \R$ #,0.0
		displayFolder: Visão geral\3. Faturamento
		lineageTag: de1f7cbc-6cb6-41c6-a2d6-8882935a3294

	/// Participação: faturamento Nissey ÷ potencial de investimento em máquinas (10% do ROB).
	measure 'Share of Wallet' = DIVIDE ( [Faturamento na Matriz], [Potencial Investimento Máquinas] )
		formatString: 0.0%
		displayFolder: Visão geral\4. Share of wallet
		lineageTag: d46656f8-588f-4f36-9b25-e5820fd4f819

	/// Linha de corte de faturamento usada na classificação (corte_faturamento_final da execução vigente). Não muda com filtros.
	measure 'Corte Faturamento' =
			VAR _execucao =
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			RETURN
			    CALCULATE (
			        MAX ( segclientes_execucao[corte_faturamento_final] ),
			        REMOVEFILTERS ( segclientes_execucao ),
			        segclientes_execucao[execucao_id] = _execucao
			    )
		formatString: \R$ #,0.00
		displayFolder: Visão geral\5. Linhas de corte
		lineageTag: 832650e5-87b1-40ae-8b03-16b230b2084e

	/// Linha de corte de potencial usada na classificação (corte_potencial_final da execução vigente). Não muda com filtros.
	measure 'Corte Potencial' =
			VAR _execucao =
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			RETURN
			    CALCULATE (
			        MAX ( segclientes_execucao[corte_potencial_final] ),
			        REMOVEFILTERS ( segclientes_execucao ),
			        segclientes_execucao[execucao_id] = _execucao
			    )
		formatString: \R$ #,0.00
		displayFolder: Visão geral\5. Linhas de corte
		lineageTag: e51e3dfa-1fe4-4479-aaad-14c63a651d48

	/// Rótulo do percentil do corte de faturamento (ex.: P95).
	measure 'Percentil Faturamento' =
			VAR _execucao =
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			RETURN
			    "Faturamento · P" & FORMAT (
			        CALCULATE (
			            MAX ( segclientes_execucao[percentil_faturamento] ),
			            REMOVEFILTERS ( segclientes_execucao ),
			            segclientes_execucao[execucao_id] = _execucao
			        ) * 100,
			        "0"
			    )
		displayFolder: Visão geral\5. Linhas de corte
		lineageTag: 3397e09e-f183-4a3f-ad46-99794a9d25f8

	/// Rótulo do percentil do corte de potencial (ex.: P90).
	measure 'Percentil Potencial' =
			VAR _execucao =
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			RETURN
			    "Potencial · P" & FORMAT (
			        CALCULATE (
			            MAX ( segclientes_execucao[percentil_potencial] ),
			            REMOVEFILTERS ( segclientes_execucao ),
			            segclientes_execucao[execucao_id] = _execucao
			        ) * 100,
			        "0"
			    )
		displayFolder: Visão geral\5. Linhas de corte
		lineageTag: a30ae637-4746-4160-a0ae-03abcebedfd7

	/// Subtítulo do cartão Unidades na matriz.
	measure 'Rótulo Unidades' =
			"de " & FORMAT ( [Unidades], "#,0" ) & " unidades · " & FORMAT ( [Clientes], "#,0" ) & " clientes"
			    & UNICHAR ( 10 ) & "Sem potencial calculado: " & FORMAT ( [Unidades Sem Potencial], "#,0" )
		displayFolder: Visão geral\6. Rótulos dos cartões
		lineageTag: 8adf5471-1a5e-4795-8d9b-e1bb16976c96

	/// Subtítulo do cartão Potencial total/ano.
	measure 'Rótulo Potencial' = "Média por unidade: " & FORMAT ( [Potencial Médio por Unidade] / 1E6, "\R$ #,0.0" ) & " MM"
		displayFolder: Visão geral\6. Rótulos dos cartões
		lineageTag: fd488e64-da7e-45df-b9c1-ebd705910bb8

	/// Subtítulo do cartão Faturamento total/ano.
	measure 'Rótulo Faturamento' =
			"Na matriz: " & FORMAT ( [Faturamento na Matriz] / 1E6, "\R$ #,0.0" ) & " MM"
			    & UNICHAR ( 10 ) & "Sem potencial: " & FORMAT ( [Faturamento Sem Potencial] / 1E6, "\R$ #,0.0" ) & " MM"
		displayFolder: Visão geral\6. Rótulos dos cartões
		lineageTag: 9e7422d5-e3d6-4b07-9cb1-401bc532f3fd

	measure 'Rotulo Clientes' =
			
			FORMAT([Clientes], "#,##0", "pt-BR") & " Clientes"
		displayFolder: Visão geral\1. Unidades
		lineageTag: 807deefa-e91a-4fff-af44-40ffbaf265fb

	/// Gráfico da matriz Power Sales (potencial × faturamento, escala log) em HTML/SVG. Usar no visual HTML Content. Responde aos filtros da página.
	measure 'Matriz Power Sales HTML' =
			-- área do gráfico (px no viewBox)
			VAR _W = 900
			VAR _H = 440
			VAR _L = 70
			VAR _R = 20
			VAR _T = 16
			VAR _B = 48
			VAR _Strip = 40                    -- faixa "sem compra" (faturamento = 0)
			VAR _X0 = _L + _Strip + 8
			VAR _X1 = _W - _R
			VAR _Y0 = _T
			VAR _Y1 = _H - _B
			-- domínio log10: X de 1 mil a 100 MM, Y de 10 mil a 1 bi
			VAR _XMin = 3
			VAR _XMax = 8
			VAR _YMin = 4
			VAR _YMax = 9
			
			VAR _CorteF = [Corte Faturamento]
			VAR _CorteP = [Corte Potencial]
			VAR _xc = INT ( _X0 + ( MIN ( MAX ( LOG10 ( MAX ( _CorteF, 1 ) ), _XMin ), _XMax ) - _XMin ) / ( _XMax - _XMin ) * ( _X1 - _X0 ) )
			VAR _yc = INT ( _Y1 - ( MIN ( MAX ( LOG10 ( MAX ( _CorteP, 1 ) ), _YMin ), _YMax ) - _YMin ) / ( _YMax - _YMin ) * ( _Y1 - _Y0 ) )
			
			-- uma linha por unidade com potencial calculado
			VAR _Pts =
			    ADDCOLUMNS (
			        FILTER (
			            ADDCOLUMNS (
			                VALUES ( segclientes_vw_clientes_atual[unidade] ),
			                "@pot", CALCULATE ( MAX ( segclientes_vw_clientes_atual[potencial_base] ) ),
			                "@fat", CALCULATE ( MAX ( segclientes_vw_clientes_atual[faturamento_base] ) ),
			                "@seg", CALCULATE ( MAX ( segclientes_vw_clientes_atual[segmento] ) ),
			                "@nome", CALCULATE ( COALESCE ( MAX ( segclientes_vw_clientes_atual[grupo_economico] ), MAX ( segclientes_vw_clientes_atual[nome] ) ) ),
			                "@local", CALCULATE ( MAX ( segclientes_vw_clientes_atual[cidade] ) & " / " & MAX ( segclientes_vw_clientes_atual[uf] ) ),
			                "@vend", CALCULATE ( COALESCE ( MAX ( segclientes_vw_clientes_atual[vendedor_ag] ), MAX ( segclientes_vw_clientes_atual[vendedor_ce] ), "-" ) )
			            ),
			            [@pot] > 0
			        ),
			        "@x", INT (
			            IF (
			                [@fat] > 0,
			                _X0 + ( MIN ( MAX ( LOG10 ( [@fat] ), _XMin ), _XMax ) - _XMin ) / ( _XMax - _XMin ) * ( _X1 - _X0 ),
			                _L + 6 + MOD ( INT ( [@pot] / 7 ), 97 ) / 97 * ( _Strip - 12 )   -- espalha os sem compra na faixa
			            )
			        ),
			        "@y", INT ( _Y1 - ( MIN ( MAX ( LOG10 ( [@pot] ), _YMin ), _YMax ) - _YMin ) / ( _YMax - _YMin ) * ( _Y1 - _Y0 ) ),
			        "@cor", SWITCH ( [@seg], "KAM/SAM", "#3a8a3a", "Cliente Estratégico", "#8a5bc4", "Varejo Foco", "#e2862a", "Varejo", "#4a6fd1", "#898781" )
			    )
			
			VAR _nKAM = COUNTROWS ( FILTER ( _Pts, [@seg] = "KAM/SAM" ) ) + 0
			VAR _nEst = COUNTROWS ( FILTER ( _Pts, [@seg] = "Cliente Estratégico" ) ) + 0
			VAR _nFoco = COUNTROWS ( FILTER ( _Pts, [@seg] = "Varejo Foco" ) ) + 0
			VAR _nVar = COUNTROWS ( FILTER ( _Pts, [@seg] = "Varejo" ) ) + 0
			VAR _nSem = COUNTROWS ( FILTER ( _Pts, [@fat] <= 0 || ISBLANK ( [@fat] ) ) ) + 0
			
			-- fundos dos quadrantes e faixa sem compra
			VAR _Fundos =
			    "<rect x='" & _L & "' y='" & _Y0 & "' width='" & _Strip & "' height='" & ( _Y1 - _Y0 ) & "' fill='#e4e4e4'/>"
			    & "<rect x='" & _X0 & "' y='" & _Y0 & "' width='" & ( _xc - _X0 ) & "' height='" & ( _yc - _Y0 ) & "' fill='#efebf8'/>"
			    & "<rect x='" & _xc & "' y='" & _Y0 & "' width='" & ( _X1 - _xc ) & "' height='" & ( _yc - _Y0 ) & "' fill='#e9f3e9'/>"
			    & "<rect x='" & _X0 & "' y='" & _yc & "' width='" & ( _xc - _X0 ) & "' height='" & ( _Y1 - _yc ) & "' fill='#e9eef9'/>"
			    & "<rect x='" & _xc & "' y='" & _yc & "' width='" & ( _X1 - _xc ) & "' height='" & ( _Y1 - _yc ) & "' fill='#fbf0e4'/>"
			
			-- grade e rótulos dos eixos
			VAR _GradeX =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 5 ),
			        VAR _px = INT ( _X0 + [Value] / 5 * ( _X1 - _X0 ) )
			        RETURN
			            "<line x1='" & _px & "' y1='" & _Y0 & "' x2='" & _px & "' y2='" & _Y1 & "' stroke='#000' stroke-opacity='.07'/>"
			            & "<text x='" & _px & "' y='" & ( _Y1 + 16 ) & "' text-anchor='middle' fill='#555'>"
			            & SWITCH ( [Value], 0, "1 mil", 1, "10 mil", 2, "100 mil", 3, "1 MM", 4, "10 MM", 5, "100 MM" ) & "</text>",
			        ""
			    )
			VAR _GradeY =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 5 ),
			        VAR _py = INT ( _Y1 - [Value] / 5 * ( _Y1 - _Y0 ) )
			        RETURN
			            "<line x1='" & _L & "' y1='" & _py & "' x2='" & _X1 & "' y2='" & _py & "' stroke='#000' stroke-opacity='.07'/>"
			            & "<text x='" & ( _L - 6 ) & "' y='" & ( _py + 4 ) & "' text-anchor='end' fill='#555'>"
			            & SWITCH ( [Value], 0, "10 mil", 1, "100 mil", 2, "1 MM", 3, "10 MM", 4, "100 MM", 5, "1 bi" ) & "</text>",
			        ""
			    )
			
			-- linhas de corte (faturamento e potencial)
			VAR _Cortes =
			    "<line x1='" & _xc & "' y1='" & _Y0 & "' x2='" & _xc & "' y2='" & _Y1 & "' stroke='#222' stroke-width='1.3' stroke-dasharray='5 3'/>"
			    & "<line x1='" & _X0 & "' y1='" & _yc & "' x2='" & _X1 & "' y2='" & _yc & "' stroke='#222' stroke-width='1.3' stroke-dasharray='5 3'/>"
			
			-- valores de corte nos eixos (etiqueta escura sobre o rótulo do eixo)
			VAR _tCorteF = IF ( _CorteF >= 1E6, FORMAT ( _CorteF / 1E6, "#,0.0" ) & " MM", FORMAT ( _CorteF / 1E3, "#,0" ) & " mil" )
			VAR _tCorteP = IF ( _CorteP >= 1E6, FORMAT ( _CorteP / 1E6, "#,0.0" ) & " MM", FORMAT ( _CorteP / 1E3, "#,0" ) & " mil" )
			VAR _EtqCortes =
			    "<rect x='" & ( _xc - 36 ) & "' y='" & ( _Y1 + 3 ) & "' width='72' height='17' rx='3' fill='#222'/>"
			    & "<text x='" & _xc & "' y='" & ( _Y1 + 15 ) & "' text-anchor='middle' fill='#fff' font-weight='700'>R$ " & _tCorteF & "</text>"
			    & "<rect x='" & ( _L - 50 ) & "' y='" & ( _yc - 9 ) & "' width='48' height='17' rx='3' fill='#222'/>"
			    & "<text x='" & ( _L - 26 ) & "' y='" & ( _yc + 3 ) & "' text-anchor='middle' fill='#fff' font-weight='700'>" & _tCorteP & "</text>"
			
			-- rótulos dos quadrantes
			VAR _Rotulos =
			    "<text x='" & ( _X0 + 8 ) & "' y='" & ( _Y0 + 20 ) & "' class='h q' fill='#6f42b0'>Cliente Estratégico · " & FORMAT ( _nEst, "#,0" ) & "</text>"
			    & "<text x='" & ( _X1 - 8 ) & "' y='" & ( _Y0 + 20 ) & "' class='h q' text-anchor='end' fill='#2f6f2f'>KAM/SAM · " & FORMAT ( _nKAM, "#,0" ) & "</text>"
			    & "<text x='" & ( _X0 + 8 ) & "' y='" & ( _Y1 - 24 ) & "' class='h q' fill='#3556b0'>Varejo · " & FORMAT ( _nVar, "#,0" ) & "</text>"
			    & "<text x='" & ( _X1 - 8 ) & "' y='" & ( _Y1 - 24 ) & "' class='h q' text-anchor='end' fill='#c06a14'>Varejo Foco · " & FORMAT ( _nFoco, "#,0" ) & "</text>"
			    & "<text transform='translate(" & INT ( _L + _Strip / 2 + 4 ) & "," & INT ( ( _Y0 + _Y1 ) / 2 ) & ") rotate(-90)' text-anchor='middle' class='h' font-weight='700' fill='#555'>SEM COMPRA · " & FORMAT ( _nSem, "#,0" ) & "</text>"
			
			-- títulos dos eixos
			VAR _Eixos =
			    "<text x='" & INT ( ( _X0 + _X1 ) / 2 ) & "' y='" & ( _H - 8 ) & "' text-anchor='middle' fill='#333'>Faturamento (R$) · média anual dos últimos 3 anos</text>"
			    & "<text transform='translate(14," & INT ( ( _Y0 + _Y1 ) / 2 ) & ") rotate(-90)' text-anchor='middle' fill='#333'>Potencial de investimento (R$)</text>"
			
			-- pontos em HTML por cima do SVG (posição em % do viewBox), com dica no :hover
			VAR _Pontos =
			    CONCATENATEX (
			        _Pts,
			        VAR _pot = [@pot]
			        VAR _fat = [@fat] + 0
			        VAR _tPot = IF ( _pot >= 1E6, FORMAT ( _pot / 1E6, "#,0.0" ) & " MM", IF ( _pot >= 1E3, FORMAT ( _pot / 1E3, "#,0" ) & " mil", FORMAT ( _pot, "#,0" ) ) )
			        VAR _tFat = IF ( _fat >= 1E6, FORMAT ( _fat / 1E6, "#,0.0" ) & " MM", IF ( _fat >= 1E3, FORMAT ( _fat / 1E3, "#,0" ) & " mil", FORMAT ( _fat, "#,0" ) ) )
			        VAR _cls = "p" & IF ( [@x] > _W - 260, " e" ) & IF ( [@y] > _H - 170, " b" )
			        RETURN
			            "<div class='" & _cls & "' style='left:calc(100% * " & [@x] & " / " & _W & ");top:calc(100% * " & [@y] & " / " & _H & ");background:" & [@cor] & "cc'>"
			            & "<div class='t'><b class='n'>" & SUBSTITUTE ( SUBSTITUTE ( [@nome], "&", "&amp;" ), "<", "&lt;" ) & "</b>"
			            & "<div><span style='color:" & [@cor] & "'>●</span> " & [@seg] & " · " & [@local] & "</div>"
			            & "<div>Vendedor: <b>" & [@vend] & "</b></div><hr>"
			            & "<div class='r'><span>Potencial de investimento</span><b>R$ " & _tPot & "</b></div>"
			            & "<div class='r'><span>Faturamento</span><b>R$ " & _tFat & "</b></div>"
			            & "<div class='r'><span>Participação</span><b>" & FORMAT ( DIVIDE ( _fat, _pot ), "0.0%" ) & "</b></div>"
			            & "</div></div>",
			        "",
			        [@pot], ASC
			    )
			
			VAR _Legenda =
			    "<div style='display:flex;gap:16px;justify-content:center;align-items:center;font-size:12px;color:#333;margin:4px 0'>"
			    & "<span><span style='display:inline-block;width:10px;height:10px;border-radius:50%;background:#3a8a3a;margin-right:5px'></span>KAM/SAM</span>"
			    & "<span><span style='display:inline-block;width:10px;height:10px;border-radius:50%;background:#8a5bc4;margin-right:5px'></span>Cliente Estratégico</span>"
			    & "<span><span style='display:inline-block;width:10px;height:10px;border-radius:50%;background:#e2862a;margin-right:5px'></span>Varejo Foco</span>"
			    & "<span><span style='display:inline-block;width:10px;height:10px;border-radius:50%;background:#4a6fd1;margin-right:5px'></span>Varejo</span>"
			    & "<span style='color:#777'>Escala logarítmica nos dois eixos</span></div>"
			
			VAR _Css =
			    "<style>"
			    & ".h{paint-order:stroke;stroke:#fff;stroke-width:3px;stroke-linejoin:round}.q{font-size:14px;font-weight:700}"
			    & ".mx{position:relative;line-height:0}.mx svg{display:block}"
			    & ".p{position:absolute;width:7px;height:7px;margin:-4px 0 0 -4px;border-radius:50%;border:1px solid #fff;line-height:normal}"
			    & ".p:hover{z-index:50;border:2px solid #222}"
			    & ".t{display:none;position:absolute;left:12px;top:-12px;width:210px;background:#fff;border:1px solid #d0d0d0;border-radius:6px;box-shadow:0 3px 10px rgba(0,0,0,.18);padding:8px 10px;font-size:11px;color:#333;pointer-events:none}"
			    & ".p:hover .t{display:block}.p.e .t{left:auto;right:12px}.p.b .t{top:auto;bottom:-12px}"
			    & ".t .n{display:block;font-size:12px;margin-bottom:3px}.t hr{border:0;border-top:1px solid #e5e5e5;margin:5px 0}"
			    & ".t .r{display:flex;justify-content:space-between}"
			    & "</style>"
			
			RETURN
			    "<div style='font-family:Segoe UI,Arial,sans-serif'>" & _Css & _Legenda
			    & "<div class='mx'><svg viewBox='0 0 " & _W & " " & _H & "' width='100%' style='font-size:11px'>"
			    & _Fundos & _GradeX & _GradeY & _Cortes & _Rotulos & _Eixos & _EtqCortes
			    & "</svg>" & _Pontos & "</div></div>"
		displayFolder: Matriz Power Sales
		lineageTag: 2e8aa369-b5b4-43a8-a6a0-300a484e5ec2

	/// Corte de faturamento para o card Linhas de corte (nome = rótulo exibido).
	measure 'Faturamento · P95' =
			VAR _v = [Corte Faturamento]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _v ), BLANK (),
			        ABS ( _v ) >= 1E6, FORMAT ( _v, "\R$ #,0,,.00 \M\M" ),
			        ABS ( _v ) >= 1E3, FORMAT ( _v, "\R$ #,0, \m\i\l" ),
			        FORMAT ( _v, "\R$ #,0" )
			    )
		displayFolder: Visão geral\5. Linhas de corte
		lineageTag: f03734f5-ea2a-4a48-8b99-98892bb09c4a

	/// Corte de potencial para o card Linhas de corte (nome = rótulo exibido).
	measure 'Potencial · P90' =
			VAR _v = [Corte Potencial]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _v ), BLANK (),
			        ABS ( _v ) >= 1E6, FORMAT ( _v, "\R$ #,0,,.00 \M\M" ),
			        ABS ( _v ) >= 1E3, FORMAT ( _v, "\R$ #,0, \m\i\l" ),
			        FORMAT ( _v, "\R$ #,0" )
			    )
		displayFolder: Visão geral\5. Linhas de corte
		lineageTag: 4ed1d59e-b26a-4b0f-9064-b925f22ff03d

	/// Faturamento Total com unidade automática por valor (Bi / MM / mil). Usar com Unidades de exibição = Nenhum.
	measure Faturamento = [Faturamento Total]
		displayFolder: Visão geral\3. Faturamento
		lineageTag: d1cb03b1-521f-45ec-9334-b91e26cc0151

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        _v >= 1E9, "\R$ #,0,,,.0 \B\i",
				        _v >= 1E6, "\R$ #,0,,.0 \M\M",
				        _v >= 1E3, "\R$ #,0, \m\i\l",
				        "\R$ #,0"
				    )

	/// Potencial Total com unidade automática por valor (Bi / MM / mil). Usar com Unidades de exibição = Nenhum.
	measure Potencial = [Potencial Total]
		displayFolder: Visão geral\2. Potencial
		lineageTag: d0246eda-1d44-4d23-89dc-94e9cdbc25dc

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        _v >= 1E9, "\R$ #,0,,,.0 \B\i",
				        _v >= 1E6, "\R$ #,0,,.0 \M\M",
				        _v >= 1E3, "\R$ #,0, \m\i\l",
				        "\R$ #,0"
				    )

	/// Tabela Resumo por Segmento em HTML (valor + % do total abaixo, com barra). Usar no visual HTML Content. Responde aos filtros da página.
	measure 'Resumo por Segmento HTML' =
			VAR _TotU = [Unidades]
			VAR _TotC = [Clientes]
			VAR _TotF = [Faturamento Total]
			VAR _TotP = [Potencial Total]
			
			VAR _Linhas =
			    FILTER (
			        ADDCOLUMNS (
			            dSegmento,
			            "@u", [Unidades],
			            "@c", [Clientes],
			            "@f", [Faturamento Total],
			            "@p", [Potencial Total],
			            "@sen", CALCULATE ( MAX ( segclientes_vw_clientes_atual[senioridade_cen] ) ),
			            "@freq", CALCULATE ( MAX ( segclientes_vw_clientes_atual[frequencia_contato] ) )
			        ),
			        NOT ISBLANK ( [@c] )
			    )
			
			VAR _Corpo =
			    CONCATENATEX (
			        _Linhas,
			        VAR _seg = dSegmento[segmento]
			        VAR _cor = SWITCH ( _seg, "KAM/SAM", "#3a8a3a", "Cliente Estratégico", "#8a5bc4", "Varejo Foco", "#e2862a", "Varejo", "#4a6fd1", "#9a9a9a" )
			        VAR _sub =
			            IF (
			                ISBLANK ( [@sen] ),
			                "Sem propriedade cadastrada no CRM",
			                "Vendedor " & [@sen] & " · contato a cada " & SUBSTITUTE ( [@freq], " – ", "–" )
			            )
			        VAR _f = [@f] + 0
			        VAR _p = [@p] + 0
			        VAR _tF = IF ( _f >= 1E9, FORMAT ( _f / 1E9, "#,0.0" ) & " bi", IF ( _f >= 1E6, FORMAT ( _f / 1E6, "#,0.0" ) & " MM", IF ( _f >= 1E3, FORMAT ( _f / 1E3, "#,0" ) & " mil", FORMAT ( _f, "#,0" ) ) ) )
			        VAR _tP = IF ( _p >= 1E9, FORMAT ( _p / 1E9, "#,0.0" ) & " bi", IF ( _p >= 1E6, FORMAT ( _p / 1E6, "#,0.0" ) & " MM", IF ( _p >= 1E3, FORMAT ( _p / 1E3, "#,0" ) & " mil", FORMAT ( _p, "#,0" ) ) ) )
			        VAR _pctU = DIVIDE ( [@u], _TotU )
			        VAR _pctC = DIVIDE ( [@c], _TotC )
			        VAR _pctF = DIVIDE ( _f, _TotF )
			        VAR _pctP = DIVIDE ( _p, _TotP )
			        VAR _barF = "<span class='bar'><i style='width:" & INT ( MIN ( _pctF, 1 ) * 100 ) & "%;background:" & _cor & "'></i></span>"
			        VAR _barP = "<span class='bar'><i style='width:" & INT ( MIN ( _pctP, 1 ) * 100 ) & "%;background:" & _cor & "'></i></span>"
			        RETURN
			            "<tr>"
			            & "<td><div class='sg'><span class='sq' style='background:" & _cor & "'></span>" & _seg & "</div><div class='sb'>" & _sub & "</div></td>"
			            & "<td class='n'><div class='v'>" & FORMAT ( [@u], "#,0" ) & "</div><div class='s'>" & FORMAT ( _pctU, "0.0%" ) & "</div></td>"
			            & "<td class='n'><div class='v'>" & FORMAT ( [@c], "#,0" ) & "</div><div class='s'>" & FORMAT ( _pctC, "0.0%" ) & "</div></td>"
			            & "<td class='n'><div class='v'>R$ " & _tF & "</div><div class='s'>" & _barF & FORMAT ( _pctF, "0.0%" ) & "</div></td>"
			            & "<td class='n'><div class='v'>" & IF ( _p > 0, "R$ " & _tP, "–" ) & "</div><div class='s'>" & IF ( _p > 0, _barP & FORMAT ( _pctP, "0.0%" ), "<span class='bar'></span>" ) & "</div></td>"
			            & "</tr>",
			        "",
			        dSegmento[segmento_ordem], ASC
			    )
			
			VAR _tTotF = IF ( _TotF >= 1E9, FORMAT ( _TotF / 1E9, "#,0.0" ) & " bi", IF ( _TotF >= 1E6, FORMAT ( _TotF / 1E6, "#,0.0" ) & " MM", IF ( _TotF >= 1E3, FORMAT ( _TotF / 1E3, "#,0" ) & " mil", FORMAT ( _TotF + 0, "#,0" ) ) ) )
			VAR _tTotP = IF ( _TotP >= 1E9, FORMAT ( _TotP / 1E9, "#,0.0" ) & " bi", IF ( _TotP >= 1E6, FORMAT ( _TotP / 1E6, "#,0.0" ) & " MM", IF ( _TotP >= 1E3, FORMAT ( _TotP / 1E3, "#,0" ) & " mil", FORMAT ( _TotP + 0, "#,0" ) ) ) )
			
			VAR _Total =
			    "<tr class='tt'><td>Total</td>"
			    & "<td class='n'>" & FORMAT ( _TotU + 0, "#,0" ) & "</td>"
			    & "<td class='n'>" & FORMAT ( _TotC + 0, "#,0" ) & "</td>"
			    & "<td class='n'>R$ " & _tTotF & "</td>"
			    & "<td class='n'>" & IF ( _TotP > 0, "R$ " & _tTotP, "–" ) & "</td></tr>"
			
			VAR _Css =
			    "<style>"
			    & ".rs{font-family:Segoe UI,Arial,sans-serif;color:#222;padding:0 4px}"
			    & ".rs table{width:100%;border-collapse:collapse;table-layout:fixed}"
			    & ".rs th{font-size:10px;font-weight:600;color:#555;letter-spacing:.3px;text-align:right;padding:6px 4px 8px;border-bottom:1px solid #ddd;white-space:nowrap}"
			    & ".rs th:first-child{text-align:left;width:34%}"
			    & ".rs td{padding:9px 4px;border-bottom:1px solid #eee;vertical-align:top}"
			    & ".rs .sg{font-size:13px;font-weight:600;display:flex;align-items:center;gap:6px}"
			    & ".rs .sq{display:inline-block;width:10px;height:10px;border-radius:2px;flex:none}"
			    & ".rs .sb{font-size:10px;color:#666;margin-top:3px;line-height:1.3}"
			    & ".rs .n{text-align:right;white-space:nowrap}"
			    & ".rs .v{font-size:13px;font-weight:600}"
			    & ".rs .s{font-size:10px;color:#666;margin-top:3px;display:flex;justify-content:flex-end;align-items:center;gap:4px}"
			    & ".rs .bar{display:inline-block;width:34px;height:4px;border-radius:2px;background:#e6e6e6;overflow:hidden}"
			    & ".rs .bar i{display:block;height:100%;border-radius:2px}"
			    & ".rs .tt td{border-top:2px solid #333;border-bottom:0;font-size:13px;font-weight:700;padding-top:10px}"
			    & ".rs .ft{font-size:10px;color:#777;margin-top:10px}"
			    & "</style>"
			
			RETURN
			    "<div class='rs'>" & _Css
			    & "<table><thead><tr><th>SEGMENTO</th><th>UNIDADES</th><th>CLIENTES</th><th>FATURAM./ANO</th><th>POTENCIAL/ANO</th></tr></thead>"
			    & "<tbody>" & _Corpo & _Total & "</tbody></table>"
			    & "<div class='ft'>Totais calculados na visão por unidade.</div></div>"
		displayFolder: Resumo por Segmento
		lineageTag: b6af0edf-a6ba-4217-ab5d-47d7fddbc0d3

	/// Participação % de cada segmento (barras 100% empilhadas: unidades, clientes, faturamento, potencial). Usar no visual HTML Content. Responde aos filtros da página.
	measure 'Participação por Segmento HTML' =
			VAR _TotU = [Unidades]
			VAR _TotC = [Clientes]
			VAR _TotF = [Faturamento Total]
			VAR _TotP = [Potencial Total]
			
			VAR _Seg =
			    FILTER (
			        ADDCOLUMNS (
			            dSegmento,
			            "@cor", SWITCH ( dSegmento[segmento], "KAM/SAM", "#3a8a3a", "Cliente Estratégico", "#8a5bc4", "Varejo Foco", "#e2862a", "Varejo", "#4a6fd1", "#a3a3a3" ),
			            "@u", DIVIDE ( [Unidades], _TotU ),
			            "@c", DIVIDE ( [Clientes], _TotC ),
			            "@f", DIVIDE ( [Faturamento Total], _TotF ),
			            "@p", DIVIDE ( [Potencial Total], _TotP )
			        ),
			        NOT ISBLANK ( [@c] )
			    )
			
			VAR _Legenda =
			    CONCATENATEX (
			        _Seg,
			        "<span class='lg'><span class='sq' style='background:" & [@cor] & "'></span>" & dSegmento[segmento] & "</span>",
			        "",
			        dSegmento[segmento_ordem], ASC
			    )
			
			-- barras: largura via flex-grow inteiro (evita decimal com vírgula no CSS)
			VAR _BarU = CONCATENATEX ( FILTER ( _Seg, [@u] > 0 ), "<div class='sgm' style='flex-grow:" & INT ( [@u] * 10000 ) & ";background:" & [@cor] & "' title='" & dSegmento[segmento] & ": " & FORMAT ( [@u], "0.0%" ) & "'>" & IF ( [@u] >= 0.07, FORMAT ( [@u], "0.0%" ) ) & "</div>", "", dSegmento[segmento_ordem], ASC )
			VAR _BarC = CONCATENATEX ( FILTER ( _Seg, [@c] > 0 ), "<div class='sgm' style='flex-grow:" & INT ( [@c] * 10000 ) & ";background:" & [@cor] & "' title='" & dSegmento[segmento] & ": " & FORMAT ( [@c], "0.0%" ) & "'>" & IF ( [@c] >= 0.07, FORMAT ( [@c], "0.0%" ) ) & "</div>", "", dSegmento[segmento_ordem], ASC )
			VAR _BarF = CONCATENATEX ( FILTER ( _Seg, [@f] > 0 ), "<div class='sgm' style='flex-grow:" & INT ( [@f] * 10000 ) & ";background:" & [@cor] & "' title='" & dSegmento[segmento] & ": " & FORMAT ( [@f], "0.0%" ) & "'>" & IF ( [@f] >= 0.07, FORMAT ( [@f], "0.0%" ) ) & "</div>", "", dSegmento[segmento_ordem], ASC )
			VAR _BarP = CONCATENATEX ( FILTER ( _Seg, [@p] > 0 ), "<div class='sgm' style='flex-grow:" & INT ( [@p] * 10000 ) & ";background:" & [@cor] & "' title='" & dSegmento[segmento] & ": " & FORMAT ( [@p], "0.0%" ) & "'>" & IF ( [@p] >= 0.07, FORMAT ( [@p], "0.0%" ) ) & "</div>", "", dSegmento[segmento_ordem], ASC )
			
			VAR _Css =
			    "<style>"
			    & ".pz{font-family:Segoe UI,Arial,sans-serif;color:#222;display:flex;flex-direction:column;gap:7px;padding:2px 4px}"
			    & ".pz .lgs{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 18px;font-size:17px;color:#333;margin-bottom:3px}"
			    & ".pz .lg{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}"
			    & ".pz .sq{display:inline-block;width:14px;height:14px;border-radius:3px}"
			    & ".pz .row{display:flex;align-items:center;gap:12px}"
			    & ".pz .lb{width:120px;flex:none;font-size:18px;font-weight:600;color:#333;text-align:right}"
			    & ".pz .bar{flex:1;display:flex;height:30px;border-radius:5px;overflow:hidden;background:#eee}"
			    & ".pz .sgm{display:flex;align-items:center;justify-content:center;flex-basis:0;min-width:3px;font-size:17px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;border-right:2px solid #fff}"
			    & ".pz .sgm:last-child{border-right:0}"
			    & "</style>"
			
			RETURN
			    "<div class='pz'>" & _Css
			    & "<div class='lgs'>" & _Legenda & "</div>"
			    & "<div class='row'><div class='lb'>Unidades</div><div class='bar'>" & _BarU & "</div></div>"
			    & "<div class='row'><div class='lb'>Clientes</div><div class='bar'>" & _BarC & "</div></div>"
			    & "<div class='row'><div class='lb'>Faturamento</div><div class='bar'>" & _BarF & "</div></div>"
			    & "<div class='row'><div class='lb'>Potencial</div><div class='bar'>" & _BarP & "</div></div>"
			    & "</div>"
		displayFolder: Resumo por Segmento
		lineageTag: dcc7418f-66ce-422a-a9a6-26ab5db62a13

	/// Matriz Power Sales com todas as unidades em cinza e a unidade selecionada destacada (Ficha do cliente). Usar no visual HTML Content. Requer uma única unidade no contexto (segmentação ou drill-through).
	measure 'Matriz Posição Cliente HTML' =
			-- área do gráfico (px no viewBox)
			VAR _W = 520
			VAR _H = 480
			VAR _L = 74
			VAR _R = 20
			VAR _T = 12
			VAR _B = 52
			VAR _Strip = 26                    -- faixa "sem compra"
			VAR _X0 = _L + _Strip + 6
			VAR _X1 = _W - _R
			VAR _Y0 = _T
			VAR _Y1 = _H - _B
			VAR _XMin = 3
			VAR _XMax = 8
			VAR _YMin = 4
			VAR _YMax = 9
			
			VAR _CorteF = [Corte Faturamento]
			VAR _CorteP = [Corte Potencial]
			VAR _xc = INT ( _X0 + ( MIN ( MAX ( LOG10 ( MAX ( _CorteF, 1 ) ), _XMin ), _XMax ) - _XMin ) / ( _XMax - _XMin ) * ( _X1 - _X0 ) )
			VAR _yc = INT ( _Y1 - ( MIN ( MAX ( LOG10 ( MAX ( _CorteP, 1 ) ), _YMin ), _YMax ) - _YMin ) / ( _YMax - _YMin ) * ( _Y1 - _Y0 ) )
			
			-- unidade selecionada
			VAR _Sel = VALUES ( segclientes_vw_clientes_atual[unidade] )
			VAR _TemSel = COUNTROWS ( _Sel ) = 1
			VAR _SelPot = MAX ( segclientes_vw_clientes_atual[potencial_base] )
			VAR _SelFat = MAX ( segclientes_vw_clientes_atual[faturamento_base] ) + 0
			VAR _SelSeg = MAX ( segclientes_vw_clientes_atual[segmento] )
			VAR _SelNome = COALESCE ( MAX ( segclientes_vw_clientes_atual[grupo_economico] ), MIN ( segclientes_vw_clientes_atual[nome] ) )
			VAR _SelCor = SWITCH ( _SelSeg, "KAM/SAM", "#3a8a3a", "Cliente Estratégico", "#8a5bc4", "Varejo Foco", "#e2862a", "Varejo", "#4a6fd1", "#898781" )
			
			-- todas as unidades (ignora filtros) como fundo cinza
			VAR _Pts =
			    CALCULATETABLE (
			        FILTER (
			            ADDCOLUMNS (
			                VALUES ( segclientes_vw_clientes_atual[unidade] ),
			                "@pot", CALCULATE ( MAX ( segclientes_vw_clientes_atual[potencial_base] ) ),
			                "@fat", CALCULATE ( MAX ( segclientes_vw_clientes_atual[faturamento_base] ) )
			            ),
			            [@pot] > 0
			        ),
			        REMOVEFILTERS ( segclientes_vw_clientes_atual ),
			        REMOVEFILTERS ( dSegmento )
			    )
			VAR _Fundo =
			    CONCATENATEX (
			        _Pts,
			        VAR _x = INT ( IF ( [@fat] > 0, _X0 + ( MIN ( MAX ( LOG10 ( [@fat] ), _XMin ), _XMax ) - _XMin ) / ( _XMax - _XMin ) * ( _X1 - _X0 ), _L + 4 + MOD ( INT ( [@pot] / 7 ), 97 ) / 97 * ( _Strip - 8 ) ) )
			        VAR _y = INT ( _Y1 - ( MIN ( MAX ( LOG10 ( [@pot] ), _YMin ), _YMax ) - _YMin ) / ( _YMax - _YMin ) * ( _Y1 - _Y0 ) )
			        RETURN "<circle cx='" & _x & "' cy='" & _y & "' r='2'/>",
			        ""
			    )
			
			-- quadrantes, grade e eixos
			VAR _Quad =
			    "<rect x='" & _L & "' y='" & _Y0 & "' width='" & _Strip & "' height='" & ( _Y1 - _Y0 ) & "' fill='#ececec'/>"
			    & "<rect x='" & _X0 & "' y='" & _Y0 & "' width='" & ( _xc - _X0 ) & "' height='" & ( _yc - _Y0 ) & "' fill='#f1eef9'/>"
			    & "<rect x='" & _xc & "' y='" & _Y0 & "' width='" & ( _X1 - _xc ) & "' height='" & ( _yc - _Y0 ) & "' fill='#ebf4eb'/>"
			    & "<rect x='" & _X0 & "' y='" & _yc & "' width='" & ( _xc - _X0 ) & "' height='" & ( _Y1 - _yc ) & "' fill='#ebeffa'/>"
			    & "<rect x='" & _xc & "' y='" & _yc & "' width='" & ( _X1 - _xc ) & "' height='" & ( _Y1 - _yc ) & "' fill='#fcf2e7'/>"
			VAR _GradeX =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 5 ),
			        VAR _px = INT ( _X0 + [Value] / 5 * ( _X1 - _X0 ) )
			        RETURN
			            "<line x1='" & _px & "' y1='" & _Y0 & "' x2='" & _px & "' y2='" & _Y1 & "' stroke='#000' stroke-opacity='.07'/>"
			            & "<text x='" & _px & "' y='" & ( _Y1 + 18 ) & "' text-anchor='middle' fill='#444'>"
			            & SWITCH ( [Value], 0, "1 mil", 1, "10 mil", 2, "100 mil", 3, "1 MM", 4, "10 MM", 5, "100 MM" ) & "</text>",
			        ""
			    )
			VAR _GradeY =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 5 ),
			        VAR _py = INT ( _Y1 - [Value] / 5 * ( _Y1 - _Y0 ) )
			        RETURN
			            "<line x1='" & _L & "' y1='" & _py & "' x2='" & _X1 & "' y2='" & _py & "' stroke='#000' stroke-opacity='.07'/>"
			            & "<text x='" & ( _L - 5 ) & "' y='" & ( _py + 5 ) & "' text-anchor='end' fill='#444'>"
			            & SWITCH ( [Value], 0, "10 mil", 1, "100 mil", 2, "1 MM", 3, "10 MM", 4, "100 MM", 5, "1 bi" ) & "</text>",
			        ""
			    )
			VAR _Cortes =
			    "<line x1='" & _xc & "' y1='" & _Y0 & "' x2='" & _xc & "' y2='" & _Y1 & "' stroke='#222' stroke-width='1.3' stroke-dasharray='5 3'/>"
			    & "<line x1='" & _X0 & "' y1='" & _yc & "' x2='" & _X1 & "' y2='" & _yc & "' stroke='#222' stroke-width='1.3' stroke-dasharray='5 3'/>"
			VAR _Rotulos =
			    "<text x='" & ( _X0 + 6 ) & "' y='" & ( _Y0 + 19 ) & "' class='h q' fill='#6f42b0'>Cliente Estratégico</text>"
			    & "<text x='" & ( _X1 - 6 ) & "' y='" & ( _Y0 + 19 ) & "' class='h q' text-anchor='end' fill='#2f6f2f'>KAM/SAM</text>"
			    & "<text x='" & ( _X0 + 6 ) & "' y='" & ( _Y1 - 9 ) & "' class='h q' fill='#3556b0'>Varejo</text>"
			    & "<text x='" & ( _X1 - 6 ) & "' y='" & ( _Y1 - 9 ) & "' class='h q' text-anchor='end' fill='#c06a14'>Varejo Foco</text>"
			    & "<text transform='translate(" & INT ( _L + _Strip / 2 + 4 ) & "," & INT ( ( _Y0 + _Y1 ) / 2 ) & ") rotate(-90)' text-anchor='middle' class='h' font-size='11' font-weight='700' fill='#555' letter-spacing='1'>SEM COMPRA</text>"
			VAR _Eixos =
			    "<text x='" & INT ( ( _X0 + _X1 ) / 2 ) & "' y='" & ( _H - 6 ) & "' text-anchor='middle' font-size='13' fill='#333'>Faturamento médio anual, últimos 36 meses (R$/ano)</text>"
			    & "<text transform='translate(15," & INT ( ( _Y0 + _Y1 ) / 2 ) & ") rotate(-90)' text-anchor='middle' font-size='13' fill='#333'>Potencial de compra (R$/ano)</text>"
			
			-- ponto destacado
			VAR _sx = INT ( IF ( _SelFat > 0, _X0 + ( MIN ( MAX ( LOG10 ( _SelFat ), _XMin ), _XMax ) - _XMin ) / ( _XMax - _XMin ) * ( _X1 - _X0 ), _L + _Strip / 2 ) )
			VAR _sy = INT ( _Y1 - ( MIN ( MAX ( LOG10 ( MAX ( _SelPot, 1 ) ), _YMin ), _YMax ) - _YMin ) / ( _YMax - _YMin ) * ( _Y1 - _Y0 ) )
			VAR _NomeEsc = SUBSTITUTE ( SUBSTITUTE ( _SelNome, "&", "&amp;" ), "<", "&lt;" )
			VAR _LblDir = _sx < _W - 200
			VAR _Destaque =
			    "<line x1='" & _L & "' y1='" & _sy & "' x2='" & _sx & "' y2='" & _sy & "' stroke='#222' stroke-opacity='.6' stroke-dasharray='2 3'/>"
			    & "<line x1='" & _sx & "' y1='" & _sy & "' x2='" & _sx & "' y2='" & _Y1 & "' stroke='#222' stroke-opacity='.6' stroke-dasharray='2 3'/>"
			    & "<circle cx='" & _sx & "' cy='" & _sy & "' r='11' fill='#fff' stroke='#222' stroke-width='2.2'/>"
			    & "<circle cx='" & _sx & "' cy='" & _sy & "' r='6' fill='" & _SelCor & "'/>"
			    & "<text x='" & IF ( _LblDir, _sx + 16, _sx - 16 ) & "' y='" & ( _sy - 12 ) & "' text-anchor='" & IF ( _LblDir, "start", "end" ) & "' class='h' font-size='16' font-weight='700' fill='#111'>" & _NomeEsc & "</text>"
			
			VAR _Msg =
			    VAR _txt = IF ( NOT _TemSel, "Selecione uma unidade para ver a posição", "Unidade sem potencial calculado (fora da matriz)" )
			    RETURN
			        "<rect x='" & INT ( ( _X0 + _X1 ) / 2 - 175 ) & "' y='" & INT ( ( _Y0 + _Y1 ) / 2 - 20 ) & "' width='350' height='40' rx='6' fill='#fff' stroke='#ccc'/>"
			        & "<text x='" & INT ( ( _X0 + _X1 ) / 2 ) & "' y='" & INT ( ( _Y0 + _Y1 ) / 2 + 5 ) & "' text-anchor='middle' font-size='14' fill='#444'>" & _txt & "</text>"
			
			VAR _Css =
			    "<style>.h{paint-order:stroke;stroke:#fff;stroke-width:3.5px;stroke-linejoin:round}.q{font-size:14px;font-weight:700}</style>"
			
			RETURN
			    "<div style='font-family:Segoe UI,Arial,sans-serif'>" & _Css
			    & "<svg viewBox='0 0 " & _W & " " & _H & "' width='100%' style='display:block;font-size:12px'>"
			    & _Quad & _GradeX & _GradeY
			    & "<g fill='#8c8c8c' fill-opacity='.35'>" & _Fundo & "</g>"
			    & _Cortes & _Rotulos & _Eixos
			    & IF ( _TemSel && _SelPot > 0, _Destaque, _Msg )
			    & "</svg></div>"
		displayFolder: Ficha do cliente
		lineageTag: 5a9a1143-a190-46c8-b2d0-315b7c330b4a

	/// Quadro principal da Ficha do cliente (nome, segmento, regra de atendimento e dados cadastrais da unidade). Usar no visual HTML Content. Requer uma única unidade no contexto.
	measure 'Ficha Cabeçalho HTML' =
			VAR _TemSel = COUNTROWS ( VALUES ( segclientes_vw_clientes_atual[unidade] ) ) = 1
			
			VAR _Grupo = MAX ( segclientes_vw_clientes_atual[grupo_economico] )
			VAR _Nome = COALESCE ( _Grupo, MIN ( segclientes_vw_clientes_atual[nome] ) )
			VAR _Seg = MAX ( segclientes_vw_clientes_atual[segmento] )
			VAR _Cor = SWITCH ( _Seg, "KAM/SAM", "#3a8a3a", "Cliente Estratégico", "#8a5bc4", "Varejo Foco", "#e2862a", "Varejo", "#4a6fd1", "#898781" )
			VAR _Sen = MAX ( segclientes_vw_clientes_atual[senioridade_cen] )
			VAR _Freq = SUBSTITUTE ( MAX ( segclientes_vw_clientes_atual[frequencia_contato] ), " – ", "–" )
			VAR _Regra =
			    IF (
			        ISBLANK ( _Sen ),
			        "<b>sem regra definida</b> (sem potencial calculado)",
			        "<b>vendedor " & _Sen & " · contato a cada " & _Freq & "</b>"
			    )
			
			-- cidade / UF: primeira + quantidade extra
			VAR _TabCid = SUMMARIZE ( segclientes_vw_clientes_atual, segclientes_vw_clientes_atual[cidade], segclientes_vw_clientes_atual[uf] )
			VAR _nCid = COUNTROWS ( _TabCid )
			VAR _Cid =
			    MINX ( TOPN ( 1, _TabCid, segclientes_vw_clientes_atual[cidade], ASC ), segclientes_vw_clientes_atual[cidade] & " / " & segclientes_vw_clientes_atual[uf] )
			    & IF ( _nCid > 1, " <span class='mx'>+" & ( _nCid - 1 ) & "</span>" )
			
			VAR _Linha = CONCATENATEX ( FILTER ( VALUES ( segclientes_vw_clientes_atual[linha_negocio] ), NOT ISBLANK ( segclientes_vw_clientes_atual[linha_negocio] ) ), segclientes_vw_clientes_atual[linha_negocio], ", ", segclientes_vw_clientes_atual[linha_negocio], ASC )
			VAR _AG = CONCATENATEX ( FILTER ( VALUES ( segclientes_vw_clientes_atual[vendedor_ag] ), NOT ISBLANK ( segclientes_vw_clientes_atual[vendedor_ag] ) ), segclientes_vw_clientes_atual[vendedor_ag], ", ", segclientes_vw_clientes_atual[vendedor_ag], ASC )
			VAR _CE = CONCATENATEX ( FILTER ( VALUES ( segclientes_vw_clientes_atual[vendedor_ce] ), NOT ISBLANK ( segclientes_vw_clientes_atual[vendedor_ce] ) ), segclientes_vw_clientes_atual[vendedor_ce], ", ", segclientes_vw_clientes_atual[vendedor_ce], ASC )
			VAR _Tipo = CONCATENATEX ( FILTER ( VALUES ( segclientes_vw_clientes_atual[tipo_crm] ), NOT ISBLANK ( segclientes_vw_clientes_atual[tipo_crm] ) ), segclientes_vw_clientes_atual[tipo_crm], ", ", segclientes_vw_clientes_atual[tipo_crm], ASC )
			VAR _Ativ = CONCATENATEX ( FILTER ( VALUES ( segclientes_vw_clientes_atual[atividade_crm] ), NOT ISBLANK ( segclientes_vw_clientes_atual[atividade_crm] ) ), segclientes_vw_clientes_atual[atividade_crm], ", ", segclientes_vw_clientes_atual[atividade_crm], ASC )
			VAR _nCli = COUNTROWS ( segclientes_vw_clientes_atual )
			VAR _Area = SUM ( segclientes_vw_clientes_atual[area_ha] )
			VAR _Ult = MAX ( segclientes_vw_clientes_atual[ultima_compra] )
			
			VAR _Campo = "<div class='f'><div class='l'>{l}</div><div class='v'>{v}</div></div>"
			VAR _Txt = "–"
			VAR _Grade =
			    SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Grupo econômico" ), "{v}", IF ( ISBLANK ( _Grupo ), "CNPJ único", SUBSTITUTE ( _Grupo, "&", "&amp;" ) ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Cidade / UF" ), "{v}", IF ( _nCid = 0, _Txt, _Cid ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Linha de negócio" ), "{v}", IF ( _Linha = "", _Txt, _Linha ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Vendedor AG" ), "{v}", IF ( _AG = "", _Txt, _AG ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Vendedor CE" ), "{v}", IF ( _CE = "", _Txt, _CE ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Tipo no CRM" ), "{v}", IF ( _Tipo = "", _Txt, _Tipo ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Atividade" ), "{v}", IF ( _Ativ = "", _Txt, _Ativ ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Clientes na unidade" ), "{v}", FORMAT ( _nCli, "#,0" ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Área produtiva" ), "{v}", IF ( _Area > 0, FORMAT ( _Area, "#,0" ) & " ha", _Txt ) )
			    & SUBSTITUTE ( SUBSTITUTE ( _Campo, "{l}", "Última compra" ), "{v}", IF ( ISBLANK ( _Ult ), "sem compra", FORMAT ( _Ult, "dd/mm/yyyy" ) ) )
			
			VAR _Css =
			    "<style>"
			    & "html,body{margin:0;overflow:hidden}"
			    & ".fc{font-family:Segoe UI,Arial,sans-serif;color:#222;padding:2px 8px;overflow:hidden;box-sizing:border-box}"
			    & ".fc .tt{display:flex;align-items:center;gap:12px;margin-bottom:12px;min-width:0}"
			    & ".fc .nm{font-size:26px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:0 1 auto}"
			    & ".fc .pl{display:inline-flex;align-items:center;gap:6px;flex:none;font-size:14px;font-weight:600;padding:3px 11px;border-radius:14px}"
			    & ".fc .dt{width:9px;height:9px;border-radius:50%}"
			    & ".fc .rg{flex:0 1 auto;min-width:0;background:#f1f1f1;border-radius:5px;padding:5px 12px;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-left:6px}"
			    & ".fc .gd{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px 18px}"
			    & ".fc .l{font-size:13px;color:#666;line-height:16px}"
			    & ".fc .v{font-size:16px;font-weight:700;line-height:22px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".fc .mx{font-weight:600;color:#777;font-size:13px}"
			    & ".fc .vz{font-size:17px;color:#666;padding:50px 0;text-align:center}"
			    & "</style>"
			
			RETURN
			    IF (
			        NOT _TemSel,
			        "<div class='fc'>" & _Css & "<div class='vz'>Selecione uma unidade (segmentação “Trocar unidade” ou drill-through) para ver a ficha.</div></div>",
			        "<div class='fc'>" & _Css
			        & "<div class='tt'><span class='nm' title='" & SUBSTITUTE ( SUBSTITUTE ( _Nome, "&", "&amp;" ), "'", "&#39;" ) & "'>" & SUBSTITUTE ( SUBSTITUTE ( _Nome, "&", "&amp;" ), "<", "&lt;" ) & "</span>"
			        & "<span class='pl' style='background:" & _Cor & "1f;color:#222'><span class='dt' style='background:" & _Cor & "'></span>" & _Seg & "</span>"
			        & "<span class='rg'>Regra de atendimento: " & _Regra & "</span></div>"
			        & "<div class='gd'>" & _Grade & "</div>"
			        & "</div>"
			    )
		displayFolder: Ficha do cliente
		lineageTag: 4b3c3a13-6d5a-4073-bccb-d30b271acffe

	/// Faturamento anualizado de máquinas (contado uma vez por chave_doc).
	measure 'Fat Máquinas' =
			SUMX (
			    VALUES ( segclientes_vw_clientes_atual[chave_doc] ),
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[fat_maquinas] ) )
			)
		formatString: \R$ #,0
		displayFolder: Visão geral\3. Faturamento\Por categoria
		lineageTag: 070ae50c-4f99-4889-8509-6b8a604860fc

	/// Faturamento anualizado de peças (contado uma vez por chave_doc).
	measure 'Fat Peças' =
			SUMX (
			    VALUES ( segclientes_vw_clientes_atual[chave_doc] ),
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[fat_pecas] ) )
			)
		formatString: \R$ #,0
		displayFolder: Visão geral\3. Faturamento\Por categoria
		lineageTag: bce98d59-28eb-4435-8be5-518f1f164d8a

	/// Faturamento anualizado de serviços (contado uma vez por chave_doc).
	measure 'Fat Serviços' =
			SUMX (
			    VALUES ( segclientes_vw_clientes_atual[chave_doc] ),
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[fat_servicos] ) )
			)
		formatString: \R$ #,0
		displayFolder: Visão geral\3. Faturamento\Por categoria
		lineageTag: f346928c-f171-4048-a8b3-2f5b63266f74

	/// Faturamento anualizado por categoria (máquinas, peças, serviços) com barras + última compra. Usar no visual HTML Content.
	measure 'Ficha Faturamento Categoria HTML' =
			VAR _TemSel = COUNTROWS ( VALUES ( segclientes_vw_clientes_atual[unidade] ) ) = 1
			VAR _Maq = [Fat Máquinas] + 0
			VAR _Pec = [Fat Peças] + 0
			VAR _Ser = [Fat Serviços] + 0
			VAR _Max = MAX ( MAX ( _Maq, _Pec ), _Ser )
			VAR _Ult = MAX ( segclientes_vw_clientes_atual[ultima_compra] )
			VAR _Ref = MAX ( segclientes_vw_clientes_atual[data_referencia] )
			VAR _Meses = IF ( NOT ISBLANK ( _Ult ), INT ( DATEDIFF ( _Ult, _Ref, DAY ) / 30.4 ) )
			VAR _TxtUlt =
			    IF (
			        ISBLANK ( _Ult ),
			        "sem compra registrada",
			        FORMAT ( _Ult, "dd/mm/yyyy" ) & " · " & IF ( _Meses <= 0, "há menos de 1 mês", "há " & _Meses & IF ( _Meses = 1, " mês", " meses" ) )
			    )
			VAR _Linha =
			    "<div class='rw'><div class='lb'>{n}</div><div class='tr'><i style='width:{w}%;background:{c}'></i></div><div class='vl'>{v}</div></div>"
			VAR _Linhas =
			    CONCATENATEX (
			        DATATABLE ( "ord", INTEGER, "nome", STRING, "cor", STRING, { { 1, "Máquinas", "#3a7d2c" }, { 2, "Peças", "#d9b92f" }, { 3, "Serviços", "#8c9196" } } ),
			        VAR _v = SWITCH ( [ord], 1, _Maq, 2, _Pec, _Ser )
			        VAR _t = IF ( _v >= 1E6, FORMAT ( _v / 1E6, "#,0.0" ) & " MM", IF ( _v >= 1E3, FORMAT ( _v / 1E3, "#,0" ) & " mil", FORMAT ( _v, "#,0" ) ) )
			        VAR _w = IF ( _Max > 0, INT ( _v / _Max * 100 ), 0 )
			        RETURN
			            SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Linha, "{n}", [nome] ), "{w}", _w ), "{c}", [cor] ), "{v}", "R$ " & _t ),
			        "",
			        [ord], ASC
			    )
			VAR _Css =
			    "<style>"
			    & "html,body{margin:0;overflow:hidden}"
			    & ".fcat{font-family:Segoe UI,Arial,sans-serif;color:#222;padding:4px 8px}"
			    & ".fcat .rw{display:flex;align-items:center;gap:14px;margin-bottom:10px}"
			    & ".fcat .lb{width:86px;flex:none;font-size:15px;color:#333}"
			    & ".fcat .tr{flex:1;height:18px}"
			    & ".fcat .tr i{display:block;height:100%;min-width:2px;border-radius:2px}"
			    & ".fcat .vl{width:110px;flex:none;text-align:right;font-size:15px;font-weight:700;white-space:nowrap}"
			    & ".fcat .ul{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #e3e3e3;margin-top:4px;padding-top:12px;font-size:14px;color:#666}"
			    & ".fcat .ul b{color:#222;font-size:14px}"
			    & ".fcat .vz{font-size:15px;color:#666;padding:30px 0;text-align:center}"
			    & "</style>"
			RETURN
			    IF (
			        NOT _TemSel,
			        "<div class='fcat'>" & _Css & "<div class='vz'>Selecione uma unidade</div></div>",
			        "<div class='fcat'>" & _Css & _Linhas
			        & "<div class='ul'><span>Última compra</span><b>" & _TxtUlt & "</b></div></div>"
			    )
		displayFolder: Ficha do cliente
		lineageTag: e1179c3a-58f7-4699-bf5c-89d9b7611687

	/// Tabela de propriedades e culturas da unidade (área, produtividade, preço, ROB e potencial) com total. Área sobreposta (2ª safra) não soma no total. Usar no visual HTML Content.
	measure 'Ficha Propriedades HTML' =
			VAR _TemSel = COUNTROWS ( VALUES ( segclientes_vw_clientes_atual[unidade] ) ) = 1
			VAR _Props =
			    CALCULATETABLE ( segclientes_vw_propriedades_atual )
			VAR _n = COUNTROWS ( _Props )
			VAR _Custo = MAXX ( _Props, segclientes_vw_propriedades_atual[custo_operacional] )
			
			VAR _Corpo =
			    CONCATENATEX (
			        _Props,
			        VAR _cult = segclientes_vw_propriedades_atual[cultura]
			        VAR _cultTxt = UPPER ( LEFT ( _cult, 1 ) ) & LOWER ( MID ( _cult, 2, 200 ) )
			        VAR _fonte = segclientes_vw_propriedades_atual[fonte]
			        VAR _fonteTxt = IF ( SEARCH ( " (", _fonte, 1, 0 ) > 0, LEFT ( _fonte, SEARCH ( " (", _fonte, 1, 0 ) - 1 ), _fonte )
			        VAR _sob = segclientes_vw_propriedades_atual[sobreposta]
			        VAR _area = segclientes_vw_propriedades_atual[area_ha]
			        VAR _sc = segclientes_vw_propriedades_atual[produtividade_sc_ha]
			        VAR _ua = segclientes_vw_propriedades_atual[unidades_animais]
			        VAR _psc = segclientes_vw_propriedades_atual[preco_saca]
			        VAR _rob = segclientes_vw_propriedades_atual[rob] + 0
			        VAR _pot = segclientes_vw_propriedades_atual[potencial] + 0
			        VAR _tRob = IF ( _rob >= 1E6, FORMAT ( _rob / 1E6, "#,0.0" ) & " MM", IF ( _rob >= 1E3, FORMAT ( _rob / 1E3, "#,0" ) & " mil", FORMAT ( _rob, "#,0" ) ) )
			        VAR _tPot = IF ( _pot >= 1E6, FORMAT ( _pot / 1E6, "#,0.0" ) & " MM", IF ( _pot >= 1E3, FORMAT ( _pot / 1E3, "#,0" ) & " mil", FORMAT ( _pot, "#,0" ) ) )
			        VAR _nome = SUBSTITUTE ( SUBSTITUTE ( COALESCE ( segclientes_vw_propriedades_atual[propriedade], "(sem nome)" ), "&", "&amp;" ), "<", "&lt;" )
			        RETURN
			            "<tr><td><div class='pn' title='" & SUBSTITUTE ( _nome, "'", "&#39;" ) & "'>" & _nome & "</div><div class='ps'>" & _cultTxt & " · " & _fonteTxt & IF ( _sob, " · <span class='sf'>2ª safra</span>" ) & "</div></td>"
			            & "<td class='n'>" & IF ( _area > 0, FORMAT ( _area, "#,0" ), "–" ) & "</td>"
			            & "<td class='n'>" & IF ( _sc > 0, FORMAT ( _sc, "#,0" ) & " <span class='u'>sc/ha</span>", IF ( _ua > 0, FORMAT ( _ua, "#,0" ) & " <span class='u'>UA</span>", "–" ) ) & "</td>"
			            & "<td class='n'>" & IF ( _psc > 0, FORMAT ( _psc, "#,0" ) & "<span class='u'>/sc</span>", "–" ) & "</td>"
			            & "<td class='n'>" & _tRob & "</td>"
			            & "<td class='n b'>" & _tPot & "</td></tr>",
			        "",
			        segclientes_vw_propriedades_atual[potencial], DESC
			    )
			
			VAR _ArTot = SUMX ( FILTER ( _Props, NOT segclientes_vw_propriedades_atual[sobreposta] ), segclientes_vw_propriedades_atual[area_ha] )
			VAR _RobTot = SUMX ( _Props, segclientes_vw_propriedades_atual[rob] ) + 0
			VAR _PotTot = SUMX ( _Props, segclientes_vw_propriedades_atual[potencial] ) + 0
			VAR _tRobT = IF ( _RobTot >= 1E6, FORMAT ( _RobTot / 1E6, "#,0.0" ) & " MM", IF ( _RobTot >= 1E3, FORMAT ( _RobTot / 1E3, "#,0" ) & " mil", FORMAT ( _RobTot, "#,0" ) ) )
			VAR _tPotT = IF ( _PotTot >= 1E6, FORMAT ( _PotTot / 1E6, "#,0.0" ) & " MM", IF ( _PotTot >= 1E3, FORMAT ( _PotTot / 1E3, "#,0" ) & " mil", FORMAT ( _PotTot, "#,0" ) ) )
			
			VAR _Css =
			    "<style>"
			    & "html,body{margin:0;overflow-x:hidden}"
			    & ".fp{font-family:Segoe UI,Arial,sans-serif;color:#222;padding:2px 6px;box-sizing:border-box;width:100%}"
			    & ".fp table{width:100%;border-collapse:collapse;table-layout:fixed}"
			    & ".fp th{font-size:12.5px;font-weight:700;color:#555;letter-spacing:.2px;text-align:right;padding:6px 5px 9px;border-bottom:1px solid #ddd;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;vertical-align:bottom}"
			    & ".fp th:first-child{text-align:left}"
			    & ".fp th small{display:block;font-size:11px;font-weight:600;color:#888}"
			    & ".fp td{padding:10px 5px;border-bottom:1px solid #eee;font-size:15px;vertical-align:middle}"
			    & ".fp .n{text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".fp .b{font-weight:700}"
			    & ".fp .u{font-size:12px;color:#777}"
			    & ".fp .pn{font-size:16px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".fp .ps{font-size:12.5px;color:#666;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".fp .sf{color:#c06a14;font-weight:600}"
			    & ".fp .tt td{border-top:2px solid #333;border-bottom:0;font-size:16px;font-weight:700;padding-top:12px}"
			    & ".fp .ft{font-size:12.5px;color:#777;margin-top:12px;line-height:1.4}"
			    & ".fp .vz{font-size:16px;color:#666;padding:30px 0;text-align:center}"
			    & "</style>"
			
			VAR _Cols =
			    "<colgroup><col style='width:31%'><col style='width:12%'><col style='width:15%'><col style='width:11%'><col style='width:15%'><col style='width:16%'></colgroup>"
			
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT _TemSel, "<div class='fp'>" & _Css & "<div class='vz'>Selecione uma unidade</div></div>",
			        _n = 0, "<div class='fp'>" & _Css & "<div class='vz'>Nenhuma propriedade cadastrada para esta unidade</div></div>",
			        "<div class='fp'>" & _Css
			        & "<table>" & _Cols
			        & "<thead><tr><th>PROPRIEDADE · CULTURA</th><th>ÁREA PROD.<small>ha</small></th><th>PRODUTIV.<small>&nbsp;</small></th><th>PREÇO<small>R$</small></th><th>ROB/ANO<small>R$</small></th><th>POTENCIAL<small>R$/ano</small></th></tr></thead><tbody>"
			        & _Corpo
			        & "<tr class='tt'><td>Total</td><td class='n'>" & FORMAT ( _ArTot, "#,0" ) & "</td><td></td><td></td><td class='n'>" & _tRobT & "</td><td class='n'>" & _tPotT & "</td></tr>"
			        & "</tbody></table>"
			        & "<div class='ft'>Área produtiva = lavoura + pastagem; milho 2ª safra ocupa a área da soja e não soma no total. Potencial = ROB × (1 − " & FORMAT ( _Custo, "0%" ) & " de custo operacional).</div></div>"
			    )
		displayFolder: Ficha do cliente
		lineageTag: a2a6e6e2-3017-42ba-91ca-c690a953643d

	/// Lista dos clientes do CRM que compõem a unidade (matriz/filial, cidade/UF, linha e última compra). Usar no visual HTML Content.
	measure 'Ficha Mesmo Grupo HTML' =
			VAR _TemSel = COUNTROWS ( VALUES ( segclientes_vw_clientes_atual[unidade] ) ) = 1
			VAR _Lista =
			    CONCATENATEX (
			        segclientes_vw_clientes_atual,
			        VAR _doc = segclientes_vw_clientes_atual[documento]
			        VAR _tipo = IF ( LEN ( _doc ) = 14, IF ( MID ( _doc, 9, 4 ) = "0001", "Matriz", "Filial" ), "Pessoa física" )
			        VAR _nome = SUBSTITUTE ( SUBSTITUTE ( segclientes_vw_clientes_atual[nome], "&", "&amp;" ), "<", "&lt;" )
			        VAR _loc = segclientes_vw_clientes_atual[cidade] & " / " & segclientes_vw_clientes_atual[uf]
			        VAR _lin = segclientes_vw_clientes_atual[linha_negocio]
			        VAR _ult = segclientes_vw_clientes_atual[ultima_compra]
			        RETURN
			            "<div class='it'><div class='tx'><div class='nm'>" & _nome & "</div><div class='sb'>" & _tipo & " · " & _loc & IF ( NOT ISBLANK ( _lin ), " · " & _lin ) & "</div></div>"
			            & "<div class='dt'>" & IF ( ISBLANK ( _ult ), "sem compra", FORMAT ( _ult, "dd/mm/yyyy" ) ) & "</div></div>",
			        "",
			        IF ( MID ( segclientes_vw_clientes_atual[documento], 9, 4 ) = "0001", 0, 1 ), ASC,
			        segclientes_vw_clientes_atual[nome], ASC
			    )
			VAR _Css =
			    "<style>"
			    & ".mg{font-family:Segoe UI,Arial,sans-serif;color:#222;padding:0 8px}"
			    & ".mg .it{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #eee}"
			    & ".mg .tx{min-width:0}"
			    & ".mg .nm{font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".mg .sb{font-size:12px;color:#666;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".mg .dt{flex:none;font-size:13px;color:#555}"
			    & ".mg .vz{font-size:15px;color:#666;padding:30px 0;text-align:center}"
			    & "</style>"
			RETURN
			    IF (
			        NOT _TemSel,
			        "<div class='mg'>" & _Css & "<div class='vz'>Selecione uma unidade</div></div>",
			        "<div class='mg'>" & _Css & _Lista & "</div>"
			    )
		displayFolder: Ficha do cliente
		lineageTag: 4f84cd0b-8df4-484b-bdad-63d38bafa0d1

	/// Tabela de referência IBGE/PAM por cultura e UF (produtividade, preço, ROB/ha) da execução vigente, apenas nas combinações cultura × UF usadas pelas propriedades da carteira (respeita os filtros da página). Inclui a premissa interna de pecuária. Usar no visual HTML Content.
	measure 'Premissas Referência IBGE HTML' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			VAR _Arroba = CALCULATE ( MAX ( segclientes_execucao[preco_arroba] ), REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
			VAR _Leite = CALCULATE ( MAX ( segclientes_execucao[preco_litro_leite] ), REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
			VAR _AnoPam = CALCULATE ( MAX ( segclientes_execucao[ano_preco_pam] ), REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
			
			-- combinações cultura x UF usadas pelas propriedades (respeita filtros da página)
			VAR _Uso =
			    ADDCOLUMNS (
			        SUMMARIZE ( segclientes_vw_propriedades_atual, segclientes_vw_propriedades_atual[cultura], segclientes_vw_propriedades_atual[uf] ),
			        "@n", CALCULATE ( COUNTROWS ( segclientes_vw_propriedades_atual ) )
			    )
			VAR _RelCult =
			    GROUPBY ( _Uso, segclientes_vw_propriedades_atual[cultura], "@tot", SUMX ( CURRENTGROUP (), [@n] ) )
			
			VAR _Ref =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE (
			                segclientes_referencia_ibge,
			                REMOVEFILTERS ( segclientes_referencia_ibge ),
			                segclientes_referencia_ibge[execucao_id] = _Ex,
			                segclientes_referencia_ibge[nivel] = "UF"
			            ),
			            "@uf", SWITCH ( segclientes_referencia_ibge[local],
			                "11", "RO", "12", "AC", "13", "AM", "14", "RR", "15", "PA", "16", "AP", "17", "TO",
			                "21", "MA", "22", "PI", "23", "CE", "24", "RN", "25", "PB", "26", "PE", "27", "AL", "28", "SE", "29", "BA",
			                "31", "MG", "32", "ES", "33", "RJ", "35", "SP", "41", "PR", "42", "SC", "43", "RS",
			                "50", "MS", "51", "MT", "52", "GO", "53", "DF", segclientes_referencia_ibge[local] ),
			            "@rel", VAR _c = segclientes_referencia_ibge[cultura] RETURN MAXX ( FILTER ( _RelCult, segclientes_vw_propriedades_atual[cultura] = _c ), [@tot] ) + 0
			        ),
			        VAR _c = segclientes_referencia_ibge[cultura]
			        VAR _u = [@uf]
			        RETURN NOT ISEMPTY ( FILTER ( _Uso, segclientes_vw_propriedades_atual[cultura] = _c && segclientes_vw_propriedades_atual[uf] = _u ) )
			    )
			VAR _MaxRob = MAXX ( _Ref, segclientes_referencia_ibge[rob_ha] )
			
			VAR _Corpo =
			    CONCATENATEX (
			        _Ref,
			        VAR _cult = segclientes_referencia_ibge[cultura]
			        VAR _cultTxt = UPPER ( LEFT ( _cult, 1 ) ) & LOWER ( MID ( _cult, 2, 200 ) )
			        VAR _kg = segclientes_referencia_ibge[produtividade_kg_ha]
			        VAR _pkg = segclientes_referencia_ibge[preco_kg]
			        VAR _rob = segclientes_referencia_ibge[rob_ha]
			        VAR _w = IF ( _MaxRob > 0, MAX ( INT ( _rob / _MaxRob * 100 ), 2 ), 0 )
			        RETURN
			            "<tr><td class='c'>" & _cultTxt & "</td><td class='uf'>" & [@uf] & "</td>"
			            & "<td class='n'>" & IF ( _kg > 0, FORMAT ( _kg / 60, "#,0" ) & " <span class='u'>sc/ha</span>", "–" ) & "</td>"
			            & "<td class='n'>" & IF ( _pkg > 0, "R$ " & FORMAT ( _pkg * 60, "#,0.00" ) & "<span class='u'>/sc</span>", "–" ) & "</td>"
			            & "<td class='n'><div class='rb'><span class='br'><i style='width:" & _w & "%'></i></span><b>R$ " & FORMAT ( _rob, "#,0" ) & "</b></div></td>"
			            & "<td class='f'>IBGE/PAM UF</td></tr>",
			        "",
			        [@rel], DESC,
			        segclientes_referencia_ibge[cultura], ASC,
			        [@uf], ASC
			    )
			
			-- premissa interna de pecuária (por hectare)
			VAR _RobPasto =
			    CALCULATE (
			        MAX ( segclientes_vw_propriedades_atual[rob_ha] ),
			        REMOVEFILTERS ( segclientes_vw_propriedades_atual ),
			        REMOVEFILTERS ( segclientes_vw_clientes_atual ),
			        segclientes_vw_propriedades_atual[fonte] = "Premissa pecuária (por hectare)"
			    )
			VAR _wP = IF ( _MaxRob > 0, MAX ( INT ( _RobPasto / _MaxRob * 100 ), 2 ), 0 )
			VAR _Pec =
			    IF (
			        _RobPasto > 0,
			        "<tr class='pc'><td class='c'>Pecuária extensiva/pasto</td><td class='uf'>todas</td><td class='n'>–</td>"
			        & "<td class='n'>R$ " & FORMAT ( _Arroba, "#,0.00" ) & "<span class='u'>/@</span></td>"
			        & "<td class='n'><div class='rb'><span class='br'><i style='width:" & _wP & "%;background:#b08a3e'></i></span><b>R$ " & FORMAT ( _RobPasto, "#,0" ) & "</b></div></td>"
			        & "<td class='f'>Premissa interna (por hectare)</td></tr>"
			    )
			
			VAR _Css =
			    "<style>"
			    & "html,body{margin:0;overflow-x:hidden}"
			    & ".ri{font-family:Segoe UI,Arial,sans-serif;color:#222;padding:0 6px}"
			    & ".ri table{width:100%;border-collapse:collapse;table-layout:fixed}"
			    & ".ri thead th{position:sticky;top:0;background:#fff;z-index:1;font-size:12.5px;font-weight:700;color:#555;letter-spacing:.2px;text-align:right;padding:7px 6px 9px;border-bottom:1px solid #ddd;white-space:nowrap}"
			    & ".ri th.l{text-align:left}"
			    & ".ri td{padding:6px 6px;border-bottom:1px solid #f0f0f0;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".ri .c{font-weight:600}"
			    & ".ri .uf{color:#444}"
			    & ".ri .n{text-align:right}"
			    & ".ri .u{font-size:11.5px;color:#777}"
			    & ".ri .rb{display:flex;justify-content:flex-end;align-items:center;gap:8px}"
			    & ".ri .br{width:56px;height:7px;background:#eef2ec;border-radius:3px;overflow:hidden;flex:none}"
			    & ".ri .br i{display:block;height:100%;background:#3a7d2c;border-radius:3px}"
			    & ".ri .f{font-size:12px;color:#666;padding-left:12px}"
			    & ".ri .pc td{background:#fbf7ee}"
			    & ".ri .nt{font-size:12px;color:#777;margin:10px 0 4px;line-height:1.4}"
			    & "</style>"
			VAR _Cols = "<colgroup><col style='width:24%'><col style='width:7%'><col style='width:14%'><col style='width:15%'><col style='width:19%'><col style='width:21%'></colgroup>"
			
			RETURN
			    "<div class='ri'>" & _Css
			    & "<table>" & _Cols
			    & "<thead><tr><th class='l'>CULTURA</th><th class='l'>UF</th><th>PRODUTIVIDADE</th><th>PREÇO</th><th>ROB/HA</th><th class='l' style='padding-left:12px'>FONTE</th></tr></thead><tbody>"
			    & _Corpo & _Pec
			    & "</tbody></table>"
			    & "<div class='nt'>Combinações cultura × UF presentes nas propriedades da carteira. Preços PAM de " & _AnoPam & ", saca de 60 kg. Pecuária por animal usa arroba a R$ " & FORMAT ( _Arroba, "#,0.00" ) & " e leite a R$ " & FORMAT ( _Leite, "#,0.00" ) & "/L (premissas internas).</div>"
			    & "</div>"
		displayFolder: Premissas e fontes
		lineageTag: d009fecf-0fef-4345-9c49-959263e52491

	/// Texto de metodologia e fontes com os parâmetros da execução vigente (custo operacional, janela, percentis, nível de referência, PAM, premissas de pecuária). Usar no visual HTML Content.
	measure 'Premissas Metodologia HTML' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			VAR _E = CALCULATETABLE ( segclientes_execucao, REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
			VAR _Custo = MAXX ( _E, segclientes_execucao[custo_operacional_padrao] )
			VAR _Janela = MAXX ( _E, segclientes_execucao[janela_meses] )
			VAR _Pf = MAXX ( _E, segclientes_execucao[percentil_faturamento] )
			VAR _Pp = MAXX ( _E, segclientes_execucao[percentil_potencial] )
			VAR _Nivel = MAXX ( _E, segclientes_execucao[nivel_referencia] )
			VAR _AnosProd = MAXX ( _E, segclientes_execucao[anos_produtividade] )
			VAR _AnoPam = MAXX ( _E, segclientes_execucao[ano_preco_pam] )
			VAR _Arroba = MAXX ( _E, segclientes_execucao[preco_arroba] )
			VAR _Leite = MAXX ( _E, segclientes_execucao[preco_litro_leite] )
			VAR _Consol = MAXX ( _E, IF ( segclientes_execucao[consolida_grupo], 1, 0 ) ) = 1
			VAR _IniFat = MAXX ( _E, segclientes_execucao[data_inicio_faturamento] )
			VAR _Ref = MAXX ( _E, segclientes_execucao[data_referencia] )
			VAR _Comp = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MAXX ( _E, segclientes_execucao[componentes_faturamento] ), "maquinas", "máquinas" ), "pecas", "peças" ), "servicos", "serviços" )
			VAR _CompTxt = SUBSTITUTE ( _Comp, ",", ", " )
			VAR _Fora = MAXX ( _E, segclientes_execucao[faturamento_fora_crm] )
			VAR _DocsFora = MAXX ( _E, segclientes_execucao[documentos_fora_crm] )
			VAR _PctMaq = FORMAT ( [% ROB Investimento Máquinas], "0%" )
			VAR _P = "<p><b>{t}.</b> {x}</p>"
			VAR _Itens =
			    SUBSTITUTE ( SUBSTITUTE ( _P, "{t}", "Potencial de investimento" ), "{x}", "Receita bruta anual (ROB) das propriedades do cliente — área × produtividade × preço — multiplicada por (1 − custo operacional de " & FORMAT ( _Custo, "0%" ) & "), ou seja, equivalente a " & FORMAT ( 1 - _Custo, "0%" ) & " do ROB. Milho de 2ª safra divide a área da soja." )
			    & SUBSTITUTE ( SUBSTITUTE ( _P, "{t}", "Potencial de investimento em máquinas" ), "{x}", _PctMaq & " do ROB do cliente. É o valor em destaque no cartão Potencial de Investimento e a base da Participação e do Alvo de participação." )
			    & SUBSTITUTE ( SUBSTITUTE ( _P, "{t}", "Referência agrícola" ), "{x}", "Produtividade média dos últimos " & _AnosProd & " anos e preço de " & _AnoPam & " da PAM/IBGE, no nível " & _Nivel & ". Sem dado suficiente no nível, usa o nível acima (Brasil)." )
			    & SUBSTITUTE ( SUBSTITUTE ( _P, "{t}", "Pecuária" ), "{x}", "Premissas internas: arroba a R$ " & FORMAT ( _Arroba, "#,0.00" ) & " e leite a R$ " & FORMAT ( _Leite, "#,0.00" ) & "/L, por animal quando há rebanho informado ou por hectare de pastagem." )
			    & SUBSTITUTE ( SUBSTITUTE ( _P, "{t}", "Faturamento" ), "{x}", "Média anual de compras na Nissey (" & _CompTxt & ") nos últimos " & _Janela & " meses (" & FORMAT ( _IniFat, "dd/mm/yyyy" ) & " a " & FORMAT ( _Ref, "dd/mm/yyyy" ) & "). Mantemos " & FORMAT ( _Janela / 12, "0" ) & " anos de faturamento porque essa janela respeita a sazonalidade de compras que ocorre em nossa região." )
			    & SUBSTITUTE ( SUBSTITUTE ( _P, "{t}", "Participação" ), "{x}", "Faturamento Nissey ÷ potencial de investimento em máquinas da unidade (" & _PctMaq & " do ROB). O alvo de participação é escolhido no slicer (hoje " & FORMAT ( [% Alvo Participação], "0%" ) & "). Os segmentos KAM/SAM, Cliente Estratégico, Varejo Foco e Varejo seguem o percentil " & FORMAT ( _Pf * 100, "0" ) & " do faturamento e o percentil " & FORMAT ( _Pp * 100, "0" ) & " do potencial de investimento total." )
			    & SUBSTITUTE ( SUBSTITUTE ( _P, "{t}", "Unidade de análise" ), "{x}", IF ( _Consol, "Grupo econômico ou CNPJ com todas as filiais", "CNPJ com todas as filiais (grupo econômico não consolidado)" ) & ". Totais vêm sempre da visão por unidade, porque as filiais repetem o valor." )
			    & IF ( _Fora > 0, SUBSTITUTE ( SUBSTITUTE ( _P, "{t}", "Fora do CRM" ), "{x}", "R$ " & IF ( _Fora >= 1E6, FORMAT ( _Fora / 1E6, "#,0.0" ) & " MM", FORMAT ( _Fora / 1E3, "#,0" ) & " mil" ) & "/ano de faturamento de " & FORMAT ( _DocsFora, "#,0" ) & " documentos sem cadastro no CRM — não entram na matriz." ) )
			VAR _Css =
			    "<style>"
			    & "html,body{margin:0}"
			    & ".mt{font-family:Segoe UI,Arial,sans-serif;color:#222;padding:2px 8px;font-size:14.5px;line-height:1.5}"
			    & ".mt p{margin:0 0 12px}"
			    & ".mt hr{border:0;border-top:1px solid #e3e3e3;margin:14px 0 10px}"
			    & ".mt .fh{font-size:12.5px;font-weight:700;color:#555;letter-spacing:.3px;margin-bottom:8px}"
			    & ".mt .ch{display:inline-block;background:#e8f1e4;color:#2f5d23;font-size:13px;padding:4px 10px;border-radius:4px;margin:0 6px 6px 0}"
			    & "</style>"
			RETURN
			    "<div class='mt'>" & _Css & _Itens
			    & "<hr><div class='fh'>FONTES</div>"
			    & "<span class='ch'>CRM · cadastro e propriedades</span><span class='ch'>ERP Totvs · faturamento</span><span class='ch'>IBGE/PAM · tabela 5457</span><span class='ch'>Premissas internas de pecuária</span>"
			    & "</div>"
		displayFolder: Premissas e fontes
		lineageTag: 1383988e-790e-46f6-ad27-631a97e57f44

	/// Custo operacional padrão da execução vigente (potencial = ROB × (1 − custo)).
	measure 'Custo Operacional' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			RETURN
			    CALCULATE ( MAX ( segclientes_execucao[custo_operacional_padrao] ), REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
		formatString: 0%
		displayFolder: Premissas e fontes\Cards
		lineageTag: 1c2f2ceb-6dc4-4e6c-b22e-d547cba267e4

	/// Subtítulo do card Custo operacional.
	measure 'Rótulo Custo Operacional' = "Potencial = ROB × " & FORMAT ( 1 - [Custo Operacional], "0%" )
		displayFolder: Premissas e fontes\Cards
		lineageTag: d138be69-711a-440e-b319-9d58274edd67

	/// Preço da arroba (premissa de pecuária de corte) da execução vigente.
	measure 'Preço Arroba' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			RETURN
			    CALCULATE ( MAX ( segclientes_execucao[preco_arroba] ), REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
		formatString: \R$ #,0.00
		displayFolder: Premissas e fontes\Cards
		lineageTag: 537c4b68-c962-4a78-8484-f3d703359f70

	/// Subtítulo do card Preço da arroba (inclui o preço do leite).
	measure 'Rótulo Preço Arroba' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			VAR _Leite = CALCULATE ( MAX ( segclientes_execucao[preco_litro_leite] ), REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
			RETURN
			    "Pecuária de corte · leite R$ " & FORMAT ( _Leite, "#,0.00" ) & "/L"
		displayFolder: Premissas e fontes\Cards
		lineageTag: 3e242ff0-a822-49b7-9044-caa5f9daa03d

	/// Ano dos preços da PAM/IBGE usados na execução vigente.
	measure 'Ano PAM' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			RETURN
			    CALCULATE ( MAX ( segclientes_execucao[ano_preco_pam] ), REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
		formatString: 0
		displayFolder: Premissas e fontes\Cards
		lineageTag: e0badc93-3099-4738-b721-01adef173c86

	/// Subtítulo do card Ano da PAM (nível e anos de produtividade).
	measure 'Rótulo Ano PAM' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			VAR _E = CALCULATETABLE ( segclientes_execucao, REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
			RETURN
			    "IBGE · nível " & MAXX ( _E, segclientes_execucao[nivel_referencia] ) & " · produtiv. média de " & MAXX ( _E, segclientes_execucao[anos_produtividade] ) & " anos"
		displayFolder: Premissas e fontes\Cards
		lineageTag: b8f6886f-74ca-470d-99e5-b049662459ec

	/// Unidades com potencial usadas no cálculo das linhas de corte (amostra da execução vigente).
	measure 'Amostra Rodada' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			RETURN
			    CALCULATE ( MAX ( segclientes_execucao[unidades_na_amostra] ), REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
		formatString: #,0 \u\n\i\d\.
		displayFolder: Premissas e fontes\Cards
		lineageTag: 0ac636db-7a13-45ed-9445-43669f11b0c7

	/// Subtítulo do card Amostra da rodada.
	measure 'Rótulo Amostra Rodada' =
			VAR _Ex = CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			VAR _E = CALCULATETABLE ( segclientes_execucao, REMOVEFILTERS ( segclientes_execucao ), segclientes_execucao[execucao_id] = _Ex )
			RETURN
			    FORMAT ( MAXX ( _E, segclientes_execucao[clientes] ), "#,0" ) & " clientes · rodada de " & FORMAT ( MAXX ( _E, segclientes_execucao[data_referencia] ), "dd/mm/yyyy" )
		displayFolder: Premissas e fontes\Cards
		lineageTag: 85a09943-bee8-4c7a-a16a-8a94c3a6b976

	/// Preço médio da saca de soja (60 kg) aplicado nas propriedades da carteira, ponderado pela área. Responde aos filtros da página.
	measure 'Preço Soja' =
			VAR _P = FILTER ( segclientes_vw_propriedades_atual, segclientes_vw_propriedades_atual[cultura] = "SOJA" && segclientes_vw_propriedades_atual[preco_saca] > 0 && segclientes_vw_propriedades_atual[area_ha] > 0 )
			RETURN
			    DIVIDE ( SUMX ( _P, segclientes_vw_propriedades_atual[preco_saca] * segclientes_vw_propriedades_atual[area_ha] ), SUMX ( _P, segclientes_vw_propriedades_atual[area_ha] ) )
		formatString: \R$ #,0.00
		displayFolder: Premissas e fontes\Cards
		lineageTag: 99acbc96-70f1-4e94-b708-f8a16b9859b6

	/// Subtítulo do card Preço da soja (faixa entre UFs da carteira).
	measure 'Rótulo Preço Soja' =
			VAR _P = FILTER ( segclientes_vw_propriedades_atual, segclientes_vw_propriedades_atual[cultura] = "SOJA" && segclientes_vw_propriedades_atual[preco_saca] > 0 )
			VAR _Min = MINX ( _P, segclientes_vw_propriedades_atual[preco_saca] )
			VAR _Max = MAXX ( _P, segclientes_vw_propriedades_atual[preco_saca] )
			RETURN
			    IF ( ISBLANK ( _Min ), "sem soja na seleção", "saca 60 kg · média por área · UFs de R$ " & FORMAT ( _Min, "#,0" ) & " a " & FORMAT ( _Max, "#,0" ) )
		displayFolder: Premissas e fontes\Cards
		lineageTag: 49869763-1f97-4a3e-8131-29149d6b1dd4

	/// Preço médio da saca de milho (60 kg) aplicado nas propriedades da carteira, ponderado pela área (inclui 2ª safra). Responde aos filtros da página.
	measure 'Preço Milho' =
			VAR _P = FILTER ( segclientes_vw_propriedades_atual, segclientes_vw_propriedades_atual[cultura] = "MILHO" && segclientes_vw_propriedades_atual[preco_saca] > 0 && segclientes_vw_propriedades_atual[area_ha] > 0 )
			RETURN
			    DIVIDE ( SUMX ( _P, segclientes_vw_propriedades_atual[preco_saca] * segclientes_vw_propriedades_atual[area_ha] ), SUMX ( _P, segclientes_vw_propriedades_atual[area_ha] ) )
		formatString: \R$ #,0.00
		displayFolder: Premissas e fontes\Cards
		lineageTag: 53969019-3949-4854-bca4-f87621ea7c1e

	/// Subtítulo do card Preço do milho (faixa entre UFs da carteira).
	measure 'Rótulo Preço Milho' =
			VAR _P = FILTER ( segclientes_vw_propriedades_atual, segclientes_vw_propriedades_atual[cultura] = "MILHO" && segclientes_vw_propriedades_atual[preco_saca] > 0 )
			VAR _Min = MINX ( _P, segclientes_vw_propriedades_atual[preco_saca] )
			VAR _Max = MAXX ( _P, segclientes_vw_propriedades_atual[preco_saca] )
			RETURN
			    IF ( ISBLANK ( _Min ), "sem milho na seleção", "saca 60 kg · média por área · UFs de R$ " & FORMAT ( _Min, "#,0" ) & " a " & FORMAT ( _Max, "#,0" ) )
		displayFolder: Premissas e fontes\Cards
