	measure 'C360 Sub Contato' =
			VAR _u = [C360 Última Visita]
			VAR _p = CALCULATE ( MIN ( c360_agenda[data_hora] ), c360_agenda[status] = "Agendada" )
			RETURN IF ( ISBLANK ( _u ), "sem visita concluída", "Última " & FORMAT ( _u, "dd/mm/yy" ) ) & IF ( NOT ISBLANK ( _p ), " · próx. " & FORMAT ( _p, "dd/mm" ) )
		displayFolder: Cliente 360\1. Cartões
		lineageTag: 4842f128-5d5f-428b-b86c-72825370cb2e

	/// Parque de máquinas do cliente com status JDLink, CSC, horas, garantia, alertas e tickets. Usar no visual HTML Content.
	measure 'C360 Parque HTML' =
			VAR _Css = [C360 CSS]
			VAR _n = COUNTROWS ( c360_maquinas )
			VAR _Lim = 60
			VAR _JD = CALCULATE ( COUNTROWS ( c360_maquinas ), c360_maquinas[marca] = "JD" )
			VAR _Con = SUM ( c360_maquinas[conectada] )
			VAR _Csc = SUM ( c360_maquinas[csc] )
			VAR _Fora = CALCULATE ( COUNTROWS ( c360_maquinas ), c360_maquinas[situacao_vida] <> "Ativa" )
			VAR _Idade = AVERAGE ( c360_maquinas[idade_anos] )
			VAR _Hd =
			    "<div class='hd'><span><b>" & FORMAT ( _n, "#,0" ) & "</b> máquinas</span>"
			    & "<span><b>" & FORMAT ( COALESCE ( _JD, 0 ), "#,0" ) & "</b> John Deere</span>"
			    & "<span><b>" & FORMAT ( COALESCE ( _Con, 0 ), "#,0" ) & "</b> comunicando</span>"
			    & "<span><b>" & FORMAT ( COALESCE ( _Csc, 0 ), "#,0" ) & "</b> no CSC</span>"
			    & "<span><b>" & FORMAT ( COALESCE ( _Fora, 0 ), "#,0" ) & "</b> fora da vida útil</span>"
			    & "<span>idade média <b>" & FORMAT ( _Idade, "0.0" ) & "</b> anos</span></div>"
			VAR _Top = TOPN ( _Lim, c360_maquinas, c360_maquinas[ano_modelo], DESC, c360_maquinas[chassi], ASC )
			VAR _Rows =
			    CONCATENATEX (
			        _Top,
			        VAR _st = c360_maquinas[status_conexao]
			        VAR _jd = c360_maquinas[marca] = "JD"
			        VAR _lbl = SWITCH ( TRUE (), _st = "COMUNICANDO", "Comunicando", _st = "ATENÇÃO", "Atenção", _st = "EM RISCO", "Em risco", _st = "SEM COMUNICAÇÃO", "Sem comunicação", _st = "NUNCA COMUNICADO", "Nunca comunicou", _jd, "Sem JDLink", "–" )
			        VAR _cor = SWITCH ( _lbl, "Comunicando", "#2E9E44", "Atenção", "#E2A72A", "Em risco", "#E2862A", "Sem comunicação", "#D64545", "Nunca comunicou", "#9A9A9A", "#D0D0D0" )
			        VAR _g = c360_maquinas[garantia_ate]
			        VAR _gar = IF ( ISBLANK ( _g ), "–", IF ( _g >= TODAY (), "<span class='b' style='color:#2E9E44'>até " & FORMAT ( _g, "dd/mm/yy" ) & "</span>", "<span style='color:#999'>venceu " & FORMAT ( _g, "mm/yy" ) & "</span>" ) )
			        VAR _al = c360_maquinas[alertas_30d]
			        VAR _alc = c360_maquinas[alertas_criticos_30d]
			        VAR _tk = c360_maquinas[tickets_12m]
			        VAR _ch = c360_maquinas[chassi]
			        VAR _h = c360_maquinas[horas]
			        RETURN
			            "<tr><td><div class='b'>" & c360_maquinas[modelo] & "</div><div class='s'>" & COALESCE ( c360_maquinas[produto], "–" ) & " · " & c360_maquinas[marca] & "</div></td>"
			            & "<td class='nw'>" & IF ( _ch = "", "–", _ch ) & "</td>"
			            & "<td class='r'>" & c360_maquinas[ano_modelo] & "<div class='s'>" & c360_maquinas[idade_anos] & IF ( c360_maquinas[situacao_vida] <> "Ativa", " anos · <span style='color:#D64545'>fora da vida útil</span>", " anos" ) & "</div></td>"
			            & "<td class='nw'><span class='d' style='background:" & _cor & "'></span>" & _lbl & IF ( c360_maquinas[csc] = 1, " <span class='pl' style='background:#2E6A251f;color:#2E6A25'>CSC</span>" ) & "</td>"
			            & "<td class='r'>" & IF ( ISBLANK ( _h ), "–", FORMAT ( _h, "#,0" ) & " h" ) & "</td>"
			            & "<td class='nw'>" & _gar & "</td>"
			            & "<td class='r'>" & IF ( _al = 0, "–", IF ( _alc > 0, "<span class='b' style='color:#D64545'>" & _al & "</span>", _al & "" ) ) & "</td>"
			            & "<td class='r'>" & IF ( _tk = 0, "–", _tk & "" ) & "</td></tr>",
			        "",
			        c360_maquinas[ano_modelo], DESC, c360_maquinas[modelo], ASC
			    )
			RETURN
			    IF (
			        NOT [C360 Tem Seleção],
			        "<div class='c3'>" & _Css & "<div class='vz'>Selecione um cliente ou grupo econômico.</div></div>",
			        IF (
			            COALESCE ( _n, 0 ) = 0,
			            "<div class='c3'>" & _Css & "<div class='vz'>Nenhuma máquina no parque do ERP para este cliente.</div></div>",
			            "<div class='c3'>" & _Css & _Hd
			            & "<table><tr><th>Modelo</th><th>Chassi</th><th class='r'>Ano</th><th>JDLink</th><th class='r'>Horas motor</th><th>Garantia</th><th class='r'>Alertas 30d</th><th class='r'>Tickets 12m</th></tr>" & _Rows & "</table>"
			            & IF ( _n > _Lim, "<div class='mt'>Mostrando as " & _Lim & " máquinas mais novas de " & FORMAT ( _n, "#,0" ) & ".</div>" )
			            & "</div>"
			        )
			    )
		displayFolder: Cliente 360\2. Quadros HTML
		lineageTag: 09587674-f04a-46ed-9bd4-b90f75b5f9ed

	/// Contatos do cliente cadastrados no CRM (nome, cargo, telefone/WhatsApp e e-mail). Usar no visual HTML Content.
	measure 'C360 Contatos HTML' =
			VAR _Css = [C360 CSS]
			VAR _n = COUNTROWS ( c360_contatos )
			VAR _Multi = COUNTROWS ( segclientes_vw_clientes_atual ) > 1
			VAR _Wa = CALCULATE ( COUNTROWS ( c360_contatos ), c360_contatos[whatsapp] = "Sim" )
			VAR _Em = CALCULATE ( COUNTROWS ( c360_contatos ), NOT ISBLANK ( c360_contatos[email] ) )
			VAR _Lista =
			    CONCATENATEX (
			        c360_contatos,
			        VAR _nm = SUBSTITUTE ( SUBSTITUTE ( c360_contatos[nome], "&", "&amp;" ), "<", "&lt;" )
			        VAR _tel = c360_contatos[telefone]
			        VAR _em = c360_contatos[email]
			        VAR _cg = c360_contatos[cargo]
			        VAR _cli = SUBSTITUTE ( RELATED ( segclientes_vw_clientes_atual[nome] ), "&", "&amp;" )
			        RETURN
			            "<div class='ct'><div class='n'>" & _nm & IF ( NOT ISBLANK ( _cg ), " <span class='s'>· " & _cg & "</span>" ) & "</div>"
			            & "<div class='i'>" & IF ( ISBLANK ( _tel ), "<span class='s'>sem telefone</span>", "&#128222; " & _tel & IF ( c360_contatos[whatsapp] = "Sim", " <span class='pl' style='background:#25D3661f;color:#128C4B'>WhatsApp</span>" ) )
			            & IF ( NOT ISBLANK ( _em ), " &nbsp;·&nbsp; &#9993; " & _em ) & "</div>"
			            & IF ( _Multi, "<div class='s'>" & _cli & "</div>" )
			            & "</div>",
			        "",
			        c360_contatos[nome], ASC
			    )
			RETURN
			    IF (
			        NOT [C360 Tem Seleção],
			        "<div class='c3'>" & _Css & "<div class='vz'>Selecione um cliente ou grupo econômico.</div></div>",
			        IF (
			            COALESCE ( _n, 0 ) = 0,
			            "<div class='c3'>" & _Css & "<div class='vz'>Nenhum contato cadastrado no CRM.<br><span class='s'>Cadastre em Clientes › Contatos no CRM.</span></div></div>",
			            "<div class='c3'>" & _Css
			            & "<div class='hd'><span><b>" & _n & "</b> contatos</span><span><b>" & COALESCE ( _Wa, 0 ) & "</b> com WhatsApp</span><span><b>" & COALESCE ( _Em, 0 ) & "</b> com e-mail</span></div>"
			            & _Lista & "</div>"
			        )
			    )
		displayFolder: Cliente 360\2. Quadros HTML
		lineageTag: 8b90e1c2-b4ba-4c15-ae85-0dbef00d7b7d

	/// Negociações do CRM: em aberto (fase, valor, previsão, temperatura) e histórico de 24 meses (ganhas/perdidas/canceladas com concorrente e motivo). Usar no visual HTML Content.
	measure 'C360 Negócios HTML' =
			VAR _Css = [C360 CSS]
			VAR _Ini = EDATE ( TODAY (), -24 )
			VAR _Ab = FILTER ( c360_oportunidades, c360_oportunidades[resultado] = "Aberta" )
			VAR _Hist = FILTER ( c360_oportunidades, c360_oportunidades[resultado] <> "Aberta" && c360_oportunidades[data_ref] >= _Ini )
			VAR _nAb = COUNTROWS ( _Ab )
			VAR _vAb = SUMX ( _Ab, c360_oportunidades[preco_total] )
			VAR _nG = COUNTROWS ( FILTER ( _Hist, c360_oportunidades[resultado] = "Ganha" ) )
			VAR _vG = SUMX ( FILTER ( _Hist, c360_oportunidades[resultado] = "Ganha" ), c360_oportunidades[preco_total] )
			VAR _nP = COUNTROWS ( FILTER ( _Hist, c360_oportunidades[resultado] = "Perdida" ) )
			VAR _nC = COUNTROWS ( FILTER ( _Hist, c360_oportunidades[resultado] = "Cancelada" ) )
			VAR _Conv = DIVIDE ( _nG, _nG + _nP )
			VAR _Hd =
			    "<div class='hd'><span><b>" & COALESCE ( _nAb, 0 ) & "</b> em aberto · <b>R$ " & FORMAT ( COALESCE ( _vAb, 0 ), "#,0" ) & "</b></span>"
			    & "<span>24 meses: <b style='color:#2E9E44'>" & COALESCE ( _nG, 0 ) & "</b> ganhas (R$ " & FORMAT ( COALESCE ( _vG, 0 ), "#,0" ) & ") · <b style='color:#D64545'>" & COALESCE ( _nP, 0 ) & "</b> perdidas · " & COALESCE ( _nC, 0 ) & " canceladas</span>"
			    & IF ( NOT ISBLANK ( _Conv ), "<span>conversão <b>" & FORMAT ( _Conv, "0%" ) & "</b></span>" )
			    & "</div>"
			VAR _RowsAb =
			    CONCATENATEX (
			        TOPN ( 15, _Ab, c360_oportunidades[data_estimada], ASC, c360_oportunidades[id], ASC ),
			        VAR _f = c360_oportunidades[fase]
			        VAR _fase = IF ( MID ( _f, 2, 1 ) = ".", MID ( _f, 3, 60 ), _f )
			        VAR _t = c360_oportunidades[temperatura]
			        VAR _tc = SWITCH ( _t, "QUENTE", "#D64545", "MORNO", "#E2A72A", "FRIO", "#3E6FB0", "#898781" )
			        VAR _de = c360_oportunidades[data_estimada]
			        RETURN
			            "<tr><td class='nw'>" & _fase & "</td>"
			            & "<td><div class='b'>" & c360_oportunidades[produto] & "</div><div class='s'>" & COALESCE ( c360_oportunidades[modelo], "–" ) & " · " & c360_oportunidades[tipo_negocio] & "</div></td>"
			            & "<td class='r'>" & c360_oportunidades[quantidade] & "</td>"
			            & "<td class='r'>R$ " & FORMAT ( c360_oportunidades[preco_total], "#,0" ) & "</td>"
			            & "<td class='nw'>" & IF ( ISBLANK ( _de ), "–", IF ( _de < TODAY (), "<span style='color:#D64545'>" & FORMAT ( _de, "dd/mm/yy" ) & "</span>", FORMAT ( _de, "dd/mm/yy" ) ) ) & "</td>"
			            & "<td><span class='pl' style='background:" & _tc & "1f;color:" & _tc & "'>" & _t & "</span></td>"
			            & "<td>" & c360_oportunidades[vendedor] & "</td></tr>",
			        "",
			        c360_oportunidades[data_estimada], ASC
			    )
			VAR _RowsH =
			    CONCATENATEX (
			        TOPN ( 15, _Hist, c360_oportunidades[data_ref], DESC, c360_oportunidades[id], DESC ),
			        VAR _r = c360_oportunidades[resultado]
			        VAR _rc = SWITCH ( _r, "Ganha", "#2E9E44", "Perdida", "#D64545", "#898781" )
			        VAR _cc = c360_oportunidades[concorrente]
			        VAR _mp = c360_oportunidades[motivo_perda]
			        VAR _det = IF ( _r = "Perdida", COALESCE ( _cc, "concorrente não informado" ) & IF ( NOT ISBLANK ( c360_oportunidades[modelo_concorrente] ), " " & c360_oportunidades[modelo_concorrente] ) & IF ( NOT ISBLANK ( _mp ), "<div class='s'>" & _mp & "</div>" ), "–" )
			        RETURN
			            "<tr><td class='nw'>" & FORMAT ( c360_oportunidades[data_ref], "dd/mm/yy" ) & "</td>"
			            & "<td><span class='pl' style='background:" & _rc & "1f;color:" & _rc & "'>" & _r & "</span></td>"
			            & "<td><div class='b'>" & c360_oportunidades[produto] & "</div><div class='s'>" & COALESCE ( c360_oportunidades[modelo], "–" ) & "</div></td>"
			            & "<td class='r'>R$ " & FORMAT ( c360_oportunidades[preco_total], "#,0" ) & "</td>"
			            & "<td>" & _det & "</td>"
			            & "<td>" & c360_oportunidades[vendedor] & "</td></tr>",
			        "",
			        c360_oportunidades[data_ref], DESC
			    )
			RETURN
			    IF (
			        NOT [C360 Tem Seleção],
			        "<div class='c3'>" & _Css & "<div class='vz'>Selecione um cliente ou grupo econômico.</div></div>",
			        "<div class='c3'>" & _Css & _Hd
			        & "<div class='sec f'>Em aberto</div>"
			        & IF ( COALESCE ( _nAb, 0 ) = 0, "<div class='mt'>Nenhuma negociação em aberto.</div>",
			            "<table><tr><th>Fase</th><th>Produto / modelo</th><th class='r'>Qtd</th><th class='r'>Valor</th><th>Previsão</th><th>Temp.</th><th>Vendedor</th></tr>" & _RowsAb & "</table>" )
			        & "<div class='sec'>Histórico · 24 meses</div>"
			        & IF ( COUNTROWS ( _Hist ) = 0, "<div class='mt'>Sem negociações encerradas nos últimos 24 meses.</div>",
			            "<table><tr><th>Data</th><th>Resultado</th><th>Produto / modelo</th><th class='r'>Valor</th><th>Concorrente / motivo</th><th>Vendedor</th></tr>" & _RowsH & "</table>" )
			        & "</div>"
			    )
		displayFolder: Cliente 360\2. Quadros HTML
		lineageTag: 1ea3997a-cbe0-46e0-a39c-6c865e94bd59

	/// Agenda do CRM: próximos compromissos, histórico de interações e dias desde a última visita vs. a regra de atendimento da segmentação. Usar no visual HTML Content.
	measure 'C360 Relacionamento HTML' =
			VAR _Css = [C360 CSS]
			VAR _Agora = NOW ()
			VAR _Prox = FILTER ( c360_agenda, c360_agenda[status] = "Agendada" )
			VAR _Hist = FILTER ( c360_agenda, c360_agenda[data_hora] <= _Agora && c360_agenda[status] <> "Cancelada" )
			VAR _Ult = [C360 Última Visita]
			VAR _Dias = [C360 Dias sem Contato]
			VAR _n12 = COUNTROWS ( FILTER ( c360_agenda, c360_agenda[status] = "Concluída" && c360_agenda[data_hora] >= EDATE ( TODAY (), -12 ) ) )
			VAR _Freq = MAX ( segclientes_vw_clientes_atual[frequencia_contato] )
			VAR _Hd =
			    "<div class='hd'><span>última interação: <b>" & IF ( ISBLANK ( _Ult ), "nunca", "há " & _Dias & " dias" ) & "</b></span>"
			    & "<span><b>" & COALESCE ( _n12, 0 ) & "</b> concluídas em 12 meses</span>"
			    & IF ( NOT ISBLANK ( _Freq ), "<span>regra: contato a cada <b>" & _Freq & "</b></span>" )
			    & "</div>"
			VAR _Linha = "<tr><td class='nw'>{d}</td><td><div class='b'>{t}</div><div class='s'>{o}</div></td><td>{r}</td><td>{s}</td></tr>"
			VAR _RowsP =
			    CONCATENATEX (
			        TOPN ( 5, _Prox, c360_agenda[data_hora], ASC, c360_agenda[id], ASC ),
			        SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Linha, "{d}", FORMAT ( c360_agenda[data_hora], "dd/mm/yy hh:nn" ) ), "{t}", SUBSTITUTE ( c360_agenda[titulo], "<", "&lt;" ) ), "{o}", c360_agenda[tipo] & IF ( NOT ISBLANK ( c360_agenda[modalidade] ), " · " & c360_agenda[modalidade] ) ), "{r}", c360_agenda[responsavel] ),
			        "",
			        c360_agenda[data_hora], ASC
			    )
			VAR _RowsH =
			    CONCATENATEX (
			        TOPN ( 10, _Hist, c360_agenda[data_hora], DESC, c360_agenda[id], DESC ),
			        VAR _s = c360_agenda[status]
			        VAR _c = IF ( _s = "Concluída", "#2E9E44", "#E2862A" )
			        VAR _ob = c360_agenda[observacao]
			        RETURN
			            SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Linha, "{d}", FORMAT ( c360_agenda[data_hora], "dd/mm/yy" ) ), "{t}", SUBSTITUTE ( c360_agenda[titulo], "<", "&lt;" ) ), "{o}", IF ( ISBLANK ( _ob ), c360_agenda[tipo], SUBSTITUTE ( LEFT ( _ob, 140 ), "<", "&lt;" ) ) ), "{r}", c360_agenda[responsavel] ),
			                "{s}", "<span class='pl' style='background:" & _c & "1f;color:" & _c & "'>" & _s & "</span>" ),
			        "",
			        c360_agenda[data_hora], DESC
			    )
			RETURN
			    IF (
			        NOT [C360 Tem Seleção],
			        "<div class='c3'>" & _Css & "<div class='vz'>Selecione um cliente ou grupo econômico.</div></div>",
			        "<div class='c3'>" & _Css & _Hd
			        & "<div class='sec f'>Próximos compromissos</div>"
			        & IF ( COUNTROWS ( _Prox ) = 0, "<div class='mt'>Nenhum compromisso agendado.</div>", "<table>" & SUBSTITUTE ( _RowsP, "{s}", "" ) & "</table>" )
			        & "<div class='sec'>Histórico de interações</div>"
			        & IF ( COUNTROWS ( _Hist ) = 0, "<div class='mt'>Nenhuma interação registrada no CRM.</div>", "<table>" & _RowsH & "</table>" )
			        & "</div>"
			    )
		displayFolder: Cliente 360\2. Quadros HTML
		lineageTag: 22097f07-3b1e-4fcd-8a98-73f316553462

	/// Pós-venda: OS da oficina (ERP), balcão de peças, tickets ExpertConnect, alertas críticos das máquinas e pesquisa de satisfação. Usar no visual HTML Content.
	measure 'C360 Pós-venda HTML' =
			VAR _Css = [C360 CSS]
			VAR _OS = FILTER ( c360_os, c360_os[status] <> "Cancelada" )
			VAR _OS12 = SUM ( c360_erp[os_12m] )
			VAR _OSab = SUM ( c360_erp[os_abertas] )
			VAR _Bal = SUM ( c360_erp[balcao_valor_12m] )
			VAR _BalUlt = MAX ( c360_erp[ultima_compra_balcao] )
			VAR _Tk = c360_tickets
			VAR _TkAb = COUNTROWS ( FILTER ( _Tk, c360_tickets[status] = "Aberto" ) )
			VAR _Tk12 = COUNTROWS ( FILTER ( _Tk, c360_tickets[data_abertura] >= EDATE ( TODAY (), -12 ) ) )
			VAR _Al = FILTER ( c360_alertas, c360_alertas[severidade] = "HIGH" && c360_alertas[data_hora] >= TODAY () - 30 )
			VAR _Nota = AVERAGE ( c360_cx[nota] )
			VAR _Hd =
			    "<div class='hd'><span><b>" & COALESCE ( _OS12, 0 ) & "</b> OS em 12m · <b>" & COALESCE ( _OSab, 0 ) & "</b> abertas</span>"
			    & "<span>balcão 12m <b>R$ " & FORMAT ( COALESCE ( _Bal, 0 ), "#,0" ) & "</b>" & IF ( NOT ISBLANK ( _BalUlt ), " (últ. " & FORMAT ( _BalUlt, "dd/mm/yy" ) & ")" ) & "</span>"
			    & "<span><b>" & COALESCE ( _Tk12, 0 ) & "</b> tickets EC em 12m · <b>" & COALESCE ( _TkAb, 0 ) & "</b> abertos</span>"
			    & "<span><b" & IF ( COUNTROWS ( _Al ) > 0, " style='color:#D64545'" ) & ">" & COALESCE ( COUNTROWS ( _Al ), 0 ) & "</b> alertas críticos 30d</span>"
			    & IF ( NOT ISBLANK ( _Nota ), "<span>nota CX média <b>" & FORMAT ( _Nota, "0.0" ) & "</b></span>" )
			    & "</div>"
			VAR _RowsOS =
			    CONCATENATEX (
			        TOPN ( 8, _OS, c360_os[data_abertura], DESC, c360_os[numero_os], DESC ),
			        VAR _s = c360_os[status]
			        VAR _c = SWITCH ( _s, "Aberta", "#E2862A", "Liberada", "#3E6FB0", "#2E9E44" )
			        RETURN
			            "<tr><td class='nw'>" & FORMAT ( c360_os[data_abertura], "dd/mm/yy" ) & "</td>"
			            & "<td class='nw'>" & c360_os[numero_os] & "<div class='s'>filial " & c360_os[filial] & "</div></td>"
			            & "<td><div class='b'>" & COALESCE ( c360_os[modelo], "–" ) & "</div><div class='s'>" & c360_os[chassi] & "</div></td>"
			            & "<td><span class='pl' style='background:" & _c & "1f;color:" & _c & "'>" & _s & "</span>" & IF ( NOT ISBLANK ( c360_os[data_saida] ), "<div class='s'>saída " & FORMAT ( c360_os[data_saida], "dd/mm/yy" ) & "</div>" ) & "</td></tr>",
			        "",
			        c360_os[data_abertura], DESC
			    )
			VAR _RowsTk =
			    CONCATENATEX (
			        TOPN ( 8, _Tk, c360_tickets[data_abertura], DESC, c360_tickets[numero], DESC ),
			        VAR _s = c360_tickets[status]
			        VAR _c = IF ( _s = "Aberto", "#E2862A", "#2E9E44" )
			        RETURN
			            "<tr><td class='nw'>" & FORMAT ( c360_tickets[data_abertura], "dd/mm/yy" ) & "</td>"
			            & "<td><div class='b'>" & SUBSTITUTE ( SUBSTITUTE ( LEFT ( c360_tickets[titulo], 70 ), "&", "&amp;" ), "<", "&lt;" ) & "</div><div class='s'>" & COALESCE ( c360_tickets[equipe], "–" ) & IF ( NOT ISBLANK ( c360_tickets[produto] ), " · " & c360_tickets[produto] ) & "</div></td>"
			            & "<td><span class='pl' style='background:" & _c & "1f;color:" & _c & "'>" & _s & "</span></td></tr>",
			        "",
			        c360_tickets[data_abertura], DESC
			    )
			VAR _RowsAl =
			    CONCATENATEX (
			        TOPN ( 6, _Al, c360_alertas[data_hora], DESC, c360_alertas[chassi], ASC ),
			        "<tr><td class='nw'>" & FORMAT ( c360_alertas[data_hora], "dd/mm/yy" ) & "</td>"
			        & "<td class='nw'><div class='b'>" & c360_alertas[modelo] & "</div><div class='s'>" & c360_alertas[chassi] & "</div></td>"
			        & "<td>" & SUBSTITUTE ( LEFT ( c360_alertas[descricao], 110 ), "<", "&lt;" ) & IF ( LEN ( c360_alertas[descricao] ) > 110, "…" ) & "</td></tr>",
			        "",
			        c360_alertas[data_hora], DESC
			    )
			VAR _RowsCx =
			    CONCATENATEX (
			        TOPN ( 3, c360_cx, c360_cx[data_os], DESC, c360_cx[id], DESC ),
			        VAR _nt = c360_cx[nota]
			        VAR _c = IF ( _nt >= 9, "#2E9E44", IF ( _nt >= 7, "#E2A72A", "#D64545" ) )
			        VAR _cm = c360_cx[comentario]
			        RETURN
			            "<tr><td><span class='pl' style='background:" & _c & "1f;color:" & _c & ";font-size:13px'>" & _nt & "</span></td>"
			            & "<td><div class='b'>" & COALESCE ( c360_cx[modelo], "–" ) & " · " & FORMAT ( c360_cx[data_os], "dd/mm/yy" ) & "</div><div class='s'>" & COALESCE ( c360_cx[tecnico], "" ) & IF ( NOT ISBLANK ( _cm ), " · “" & SUBSTITUTE ( LEFT ( _cm, 160 ), "<", "&lt;" ) & "”" ) & "</div></td></tr>",
			        "",
			        c360_cx[data_os], DESC
			    )
			VAR _Vazio = "<div class='mt'>{x}</div>"
			RETURN
			    IF (
			        NOT [C360 Tem Seleção],
			        "<div class='c3'>" & _Css & "<div class='vz'>Selecione um cliente ou grupo econômico.</div></div>",
			        "<div class='c3'>" & _Css & _Hd & "<div class='g2'><div>"
			        & "<div class='sec f'>Oficina · últimas OS</div>"
			        & IF ( COUNTROWS ( _OS ) = 0, SUBSTITUTE ( _Vazio, "{x}", "Nenhuma OS nos últimos 36 meses." ), "<table><tr><th>Abertura</th><th>OS</th><th>Máquina</th><th>Status</th></tr>" & _RowsOS & "</table>" )
			        & "<div class='sec'>Pesquisa de satisfação</div>"
			        & IF ( COUNTROWS ( c360_cx ) = 0, SUBSTITUTE ( _Vazio, "{x}", "Sem pesquisas respondidas." ), "<table>" & _RowsCx & "</table>" )
			        & "</div><div>"
			        & "<div class='sec f'>ExpertConnect · últimos tickets</div>"
			        & IF ( COUNTROWS ( _Tk ) = 0, SUBSTITUTE ( _Vazio, "{x}", "Nenhum ticket nos últimos 24 meses." ), "<table><tr><th>Data</th><th>Título</th><th>Status</th></tr>" & _RowsTk & "</table>" )
			        & "<div class='sec'>Alertas críticos · 30 dias</div>"
			        & IF ( COUNTROWS ( _Al ) = 0, SUBSTITUTE ( _Vazio, "{x}", "Nenhum alerta crítico nas máquinas conectadas." ), "<table>" & _RowsAl & "</table>" )
			        & "</div></div></div>"
			    )
		displayFolder: Cliente 360\2. Quadros HTML
		lineageTag: a9df1048-5d0c-43fe-a7a7-a3852a937b2c

	/// Sinais de ação para o CEN: renovação (fora da vida útil), probabilidade de compra JD (CLG), gap de cobertura, garantia vencendo, conectividade, financeiro, frequência de visita e perdas para concorrentes. Usar no visual HTML Content.
	measure 'C360 Oportunidades HTML' =
			VAR _Css = [C360 CSS]
			VAR _Card = "<div class='cd' style='border-left-color:{c}'><div class='t'>{t}</div><div class='x'>{x}</div></div>"
			-- 1. Renovação
			VAR _Fora = FILTER ( c360_maquinas, c360_maquinas[situacao_vida] <> "Ativa" )
			VAR _nFora = COUNTROWS ( _Fora )
			VAR _txFora = CONCATENATEX ( TOPN ( 3, _Fora, c360_maquinas[idade_anos], DESC, c360_maquinas[chassi], ASC ), c360_maquinas[modelo] & " (" & c360_maquinas[ano_modelo] & ")", ", ", c360_maquinas[idade_anos], DESC )
			VAR _c1 = IF ( _nFora > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Card, "{c}", "#E2862A" ), "{t}", "Renovação de frota" ), "{x}", "<b>" & _nFora & "</b> máquina(s) fora da vida útil: " & _txFora & IF ( _nFora > 3, "…" ) ) )
			-- 2. Probabilidade de compra JD
			VAR _Prob = FILTER ( c360_maquinas, c360_maquinas[prob_compra] IN { "High", "Very High" } )
			VAR _txProb = CONCATENATEX ( TOPN ( 2, _Prob, c360_maquinas[prob_compra_pct], DESC, c360_maquinas[chassi], ASC ), "<b>" & c360_maquinas[modelo] & "</b> (" & FORMAT ( c360_maquinas[prob_compra_pct], "0%" ) & ") → " & c360_maquinas[modelos_recomendados], "<br>", c360_maquinas[prob_compra_pct], DESC )
			VAR _c2 = IF ( COUNTROWS ( _Prob ) > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Card, "{c}", "#2E9E44" ), "{t}", "Alta probabilidade de compra (JD)" ), "{x}", _txProb ) )
			-- 3. Gap de cobertura
			VAR _Gaps = FILTER ( ADDCOLUMNS ( dProduto, "@g", [Gap Grupos] ), [@g] > 0 )
			VAR _txGap = CONCATENATEX ( _Gaps, dProduto[produto] & " <b>" & FORMAT ( [@g], "#,0" ) & "</b>" & IF ( dProduto[produto] = "PL", " linhas", "" ), " · ", dProduto[ordem], ASC )
			VAR _Vend = [Máq Vendáveis/Ano]
			VAR _OpR = [Oportunidade R$/Ano]
			VAR _c3 = IF ( COUNTROWS ( _Gaps ) > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Card, "{c}", "#3E6FB0" ), "{t}", "Gap de cobertura" ), "{x}", "Faltam (máq): " & _txGap & IF ( _Vend > 0, "<br>" & FORMAT ( _Vend, "#,0" ) & " máq vendáveis/ano · R$ " & FORMAT ( _OpR, "#,0" ) & "/ano em aberto" ) ) )
			-- 4. Garantia vencendo
			VAR _Gar = FILTER ( c360_maquinas, c360_maquinas[garantia_ate] >= TODAY () && c360_maquinas[garantia_ate] <= TODAY () + 90 )
			VAR _c4 = IF ( COUNTROWS ( _Gar ) > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Card, "{c}", "#8a5bc4" ), "{t}", "Garantia vencendo (90 dias)" ), "{x}", CONCATENATEX ( TOPN ( 3, _Gar, c360_maquinas[garantia_ate], ASC, c360_maquinas[chassi], ASC ), "<b>" & c360_maquinas[modelo] & "</b> em " & FORMAT ( c360_maquinas[garantia_ate], "dd/mm/yy" ), "<br>", c360_maquinas[garantia_ate], ASC ) & "<br><span class='s'>Ofertar extensão / contrato de manutenção.</span>" ) )
			-- 5. Conectividade
			VAR _JD = FILTER ( c360_maquinas, c360_maquinas[marca] = "JD" && c360_maquinas[situacao_vida] = "Ativa" )
			VAR _nJD = COUNTROWS ( _JD )
			VAR _nSem = COUNTROWS ( FILTER ( _JD, c360_maquinas[conectada] = 0 ) )
			VAR _c5 = IF ( _nSem > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Card, "{c}", "#E2A72A" ), "{t}", "Conectividade JDLink" ), "{x}", "<b>" & _nSem & "</b> de " & _nJD & " máquinas JD ativas sem comunicar.<br><span class='s'>Ativar JDLink / Operations Center e CSC.</span>" ) )
			-- 6. Financeiro
			VAR _Venc = SUM ( c360_erp[saldo_vencido] )
			VAR _Atr = MAX ( c360_erp[maior_atraso_dias] )
			VAR _c6 = IF ( _Venc > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Card, "{c}", "#D64545" ), "{t}", "Pendência financeira" ), "{x}", "<b>R$ " & FORMAT ( _Venc, "#,0" ) & "</b> vencidos · maior atraso " & _Atr & " dias.<br><span class='s'>Alinhar com o financeiro antes de nova proposta.</span>" ) )
			-- 7. Frequência de visita
			VAR _Dias = [C360 Dias sem Contato]
			VAR _c7 = IF ( ISBLANK ( _Dias ) || _Dias > 60, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Card, "{c}", "#898781" ), "{t}", "Relacionamento" ), "{x}", IF ( ISBLANK ( _Dias ), "Nenhuma visita concluída registrada no CRM.", "Última visita concluída há <b>" & _Dias & " dias</b>." ) & IF ( NOT ISBLANK ( MAX ( segclientes_vw_clientes_atual[frequencia_contato] ) ), "<br><span class='s'>Regra: contato a cada " & MAX ( segclientes_vw_clientes_atual[frequencia_contato] ) & ".</span>" ) ) )
			-- 8. Perdas para concorrentes
			VAR _Perd = FILTER ( c360_oportunidades, c360_oportunidades[resultado] = "Perdida" && c360_oportunidades[data_ref] >= EDATE ( TODAY (), -24 ) && NOT ISBLANK ( c360_oportunidades[concorrente] ) )
			VAR _Conc = TOPN ( 1, SUMMARIZE ( _Perd, c360_oportunidades[concorrente], "@n", COUNTROWS ( c360_oportunidades ) ), [@n], DESC, c360_oportunidades[concorrente], ASC )
			VAR _c8 = IF ( COUNTROWS ( _Perd ) > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Card, "{c}", "#6A3D8F" ), "{t}", "Concorrência" ), "{x}", "<b>" & COUNTROWS ( _Perd ) & "</b> negócio(s) perdido(s) em 24m · principal: <b>" & MAXX ( _Conc, c360_oportunidades[concorrente] ) & "</b> (" & MAXX ( _Conc, [@n] ) & ").<br><span class='s'>Frota concorrente é alvo de renovação.</span>" ) )
			VAR _Todos = _c6 & _c2 & _c3 & _c1 & _c4 & _c5 & _c8 & _c7
			RETURN
			    IF (
			        NOT [C360 Tem Seleção],
			        "<div class='c3'>" & _Css & "<div class='vz'>Selecione um cliente ou grupo econômico.</div></div>",
			        "<div class='c3'>" & _Css
			        & IF ( _Todos = "", "<div class='vz'>Nenhum sinal de ação no momento.</div>", "<div class='g4'>" & _Todos & "</div>" )
			        & "</div>"
			    )
		displayFolder: Cliente 360\2. Quadros HTML
		lineageTag: db3430f8-b633-4ff2-be99-cfbdc58e4cdc

	/// % de cobertura da unidade (parque JD válido ÷ demanda do grupo, Sistema de Cobertura). Texto para o cartão: mostra 'sem demanda' quando não há área suficiente.
	measure 'C360 % Cobertura' =
			VAR _p = [% Cobertura Grupos]
			RETURN IF ( ISBLANK ( _p ), "sem demanda", FORMAT ( _p, "0%" ) )
		displayFolder: Cliente 360\1. Cartões
		lineageTag: 17ee7966-0cb3-4682-9db5-bef6aa4a4ce1

	/// Grupos econômicos (unidade da Segmentação, ≥ 100 ha) com propriedade mapeada no contexto. Um grupo com propriedades em 2 municípios conta nos dois.
	measure 'Oport Grupos' = DISTINCTCOUNT ( fOportunidadeMunicipio[unidade] )
		formatString: #,0
		displayFolder: Cobertura\11. Oportunidade por município
		lineageTag: 23aba7a1-e6d1-4620-bfbe-b99a95a61680

	/// Clientes (CNPJ/CPF) dos grupos ≥ 100 ha com propriedade mapeada no contexto.
	measure 'Oport Clientes' = DISTINCTCOUNT ( fOportunidadeMunicipio[cliente_id] )
		formatString: #,0
		displayFolder: Cobertura\11. Oportunidade por município
		lineageTag: 7782f849-6217-45e4-aee3-e18706fc58fc

	/// Propriedades mapeadas na Segmentação dos grupos ≥ 100 ha.
	measure 'Oport Propriedades' = COUNTROWS ( fOportunidadeMunicipio )
		formatString: #,0
		displayFolder: Cobertura\11. Oportunidade por município
		lineageTag: 75d9bc69-6982-4df7-bb9a-d36325629b24

	/// Área das propriedades no contexto (sem áreas sobrepostas).
	measure 'Oport Área' = SUM ( fOportunidadeMunicipio[area_ha] )
		formatString: #,0
		displayFolder: Cobertura\11. Oportunidade por município
		lineageTag: 72dd09f3-8f82-4ce1-87c1-e9f2605487e1

	/// Venda média anual histórica por grupo da faixa de área (média do faturamento anualizado dos grupos da faixa que compraram). Acima da faixa = média ponderada pelos grupos.
	measure 'Oport Venda Média Grupo' = DIVIDE ( SUMX ( fOportunidadeMunicipio, fOportunidadeMunicipio[venda_media_faixa] * fOportunidadeMunicipio[peso] ), SUM ( fOportunidadeMunicipio[peso] ) )
		displayFolder: Cobertura\11. Oportunidade por município
		lineageTag: fda0ed20-bfab-4858-9de5-13afd7c432b9

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        _v >= 1E9, "\R$ #,0,,,.0 \B\i",
				        _v >= 1E6, "\R$ #,0,,.0 \M\M",
				        _v >= 1E3, "\R$ #,0, \m\i\l",
				        "\R$ #,0"
				    )

	/// Faturamento anualizado dos grupos, rateado entre municípios pela área de cada propriedade.
	measure 'Oport Faturamento Atual' = SUM ( fOportunidadeMunicipio[faturamento_rateado] )
		displayFolder: Cobertura\11. Oportunidade por município
		lineageTag: 0b018917-6f96-468e-bc20-4495e240c554

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        _v >= 1E9, "\R$ #,0,,,.0 \B\i",
				        _v >= 1E6, "\R$ #,0,,.0 \M\M",
				        _v >= 1E3, "\R$ #,0, \m\i\l",
				        "\R$ #,0"
				    )

	/// Oportunidade anual = Σ MAX(0, venda média da faixa − faturamento anualizado do grupo), rateada entre municípios pela área de cada propriedade.
	measure 'Oportunidade R$' = SUM ( fOportunidadeMunicipio[oportunidade] )
		displayFolder: Cobertura\11. Oportunidade por município
		lineageTag: 3126c4a1-644f-43f5-8160-0eb00fed88cb

		formatStringDefinition =
				VAR _v = ABS ( SELECTEDMEASURE () )
				RETURN
				    SWITCH (
				        TRUE (),
				        _v >= 1E9, "\R$ #,0,,,.0 \B\i",
				        _v >= 1E6, "\R$ #,0,,.0 \M\M",
				        _v >= 1E3, "\R$ #,0, \m\i\l",
				        "\R$ #,0"
				    )

	/// % alvo de participação (faturamento ÷ potencial de investimento) escolhido no slicer pctAlvoParticipacao; padrão 15%.
	measure '% Alvo Participação' = SELECTEDVALUE ( pctAlvoParticipacao[Value], 0.3 )
		formatString: 0%
		displayFolder: Visão geral\4. Participação
		lineageTag: d5699411-5110-4a3d-827b-c213297abaeb

	/// Faturamento necessário para atingir o % alvo de participação sobre o potencial de investimento em máquinas (10% do ROB).
	measure 'Faturamento Alvo' = [Potencial Investimento Máquinas] * [% Alvo Participação]
		formatString: \R$ #,0.0
		displayFolder: Visão geral\4. Participação
		lineageTag: b31d833f-ebc7-4d39-a717-72d7ec7e9939

	/// Quanto falta de faturamento para chegar ao % alvo de participação (zero quando já atingido).
	measure 'Gap Faturamento Alvo' = MAX ( 0, [Faturamento Alvo] - [Faturamento na Matriz] )
		formatString: \R$ #,0.0
		displayFolder: Visão geral\4. Participação
		lineageTag: 40323cae-30ad-42a5-895d-830cd0666700

	/// Subtítulo do cartão Alvo de participação.
	measure 'Rótulo Alvo Participação' =
			VAR _mm = "R$ #,0.0"
			VAR _gap = [Gap Faturamento Alvo]
			RETURN
			    "Faturamento Alvo: " & FORMAT ( [Faturamento Alvo] / 1E6, _mm ) & " MM"
			        & UNICHAR ( 10 )
		displayFolder: Visão geral\6. Rótulos dos cartões
		lineageTag: e57cc0e8-5ca2-4dd1-a9a7-1226c88a1b14

	/// Subtítulo do cartão Participação: de onde vem o valor.
	measure 'Rótulo Participação' = "Faturamento Nissey ÷ potencial de investimento em máquinas (" & FORMAT ( [% ROB Investimento Máquinas], "0%" ) & " do ROB)"
		displayFolder: Visão geral\6. Rótulos dos cartões
		lineageTag: 9455b0bc-d978-480f-ab78-3c9a22ec4190

	/// Rodapé do cartão Potencial de investimento: % do ROB que vira potencial (1 − custo operacional da execução vigente).
	measure 'Rótulo Potencial Investimento' =
			VAR _execucao =
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[execucao_id] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ) )
			VAR _custo =
			    CALCULATE (
			        MAX ( segclientes_execucao[custo_operacional_padrao] ),
			        REMOVEFILTERS ( segclientes_execucao ),
			        segclientes_execucao[execucao_id] = _execucao
			    )
			VAR _tot = [Potencial Total]
			VAR _txTot =
			    IF ( _tot >= 1E9, FORMAT ( _tot / 1E9, "\R$ #,0.00" ) & " Bi", FORMAT ( _tot / 1E6, "\R$ #,0.0" ) & " MM" )
			RETURN
			    "Em máquinas: " & FORMAT ( [% ROB Investimento Máquinas], "0%" ) & " do ROB"
			        & UNICHAR ( 10 ) & "| Invest. total: " & _txTot & " (" & FORMAT ( 1 - _custo, "0%" ) & " do ROB)"
		displayFolder: Visão geral\6. Rótulos dos cartões
		lineageTag: 15cbdce5-0793-42fc-b377-fa1b79dce003

	/// Fatia de pós-vendas (peças + serviços) no faturamento Nissey dos clientes, na janela da segmentação. Mostra quanto do investimento do cliente com a Nissey vai para pós-vendas.
	measure '% Pós-Vendas no Faturamento' =
			VAR _maq = SUM ( segclientes_vw_clientes_atual[fat_maquinas] )
			VAR _pos = SUM ( segclientes_vw_clientes_atual[fat_pecas] ) + SUM ( segclientes_vw_clientes_atual[fat_servicos] )
			RETURN DIVIDE ( _pos, _maq + _pos )
		formatString: 0.0%
		displayFolder: Segmentação\Potencial de Máquinas\0. Premissas
		lineageTag: 20cfd67d-3eaf-4db8-b89d-988860a60237

	/// PV não tem indústria oficial: estimada pela demanda do Sistema de Cobertura × taxa de renovação de 10% ao ano.
	measure 'Indústria Estimada PV' = CALCULATE ( [Demanda], KEEPFILTERS ( dProduto[produto] = "PV" ) ) * 0.10
		formatString: #,0
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: 331a3c34-5cf6-46a8-870c-a92c2c8626c7

	/// PL não tem indústria oficial: demanda em linhas ÷ 22 linhas (plantadeira média = 1 unidade) × taxa de renovação de 10% ao ano. Em unidades de plantadeira.
	measure 'Indústria Estimada PL' = DIVIDE ( CALCULATE ( [Demanda], KEEPFILTERS ( dProduto[produto] = "PL" ) ), 22 ) * 0.10
		formatString: #,0
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: a3382bf8-5761-4245-8b4a-c98326b02fd7

	/// Subtítulo do cartão de indústria estimada de PV e PL.
	measure 'Rótulo Indústria Estimada' =
			"PV " & FORMAT ( [Indústria Estimada PV], "#,0" ) & " · PL " & FORMAT ( [Indústria Estimada PL], "#,0" ) & " un."
			    & UNICHAR ( 10 ) & "demanda × 10%/ano · PL = linhas ÷ 22"
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: 7a6ba36b-6237-481f-aa01-f87baa64ebb5

	/// Soma da indústria estimada de PV (máquinas) e PL (unidades de 22 linhas) por ano.
	measure 'Indústria Estimada PV + PL' = [Indústria Estimada PV] + [Indústria Estimada PL]
		formatString: #,0
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: e05cc51b-0578-4e9a-ad01-d656aa63e288

	/// Parcela do ROB considerada potencial de investimento em máquinas (10%). Base da Participação e do Alvo de participação.
	measure '% ROB Investimento Máquinas' = 0.10
		formatString: 0%
		displayFolder: Visão geral\2. Potencial
		lineageTag: f3d264d5-9501-48bc-84e6-d152f13baff3

	/// Receita bruta anual (ROB) das unidades, contada uma vez por unidade.
	measure 'ROB Total' =
			SUMX (
			    VALUES ( segclientes_vw_clientes_atual[unidade] ),
			    CALCULATE ( MAX ( segclientes_vw_clientes_atual[rob_base] ) )
			)
		formatString: \R$ #,0
		displayFolder: Visão geral\2. Potencial
		lineageTag: ff4a48b3-de42-4015-93ea-2bc855541331

	/// Potencial de investimento em máquinas = 10% do ROB. Destaque do cartão Potencial de Investimento e denominador da Participação.
	measure 'Potencial Investimento Máquinas' = [ROB Total] * [% ROB Investimento Máquinas]
		formatString: \R$ #,0.0
		displayFolder: Visão geral\2. Potencial
		lineageTag: 990b03d7-a5b7-4a6b-90ae-ca5007dd543a

	/// Fechamento: unidades Ganhas no CRM (linha AG). Respeita os filtros da página; sem filtro de data usa o período do relatório de indústria.
	measure 'VP Retail' =
			VAR _temData =
			    ISFILTERED ( ci_oportunidades[data_ref] ) || ISFILTERED ( ci_oportunidades[fy] )
			        || ISFILTERED ( ci_oportunidades[mes] ) || ISFILTERED ( ci_oportunidades[mes_label] )
			VAR _ini = MIN ( vp_industria[periodo_inicio] )
			VAR _fim = MAX ( vp_industria[periodo_fim] )
			RETURN
			    IF (
			        _temData,
			        CALCULATE ( SUM ( ci_oportunidades[quantidade] ) + 0, ci_oportunidades[resultado] = "Ganha", NOT ISBLANK ( ci_oportunidades[vp_grupo] ) ),
			        CALCULATE (
			            SUM ( ci_oportunidades[quantidade] ) + 0,
			            ci_oportunidades[resultado] = "Ganha",
			            NOT ISBLANK ( ci_oportunidades[vp_grupo] ),
			            KEEPFILTERS ( ci_oportunidades[data_ref] >= _ini && ci_oportunidades[data_ref] <= _fim )
			        )
			    )
		formatString: #,0
		displayFolder: Vendas Perdidas
		lineageTag: 8066e0cb-05fb-401b-8b2d-bdf5e7d28113

	/// Fechamento: unidades Perdidas no CRM (linha AG). Respeita os filtros da página; sem filtro de data usa o período do relatório de indústria.
	measure 'VP Perdidas' =
			VAR _temData =
			    ISFILTERED ( ci_oportunidades[data_ref] ) || ISFILTERED ( ci_oportunidades[fy] )
			        || ISFILTERED ( ci_oportunidades[mes] ) || ISFILTERED ( ci_oportunidades[mes_label] )
			VAR _ini = MIN ( vp_industria[periodo_inicio] )
			VAR _fim = MAX ( vp_industria[periodo_fim] )
			RETURN
			    IF (
			        _temData,
			        CALCULATE ( SUM ( ci_oportunidades[quantidade] ) + 0, ci_oportunidades[resultado] = "Perdida", NOT ISBLANK ( ci_oportunidades[vp_grupo] ) ),
			        CALCULATE (
			            SUM ( ci_oportunidades[quantidade] ) + 0,
			            ci_oportunidades[resultado] = "Perdida",
			            NOT ISBLANK ( ci_oportunidades[vp_grupo] ),
			            KEEPFILTERS ( ci_oportunidades[data_ref] >= _ini && ci_oportunidades[data_ref] <= _fim )
			        )
			    )
		formatString: #,0
		displayFolder: Vendas Perdidas
		lineageTag: 41cea942-d316-47ba-bc4d-57a739e43b49

	/// Indústria (relatório Current versus Prior, período atual) da categoria.
	measure 'VP IND' =
			IF (
			    ISINSCOPE ( dVPSub[sub] ),
			    SUM ( dVPSub[ind_atual] ),
			    SUM ( dVPGrupo[ind_atual] )
			)
		formatString: #,0
		displayFolder: Vendas Perdidas
		lineageTag: 7ca73283-945a-47e0-b450-7093405e0e42

	/// Participação nas negociações = (Retail + VP) / IND, sempre na área toda e no período do relatório de indústria (ignora os filtros da página).
	measure 'VP % Participacao' = DIVIDE ( [VP Retail Part] + [VP Perdidas Part], [VP IND] )
		formatString: 0%
		displayFolder: Vendas Perdidas
		lineageTag: 6eec2da4-2ede-4ccf-83c6-0bb05e8bfd1a

	/// Taxa de fechamento = Retail / (Retail + VP).
	measure 'VP % Fechamento' = DIVIDE ( [VP Retail], [VP Retail] + [VP Perdidas] )
		formatString: 0%
		displayFolder: Vendas Perdidas
		lineageTag: d4fc7a54-c497-4d74-9e70-5ea14c7e5438

	/// Período do relatório de indústria (usado na participação).
	measure 'VP Periodo' = "Indústria: " & FORMAT ( MIN ( vp_industria[periodo_inicio] ), "mmm/yy" ) & " a " & FORMAT ( MAX ( vp_industria[periodo_fim] ), "mmm/yy" )
		displayFolder: Vendas Perdidas
		lineageTag: 22125427-7c0e-42f0-804c-24420e77df86

	/// Participação: unidades Ganhas no CRM (linha AG), área toda, período do relatório de indústria. Ignora os filtros da página.
	measure 'VP Retail Part' =
			VAR _ini = MIN ( vp_industria[periodo_inicio] )
			VAR _fim = MAX ( vp_industria[periodo_fim] )
			RETURN
			    CALCULATE (
			        SUM ( ci_oportunidades[quantidade] ) + 0,
			        REMOVEFILTERS ( ci_oportunidades[filial], ci_oportunidades[filial_sigla], ci_oportunidades[vendedor], ci_oportunidades[fy], ci_oportunidades[mes], ci_oportunidades[mes_label], ci_oportunidades[data_ref], ci_oportunidades[local], ci_oportunidades[cidade], ci_oportunidades[uf], ci_oportunidades[linha], ci_oportunidades[produto], ci_oportunidades[concorrente_label] ),
			        ci_oportunidades[resultado] = "Ganha",
			        NOT ISBLANK ( ci_oportunidades[vp_grupo] ),
			        ci_oportunidades[data_ref] >= _ini && ci_oportunidades[data_ref] <= _fim
			    )
		formatString: #,0
		displayFolder: Vendas Perdidas
		lineageTag: 94e7162e-3d0e-4d15-9e0e-b380582ce2d2

	/// Participação: unidades Perdidas no CRM (linha AG), área toda, período do relatório de indústria. Ignora os filtros da página.
	measure 'VP Perdidas Part' =
			VAR _ini = MIN ( vp_industria[periodo_inicio] )
			VAR _fim = MAX ( vp_industria[periodo_fim] )
			RETURN
			    CALCULATE (
			        SUM ( ci_oportunidades[quantidade] ) + 0,
			        REMOVEFILTERS ( ci_oportunidades[filial], ci_oportunidades[filial_sigla], ci_oportunidades[vendedor], ci_oportunidades[fy], ci_oportunidades[mes], ci_oportunidades[mes_label], ci_oportunidades[data_ref], ci_oportunidades[local], ci_oportunidades[cidade], ci_oportunidades[uf], ci_oportunidades[linha], ci_oportunidades[produto], ci_oportunidades[concorrente_label] ),
			        ci_oportunidades[resultado] = "Perdida",
			        NOT ISBLANK ( ci_oportunidades[vp_grupo] ),
			        ci_oportunidades[data_ref] >= _ini && ci_oportunidades[data_ref] <= _fim
			    )
		formatString: #,0
		displayFolder: Vendas Perdidas
		lineageTag: 88757b39-e44e-4c09-a111-865f7b0b050a

	/// Subtítulo das tabelas de participação.
	measure 'VP Sub Participacao' =
			VAR _filtro =
			    ISFILTERED ( ci_oportunidades[filial] ) || ISFILTERED ( ci_oportunidades[vendedor] )
			        || ISFILTERED ( ci_oportunidades[fy] ) || ISFILTERED ( ci_oportunidades[data_ref] )
			RETURN
			    "Part. = (Retail + VP) / IND  •  área toda  •  " & FORMAT ( MIN ( vp_industria[periodo_inicio] ), "mmm/yy" ) & " a " & FORMAT ( MAX ( vp_industria[periodo_fim] ), "mmm/yy" )
			        & IF ( _filtro, "  •  ⚠ não segue os filtros da página" )
		displayFolder: Vendas Perdidas
		lineageTag: 61ff2676-a3fd-4242-af7e-f630d940f9f9

	/// Subtítulo das tabelas de fechamento: período efetivo e filtros.
	measure 'VP Sub Fechamento' =
			VAR _temData =
			    ISFILTERED ( ci_oportunidades[data_ref] ) || ISFILTERED ( ci_oportunidades[fy] )
			        || ISFILTERED ( ci_oportunidades[mes] ) || ISFILTERED ( ci_oportunidades[mes_label] )
			VAR _ini = IF ( _temData, CALCULATE ( MIN ( ci_oportunidades[data_ref] ), NOT ISBLANK ( ci_oportunidades[vp_grupo] ), ci_oportunidades[resultado] IN { "Ganha", "Perdida" } ), MIN ( vp_industria[periodo_inicio] ) )
			VAR _fim = IF ( _temData, CALCULATE ( MAX ( ci_oportunidades[data_ref] ), NOT ISBLANK ( ci_oportunidades[vp_grupo] ), ci_oportunidades[resultado] IN { "Ganha", "Perdida" } ), MAX ( vp_industria[periodo_fim] ) )
			VAR _filtro = ISFILTERED ( ci_oportunidades[filial] ) || ISFILTERED ( ci_oportunidades[vendedor] )
			RETURN
			    "Fech. = Retail / (Retail + VP)  •  "
			        & IF ( ISBLANK ( _ini ), "sem negócios no filtro", FORMAT ( _ini, "mmm/yy" ) & " a " & FORMAT ( _fim, "mmm/yy" ) )
			        & IF ( _filtro, "  •  com filtro de filial/vendedor" )
		displayFolder: Vendas Perdidas
		lineageTag: 8cf261db-9ec9-45e1-b57a-cccbc0c8a40c

	column Coluna
		isHidden
		lineageTag: d956da67-113e-4ad5-af17-9880df6d139c
		isNameInferred
		sourceColumn: [Coluna]

	partition _Medidas = calculated
		mode: import
		source = ROW("Coluna", BLANK())

