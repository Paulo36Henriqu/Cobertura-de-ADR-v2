		lineageTag: cfb238c2-42ba-4f42-bf58-1295679961c0

	/// % do ROB anual que o cliente consegue destinar à compra de máquinas (slicer pctROBMaquinas; padrão 8%).
	measure '% ROB Máquinas' = SELECTEDVALUE ( pctROBMaquinas[Value], 0.08 )
		formatString: 0%
		displayFolder: Segmentação\Potencial de Máquinas\0. Premissas
		lineageTag: 02f0fabe-5366-4224-97f6-420c32644ba9

	/// Frota necessária pelo Sistema de Cobertura, calculada por grupo econômico (= Demanda Grupos). PL em linhas só entra com apenas PL no contexto.
	measure 'Máq Necessidade' = [Demanda Grupos]
		formatString: #,0
		displayFolder: Segmentação\Potencial de Máquinas\1. Frota
		lineageTag: b65d85e3-82d5-42bc-a445-55557f4e6683

	/// Parque válido (dentro da vida útil) identificado nos CPFs/CNPJs do grupo (= Parque Grupos).
	measure 'Máq Parque JD' = [Parque Grupos]
		formatString: #,0
		displayFolder: Segmentação\Potencial de Máquinas\1. Frota
		lineageTag: 0bff9e4e-a27c-4297-b160-f3fc38b94dbb

	/// Máquinas que o grupo precisa e que não são parque JD válido (concorrente, vencida ou faltante) = oportunidade de conquista de frota (= Gap Grupos).
	measure 'Máq Gap' = [Gap Grupos]
		formatString: #,0
		displayFolder: Segmentação\Potencial de Máquinas\1. Frota
		lineageTag: 2620a1ce-4078-471a-90de-fd3612809b8c

	/// Participação da frota JD válida na necessidade do grupo: 1 − Gap ÷ Necessidade (excedente de um produto não compensa outro).
	measure 'Share Frota JD' =
			VAR _d = [Demanda Grupos]
			RETURN IF ( _d > 0, 1 - DIVIDE ( [Gap Grupos], _d ) )
		formatString: 0.0%
		displayFolder: Segmentação\Potencial de Máquinas\1. Frota
		lineageTag: fe0db21d-4f27-4b90-ab8f-1743d86ec06e

	/// Máquinas que o grupo precisa comprar por ano para manter a frota necessária: necessidade ÷ vida útil, por grupo × produto. PL em linhas só entra com apenas PL no contexto.
	measure 'Máq Renovação/Ano' =
			VAR _min = VALUE ( LOOKUPVALUE ( siscobertura_param_geral[valor], siscobertura_param_geral[chave], "area_minima_ha" ) )
			VAR _soPL = SELECTEDVALUE ( dProduto[produto] ) = "PL"
			VAR _t =
			    FILTER (
			        SUMMARIZE ( siscobertura_cliente_produto, siscobertura_cliente_produto[grupo_chave], siscobertura_cliente_produto[produto] ),
			        _soPL || siscobertura_cliente_produto[produto] <> "PL"
			    )
			RETURN
			    SUMX (
			        _t,
			        VAR _f = CALCULATE ( SUM ( siscobertura_cliente_produto[demanda_fracionada] ) )
			        VAR _a = CALCULATE ( SUM ( siscobertura_cliente_produto[area_base_ha] ) )
			        VAR _d = IF ( _a >= _min || siscobertura_cliente_produto[produto] = "TRCE", ROUNDUP ( ROUND ( _f, 6 ), 0 ), 0 )
			        VAR _v = LOOKUPVALUE ( dPremissaMaquina[vida_util], dPremissaMaquina[produto], siscobertura_cliente_produto[produto] )
			        RETURN DIVIDE ( _d, _v )
			    )
		formatString: #,0
		displayFolder: Segmentação\Potencial de Máquinas\1. Frota
		lineageTag: 3c192f94-3638-4082-9a15-4f35072d4dda

	/// Valor anual de renovação da frota necessária: Σ (necessidade ÷ vida útil × preço de referência) por grupo × produto. Inclui PL (linhas × preço por linha).
	measure 'Mercado Máq Físico R$' =
			VAR _min = VALUE ( LOOKUPVALUE ( siscobertura_param_geral[valor], siscobertura_param_geral[chave], "area_minima_ha" ) )
			RETURN
			    SUMX (
			        SUMMARIZE ( siscobertura_cliente_produto, siscobertura_cliente_produto[grupo_chave], siscobertura_cliente_produto[produto] ),
			        VAR _f = CALCULATE ( SUM ( siscobertura_cliente_produto[demanda_fracionada] ) )
			        VAR _a = CALCULATE ( SUM ( siscobertura_cliente_produto[area_base_ha] ) )
			        VAR _d = IF ( _a >= _min || siscobertura_cliente_produto[produto] = "TRCE", ROUNDUP ( ROUND ( _f, 6 ), 0 ), 0 )
			        VAR _v = LOOKUPVALUE ( dPremissaMaquina[vida_util], dPremissaMaquina[produto], siscobertura_cliente_produto[produto] )
			        VAR _p = LOOKUPVALUE ( dPremissaMaquina[preco_ref], dPremissaMaquina[produto], siscobertura_cliente_produto[produto] )
			        RETURN DIVIDE ( _d, _v ) * _p
			    )
		formatString: \R$ #,0,,.00 \M\i
		displayFolder: Segmentação\Potencial de Máquinas\2. Mercado R$
		lineageTag: 5263d9d1-b08b-4873-a11c-28b2b165e210

	/// Valor do gap de frota a preço de referência: Σ gap × preço por grupo × produto (inclui PL em linhas). Oportunidade pontual de conquista, não anual.
	measure 'Valor Gap R$' =
			VAR _min = VALUE ( LOOKUPVALUE ( siscobertura_param_geral[valor], siscobertura_param_geral[chave], "area_minima_ha" ) )
			RETURN
			    SUMX (
			        SUMMARIZE ( siscobertura_cliente_produto, siscobertura_cliente_produto[grupo_chave], siscobertura_cliente_produto[produto] ),
			        VAR _f = CALCULATE ( SUM ( siscobertura_cliente_produto[demanda_fracionada] ) )
			        VAR _a = CALCULATE ( SUM ( siscobertura_cliente_produto[area_base_ha] ) )
			        VAR _d = IF ( _a >= _min || siscobertura_cliente_produto[produto] = "TRCE", ROUNDUP ( ROUND ( _f, 6 ), 0 ), 0 )
			        VAR _pq = CALCULATE ( SUM ( siscobertura_cliente_produto[parque_valido] ) )
			        VAR _p = LOOKUPVALUE ( dPremissaMaquina[preco_ref], dPremissaMaquina[produto], siscobertura_cliente_produto[produto] )
			        RETURN MAX ( 0, _d - _pq ) * _p
			    )
		formatString: \R$ #,0,,.00 \M\i
		displayFolder: Segmentação\Potencial de Máquinas\2. Mercado R$
		lineageTag: 54df6023-f4c1-40f1-9e7d-a8ac1b0ea5d7

	/// ROB anual (segmentação, rob_base) das unidades presentes na cobertura, contado uma vez por unidade inteira.
	measure 'ROB Grupos' =
			SUMX (
			    VALUES ( siscobertura_cliente_produto[grupo_chave] ),
			    VAR _u = siscobertura_cliente_produto[grupo_chave]
			    RETURN CALCULATE ( MAX ( segclientes_vw_clientes_atual[rob_base] ), REMOVEFILTERS ( segclientes_vw_clientes_atual ), segclientes_vw_clientes_atual[unidade] = _u )
			)
		formatString: \R$ #,0,,.00 \M\i
		displayFolder: Segmentação\Potencial de Máquinas\2. Mercado R$
		lineageTag: 829a4c95-3b06-4658-8055-45e6a4d03b36

	/// Quanto o grupo consegue investir em máquinas por ano: ROB × % ROB Máquinas. Com filtro de produto, rateado pela fatia do produto no mercado físico do grupo.
	measure 'Teto Financeiro R$' =
			SUMX (
			    VALUES ( siscobertura_cliente_produto[grupo_chave] ),
			    [ROB Grupos] * [% ROB Máquinas] * COALESCE ( [Peso Produto Mercado], 0 )
			)
		formatString: \R$ #,0,,.00 \M\i
		displayFolder: Segmentação\Potencial de Máquinas\2. Mercado R$
		lineageTag: a7631a00-a036-41e6-adb1-e258340acb33

	/// Faturamento anualizado de máquinas da Nissey na unidade inteira (todos os CPFs/CNPJs, uma vez por chave_doc), só para unidades na cobertura. O faturamento não vem por produto: com filtro de produto é rateado pelo parque JD válido do grupo (ou pelo mercado, sem parque).
	measure 'Fat Máquinas Grupos' =
			SUMX (
			    VALUES ( siscobertura_cliente_produto[grupo_chave] ),
			    VAR _u = siscobertura_cliente_produto[grupo_chave]
			    VAR _fat = CALCULATE ( [Fat Máquinas], REMOVEFILTERS ( segclientes_vw_clientes_atual ), segclientes_vw_clientes_atual[unidade] = _u )
			    RETURN _fat * COALESCE ( [Peso Produto Faturamento], 0 )
			)
		formatString: \R$ #,0,,.00 \M\i
		displayFolder: Segmentação\Potencial de Máquinas\2. Mercado R$
		lineageTag: 9b8ab10c-a4e1-4dc3-a554-6f922566fd4f

	/// Mercado anual de máquinas do grupo: menor valor entre a renovação física da frota (Mercado Máq Físico R$) e o teto financeiro (ROB × %). Sem ROB calculado, usa só a renovação física. Calculado grupo a grupo.
	measure 'Mercado Máquinas R$' =
			SUMX (
			    VALUES ( siscobertura_cliente_produto[grupo_chave] ),
			    VAR _fis = [Mercado Máq Físico R$]
			    VAR _teto = [Teto Financeiro R$]
			    RETURN IF ( _teto > 0, MIN ( _fis, _teto ), _fis )
			)
		formatString: \R$ #,0,,.00 \M\i
		displayFolder: Segmentação\Potencial de Máquinas\2. Mercado R$
		lineageTag: 0e35b147-e32e-4ed2-9602-9edb0b64cd1a

	/// Participação da Nissey nas compras anuais de máquinas do cliente: faturamento anualizado de máquinas ÷ mercado de máquinas (R$/ano). Pode passar de 100% em ano de renovação concentrada.
	measure 'Market Share Máquinas' = DIVIDE ( [Fat Máquinas Grupos], [Mercado Máquinas R$] )
		formatString: 0.0%
		displayFolder: Segmentação\Potencial de Máquinas\3. Participação
		lineageTag: 52f381a6-2304-4c2d-9b58-3b6c40488531

	/// Quanto do mercado anual de máquinas do grupo ainda não é Nissey: max(0, mercado − faturamento de máquinas), grupo a grupo.
	measure 'Oportunidade R$/Ano' =
			SUMX (
			    VALUES ( siscobertura_cliente_produto[grupo_chave] ),
			    MAX ( 0, [Mercado Máquinas R$] - [Fat Máquinas Grupos] )
			)
		formatString: \R$ #,0,,.00 \M\i
		displayFolder: Segmentação\Potencial de Máquinas\3. Participação
		lineageTag: 85029320-0e2b-4deb-9741-f43bf3cf9a73

	/// Máquinas que ainda podemos vender por ano ao grupo: renovação anual × (mercado ajustado ÷ mercado físico, quando o ROB limita) × (1 − market share, limitado a 100%). PL em linhas só entra com apenas PL no contexto.
	measure 'Máq Vendáveis/Ano' =
			SUMX (
			    VALUES ( siscobertura_cliente_produto[grupo_chave] ),
			    VAR _ren = [Máq Renovação/Ano]
			    VAR _fis = [Mercado Máq Físico R$]
			    VAR _aj = [Mercado Máquinas R$]
			    VAR _fator = IF ( _fis > 0, DIVIDE ( _aj, _fis ), 0 )
			    VAR _sh = MIN ( 1, COALESCE ( DIVIDE ( [Fat Máquinas Grupos], _aj ), 0 ) )
			    RETURN _ren * _fator * ( 1 - _sh )
			)
		formatString: #,0
		displayFolder: Segmentação\Potencial de Máquinas\3. Participação
		lineageTag: 4fa7c1da-c631-45cd-b0e4-fdbe9d90112b

	/// Horizonte de 3 anos: máquinas vendáveis por ano × 3.
	measure 'Máq Vendáveis 3 Anos' = [Máq Vendáveis/Ano] * 3
		formatString: #,0
		displayFolder: Segmentação\Potencial de Máquinas\3. Participação
		lineageTag: b97d1e8f-db18-4292-9607-c171491095ce

	/// Grupos (unidades) com mercado de máquinas > 0.
	measure 'Grupos c/ Mercado' = COUNTROWS ( FILTER ( VALUES ( siscobertura_cliente_produto[grupo_chave] ), [Mercado Máq Físico R$] > 0 ) )
		formatString: #,0
		displayFolder: Segmentação\Potencial de Máquinas\3. Participação
		lineageTag: 4a273da8-12dc-45c0-8c26-b6f7f38e58b1

	/// Grupos em que o teto financeiro (ROB × %) é menor que a renovação física da frota.
	measure 'Grupos Limitados pelo ROB' = COUNTROWS ( FILTER ( VALUES ( siscobertura_cliente_produto[grupo_chave] ), VAR _t = [Teto Financeiro R$] RETURN _t > 0 && _t < [Mercado Máq Físico R$] ) )
		formatString: #,0
		displayFolder: Segmentação\Potencial de Máquinas\3. Participação
		lineageTag: b474586c-2352-430c-adba-4a004c1e4b22

	/// Classificação pelo market share de máquinas: < 20% Conquistar, 20–60% Expandir, ≥ 60% Fidelizar.
	measure 'Status Oportunidade Máq' =
			VAR _m = [Mercado Máquinas R$]
			VAR _s = [Market Share Máquinas]
			RETURN
			    IF ( _m > 0,
			        SWITCH ( TRUE (), _s < 0.2, "Conquistar", _s < 0.6, "Expandir", "Fidelizar" )
			    )
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: bdc47546-11db-4122-a172-b683eb49dd0d

	/// Cor do market share: vermelho < 20%, laranja 20–60%, verde ≥ 60%.
	measure 'Cor Share Máquinas' =
			VAR _m = [Mercado Máquinas R$]
			VAR _s = [Market Share Máquinas]
			RETURN
			    IF ( _m > 0,
			        SWITCH ( TRUE (), _s < 0.2, "#C0392B", _s < 0.6, "#E67E22", "#2E7D32" ),
			        "#9E9E9E"
			    )
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: 6800429b-3d9a-473f-886a-0152803e8c6c

	/// Cor do share de frota JD: vermelho < 30%, laranja 30–70%, verde ≥ 70%.
	measure 'Cor Share Frota' =
			VAR _s = [Share Frota JD]
			RETURN
			    IF ( ISBLANK ( _s ), "#9E9E9E",
			        SWITCH ( TRUE (), _s < 0.3, "#C0392B", _s < 0.7, "#E67E22", "#2E7D32" )
			    )
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: ff26a17a-d891-4179-9d62-5d980fbafe21

	measure 'Rótulo Máq Necessidade' = "parque JD válido: " & FORMAT ( COALESCE ( [Máq Parque JD], 0 ), "#,0" ) & " máq."
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: 68e3575a-079a-41a7-b648-a6930776d6cf

	measure 'Rótulo Share Frota' = "gap de " & FORMAT ( COALESCE ( [Máq Gap], 0 ), "#,0" ) & " máq. · R$ " & FORMAT ( COALESCE ( [Valor Gap R$], 0 ) / 1e6, "#,0" ) & " Mi"
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: 258cd942-b49c-4cd0-a269-d156a50b1588

	measure 'Rótulo Máq Vendáveis' = "≈ " & FORMAT ( COALESCE ( [Máq Vendáveis 3 Anos], 0 ), "#,0" ) & " máq. em 3 anos · renovação " & FORMAT ( COALESCE ( [Máq Renovação/Ano], 0 ), "#,0" ) & "/ano"
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: e061baf5-b2b5-4afa-af79-95a88fa0a4cd

	measure 'Rótulo Mercado Máquinas' = "teto ROB × " & FORMAT ( [% ROB Máquinas], "0%" ) & " limita " & FORMAT ( COALESCE ( [Grupos Limitados pelo ROB], 0 ), "#,0" ) & " de " & FORMAT ( COALESCE ( [Grupos c/ Mercado], 0 ), "#,0" ) & " grupos"
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: f53d481d-c9a4-4435-9b48-b62879dbd46f

	measure 'Rótulo Market Share Máquinas' = "fat. máquinas Nissey: R$ " & FORMAT ( COALESCE ( [Fat Máquinas Grupos], 0 ) / 1e6, "#,0.0" ) & " Mi/ano"
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: eaa19776-f605-4763-bb1c-22b95595d55f

	measure 'Rótulo Oportunidade' = "mercado anual ainda não Nissey"
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: e51d6266-b406-4dfa-a2b8-765b9baa4b41

	/// Quadro 'Como calculamos' da aba Potencial de Máquinas, com preços e vida útil da tabela dPremissaMaquina e o % do ROB selecionado. Usar no visual HTML Content.
	measure 'Premissas Potencial Máq HTML' =
			VAR _pct = FORMAT ( [% ROB Máquinas], "0%" )
			-- fontes do % do ROB destinado a máquinas: editar aqui quando confirmadas
			VAR _fontes = "a incluir"
			VAR _chips =
			    CONCATENATEX (
			        dPremissaMaquina,
			        "<span style='display:inline-block;margin:2px 6px 2px 0;padding:2px 8px;border-radius:10px;background:#EEF4EC;color:#2E6A25'><b>" & dPremissaMaquina[produto] & "</b> R$ "
			            & IF ( dPremissaMaquina[produto] = "PL", FORMAT ( dPremissaMaquina[preco_ref] / 1000, "#,0" ) & " mil/linha", FORMAT ( dPremissaMaquina[preco_ref] / 1e6, "#,0.00" ) & " Mi" )
			            & " · " & dPremissaMaquina[vida_util] & " anos</span>",
			        "",
			        LOOKUPVALUE ( dProduto[ordem], dProduto[produto], dPremissaMaquina[produto] ), ASC
			    )
			RETURN
			"<div style='font-family:Segoe UI;font-size:12px;color:#333;line-height:1.45'>"
			& "<div style='font-weight:700;color:#2E6A25;font-size:13px;margin-bottom:4px'>COMO CALCULAMOS</div>"
			& "<b>Necessidade</b> = frota do Sistema de Cobertura pela área do grupo econômico · <b>Share frota</b> = 1 − gap ÷ necessidade (parque JD válido) · "
			& "<b>Renovação/ano</b> = necessidade ÷ vida útil · <b>Mercado R$/ano</b> = menor entre renovação × preço e o teto financeiro (ROB × " & _pct & ") · "
			& "<b>Investimento em máquinas</b> = " & _pct & " do ROB (ajustável no slicer; fontes: " & _fontes & ") · no faturamento Nissey dos clientes, " & FORMAT ( 1 - [% Pós-Vendas no Faturamento], "0%" ) & " é máquinas e " & FORMAT ( [% Pós-Vendas no Faturamento], "0%" ) & " é pós-vendas (peças + serviços) · "
			& "<b>Market share</b> = faturamento anualizado de máquinas ÷ mercado · <b>Vendáveis/ano</b> = renovação ajustada ao teto × (1 − share).<br>"
			& "<span style='color:#6B6B6B'>Preços de referência · vida útil:</span> " & _chips
			& "</div>"
		displayFolder: Segmentação\Potencial de Máquinas\4. Cores e rótulos
		lineageTag: 782e1168-7cd7-4d85-b6dd-3ca4b0070efa

	/// Parque JD válido a preço de referência (inclui PL em linhas). Base do rateio do faturamento de máquinas por produto.
	measure 'Valor Parque JD R$' =
			SUMX (
			    VALUES ( siscobertura_cliente_produto[produto] ),
			    CALCULATE ( SUM ( siscobertura_cliente_produto[parque_valido] ) )
			        * LOOKUPVALUE ( dPremissaMaquina[preco_ref], dPremissaMaquina[produto], siscobertura_cliente_produto[produto] )
			)
		formatString: \R$ #,0,,.00 \M\i
		displayFolder: Segmentação\Potencial de Máquinas\2. Mercado R$
		lineageTag: db0b875e-d8c3-4630-9fdc-a796f2ccb1b4

	/// TRUE quando há filtro de produto (dProduto ou coluna produto da cobertura).
	measure 'Filtro Produto Ativo' = ISFILTERED ( dProduto ) || ISFILTERED ( siscobertura_cliente_produto[produto] )
		isHidden
		displayFolder: Segmentação\Potencial de Máquinas\0. Premissas
		lineageTag: b2605da4-43a8-419f-8b12-5eacc3c40fc0

	/// Fatia dos produtos filtrados no mercado físico (R$) do grupo. 1 sem filtro de produto.
	measure 'Peso Produto Mercado' =
			IF ( [Filtro Produto Ativo],
			    DIVIDE ( [Mercado Máq Físico R$], CALCULATE ( [Mercado Máq Físico R$], REMOVEFILTERS ( dProduto ), REMOVEFILTERS ( siscobertura_cliente_produto[produto] ) ) ),
			    1
			)
		formatString: 0.0%
		isHidden
		displayFolder: Segmentação\Potencial de Máquinas\0. Premissas
		lineageTag: 40da570d-cd0c-4039-8112-9544b66cc325

	/// Rateio do faturamento de máquinas do grupo para os produtos filtrados: fatia no valor do parque JD válido; sem parque JD no grupo, usa a fatia no mercado físico. 1 sem filtro de produto.
	measure 'Peso Produto Faturamento' =
			IF ( [Filtro Produto Ativo],
			    VAR _pqTot = CALCULATE ( [Valor Parque JD R$], REMOVEFILTERS ( dProduto ), REMOVEFILTERS ( siscobertura_cliente_produto[produto] ) )
			    RETURN IF ( _pqTot > 0, DIVIDE ( [Valor Parque JD R$], _pqTot ), [Peso Produto Mercado] ),
			    1
			)
		formatString: 0.0%
		isHidden
		displayFolder: Segmentação\Potencial de Máquinas\0. Premissas
		lineageTag: bbaab1ca-7bf9-4818-832f-b3bf4e5214d2

	/// Cenário de meta de M.S. em uso (padrão Moderado quando nenhum ou vários estão selecionados).
	measure 'Cenário Selecionado' = SELECTEDVALUE ( dCenarioMS[Cenário], "Moderado" )
		displayFolder: Cobertura\4. Indústria e meta\Cenários
		lineageTag: 71bfef2f-65c3-4e1c-94ca-1b0e75c3a0e8

	/// Share de frota JD (parque válido ÷ demanda, limitado a 100%) ponderado pela indústria projetada. Ponto de partida dos cenários.
	measure 'Share Frota (base meta)' =
			DIVIDE (
			    SUMX ( siscobertura_projecao_produto, siscobertura_projecao_produto[industria_cidade] * siscobertura_projecao_produto[share_frota] ),
			    [Indústria Projetada]
			)
		formatString: 0.0%
		displayFolder: Cobertura\4. Indústria e meta\Cenários
		lineageTag: 29237aed-87f3-4e28-8e4f-2d44c6cda5df

	/// Máquinas/ano da meta do cenário = Σ indústria da cidade×produto × meta de M.S. do cenário. Meta = MAX(piso × meta oficial; MIN(share frota + fator × (1 − share frota); MAX(teto; share frota))). Premissas em dCenarioMS.
	measure 'Vendas Cenário' =
			VAR _cen = [Cenário Selecionado]
			VAR _fator = LOOKUPVALUE ( dCenarioMS[Fator Gap], dCenarioMS[Cenário], _cen )
			VAR _piso = LOOKUPVALUE ( dCenarioMS[Piso Meta Oficial], dCenarioMS[Cenário], _cen )
			VAR _teto = LOOKUPVALUE ( dCenarioMS[Teto], dCenarioMS[Cenário], _cen )
			RETURN
			    SUMX (
			        FILTER ( siscobertura_projecao_produto, siscobertura_projecao_produto[industria_cidade] > 0 ),
			        VAR sf = siscobertura_projecao_produto[share_frota]
			        VAR alvo = sf + _fator * ( 1 - sf )
			        VAR meta = MAX ( _piso * siscobertura_projecao_produto[meta_ms], MIN ( alvo, MAX ( _teto, sf ) ) )
			        RETURN siscobertura_projecao_produto[industria_cidade] * meta
			    )
		formatString: #,0
		displayFolder: Cobertura\4. Indústria e meta\Cenários
		lineageTag: 6156fb26-b059-42b2-91e2-e4bec90c991e

	/// Meta de market share do cenário selecionado (ponderada pela indústria).
	measure 'Meta MS Cenário' = DIVIDE ( [Vendas Cenário], [Indústria Projetada] )
		formatString: 0.0%
		displayFolder: Cobertura\4. Indústria e meta\Cenários
		lineageTag: c14552f2-4541-44e7-912c-26012838a88f

	/// Oportunidades a trabalhar no CRM para bater a meta do cenário (vendas ÷ taxa de conversão).
	measure 'Negócios Cenário' =
			VAR _cen = [Cenário Selecionado]
			VAR _fator = LOOKUPVALUE ( dCenarioMS[Fator Gap], dCenarioMS[Cenário], _cen )
			VAR _piso = LOOKUPVALUE ( dCenarioMS[Piso Meta Oficial], dCenarioMS[Cenário], _cen )
			VAR _teto = LOOKUPVALUE ( dCenarioMS[Teto], dCenarioMS[Cenário], _cen )
			RETURN
			    SUMX (
			        FILTER ( siscobertura_projecao_produto, siscobertura_projecao_produto[industria_cidade] > 0 ),
			        VAR sf = siscobertura_projecao_produto[share_frota]
			        VAR alvo = sf + _fator * ( 1 - sf )
			        VAR meta = MAX ( _piso * siscobertura_projecao_produto[meta_ms], MIN ( alvo, MAX ( _teto, sf ) ) )
			        RETURN DIVIDE ( siscobertura_projecao_produto[industria_cidade] * meta, siscobertura_projecao_produto[taxa_conversao], 0 )
			    )
		formatString: #,0
		displayFolder: Cobertura\4. Indústria e meta\Cenários
		lineageTag: 591540a9-80d9-4580-83a9-118d73a2a3ee

	/// Máquinas/ano a mais do que o ganho no FY para chegar à meta do cenário.
	measure 'Vendas Adicionais Cenário' = MAX ( 0, [Vendas Cenário] - [Ganhas FY (base M.S.)] )
