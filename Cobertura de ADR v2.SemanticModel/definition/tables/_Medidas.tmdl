	/// Ganhas no FY. Filtro/linha de CEN (siscobertura_cidade[cen_agricola]) usa o CEN dono da oportunidade no CRM, não o CEN da cidade.
	measure 'CRM Ganhas FY' =
			VAR _cens = VALUES ( siscobertura_cidade[cen_agricola] )
			RETURN
			    IF (
			        ISFILTERED ( siscobertura_cidade[cen_agricola] ),
			        CALCULATE (
			            SUM ( siscobertura_crm_cen[crm_ganhas_fy] ),
			            REMOVEFILTERS ( siscobertura_cidade[cen_agricola] ),
			            KEEPFILTERS ( TREATAS ( _cens, siscobertura_crm_cen[cen] ) )
			        ),
			        SUM ( siscobertura_crm_cen[crm_ganhas_fy] )
			    )
		formatString: #,0
		displayFolder: Cobertura\1. Base
		lineageTag: 1409482c-abbf-4025-900b-cdf89cfdd552

	/// Oportunidades abertas. Filtro/linha de CEN usa o CEN dono da oportunidade no CRM, não o CEN da cidade.
	measure 'CRM Abertas' =
			VAR _cens = VALUES ( siscobertura_cidade[cen_agricola] )
			RETURN
			    IF (
			        ISFILTERED ( siscobertura_cidade[cen_agricola] ),
			        CALCULATE (
			            SUM ( siscobertura_crm_cen[crm_abertas] ),
			            REMOVEFILTERS ( siscobertura_cidade[cen_agricola] ),
			            KEEPFILTERS ( TREATAS ( _cens, siscobertura_crm_cen[cen] ) )
			        ),
			        SUM ( siscobertura_crm_cen[crm_abertas] )
			    )
		formatString: #,0
		displayFolder: Cobertura\1. Base
		lineageTag: e80c0b63-2869-4b8a-9eba-5dc9f7c2fe16

