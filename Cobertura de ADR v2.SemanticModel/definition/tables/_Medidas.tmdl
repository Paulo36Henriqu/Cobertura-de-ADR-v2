	measure 'CI Txt Δ Preço' = VAR d = [CI Δ Preço Mediano] RETURN IF ( ISBLANK ( d ), "—", "JD " & FORMAT ( d, "+0%;-0%;0%" ) )
		displayFolder: Inteligência Competitiva\8. Cards
