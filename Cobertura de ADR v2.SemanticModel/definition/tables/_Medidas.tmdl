	measure 'CI Sub Sem Concorrente' =
			VAR p = [CI % P+C sem Concorrente]
			VAR st = SWITCH ( TRUE (), ISBLANK ( p ), "", p > 0.70, "Crítico · ", p > 0.40, "Atenção · ", "Bom · " )
			RETURN st & FORMAT ( [CI Perdidas + Canceladas] - [CI P+C c/ Concorrente], "#,0" ) & " de " & FORMAT ( [CI Perdidas + Canceladas] + 0, "#,0" ) & " · mapa de concorrente parcial"
