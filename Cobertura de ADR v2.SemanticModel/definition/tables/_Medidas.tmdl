	/// Estilo comum dos quadros HTML do Cliente 360.
	measure 'C360 CSS' =
			"<style>"
			    & "html,body{margin:0}"
			    & ".c3{font-family:Segoe UI,Arial,sans-serif;color:#222;padding:0 8px 6px;font-size:13px;box-sizing:border-box}"
			    & ".c3 .hd{display:flex;flex-wrap:wrap;gap:4px 18px;font-size:13px;color:#555;margin:2px 0 8px}"
			    & ".c3 .hd b{color:#222;font-size:15px}"
			    & ".c3 table{width:100%;border-collapse:collapse}"
			    & ".c3 th{font-size:11px;color:#666;font-weight:600;text-align:left;padding:4px 6px;border-bottom:2px solid #2E6A25;white-space:nowrap;text-transform:uppercase;letter-spacing:.3px}"
			    & ".c3 td{padding:5px 6px;border-bottom:1px solid #eee;vertical-align:top}"
			    & ".c3 .r{text-align:right;white-space:nowrap}"
			    & ".c3 .nw{white-space:nowrap}"
			    & ".c3 .b{font-weight:600}"
			    & ".c3 .s{font-size:11px;color:#777;margin-top:1px}"
			    & ".c3 .pl{display:inline-block;padding:1px 8px;border-radius:10px;font-size:11px;font-weight:600;white-space:nowrap}"
			    & ".c3 .d{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px;vertical-align:middle}"
			    & ".c3 .sec{font-size:12px;font-weight:700;color:#2E6A25;margin:14px 0 4px;text-transform:uppercase;letter-spacing:.5px}"
			    & ".c3 .sec.f{margin-top:2px}"
			    & ".c3 .g2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}"
			    & ".c3 .g4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}"
			    & ".c3 .cd{border:1px solid #e3e3e3;border-left:5px solid #2E6A25;border-radius:6px;padding:8px 12px;min-width:0}"
			    & ".c3 .cd .t{font-weight:700;font-size:14px;margin-bottom:4px}"
			    & ".c3 .cd .x{font-size:13px;color:#333;line-height:18px}"
			    & ".c3 .ct{border-bottom:1px solid #eee;padding:7px 0}"
			    & ".c3 .ct .n{font-weight:600;font-size:14px}"
			    & ".c3 .ct .i{font-size:13px;color:#333;margin-top:2px}"
			    & ".c3 .vz{font-size:15px;color:#666;padding:30px 0;text-align:center}"
			    & ".c3 .mt{font-size:12px;color:#888;padding:6px 0}"
			    & "</style>"
		isHidden
		displayFolder: Cliente 360\0. Apoio
		lineageTag: 187bf2ff-62e6-4f22-9e44-84276423d365

	/// Máquinas no parque do cliente (ERP, todas as marcas).
