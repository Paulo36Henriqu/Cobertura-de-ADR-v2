	/// Demanda em máquinas. PL (em linhas) só entra quando o contexto é apenas PL, para não misturar linhas com máquinas no total.
	measure Demanda =
			IF (
			    SELECTEDVALUE ( dProduto[produto] ) = "PL",
			    SUM ( siscobertura_cidade_produto[demanda] ),
			    CALCULATE ( SUM ( siscobertura_cidade_produto[demanda] ), KEEPFILTERS ( dProduto[produto] <> "PL" ) )
