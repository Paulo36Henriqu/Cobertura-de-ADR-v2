	measure 'CI Sub Filial Top' =
			VAR f = [CI Filial Top]
			VAR p = CALCULATE ( [CI Perdidas], ci_oportunidades[filial] = f ) + 0
			VAR c = CALCULATE ( [CI Canceladas], ci_oportunidades[filial] = f ) + 0
			RETURN IF ( ISBLANK ( f ), "", FORMAT ( p + c, "#,0" ) & " negócios (" & FORMAT ( p, "#,0" ) & " perdidas · " & FORMAT ( c, "#,0" ) & " canceladas)" )
		displayFolder: Inteligência Competitiva\8. Cards
