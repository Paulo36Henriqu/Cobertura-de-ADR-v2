	measure 'CI Ganhas c/ Concorrente' = CALCULATE ( [CI Ganhas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[concorrente] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: 777832fd-3c71-43a7-a473-5559e5b89b2a

	measure 'CI Perdidas c/ Concorrente' = CALCULATE ( [CI Perdidas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[concorrente] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: e1242df4-f295-4537-a4d7-372ef354ef7b

	measure 'CI Canceladas c/ Concorrente' = CALCULATE ( [CI Canceladas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[concorrente] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: 7d17a469-56c5-4734-8b53-4820c2a17c42

	measure 'CI P+C c/ Concorrente' = CALCULATE ( [CI Perdidas + Canceladas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[concorrente] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: ff4ab2dd-210c-4a0e-ba0c-1ce01ed87806

	/// Encerradas (ganha/perdida/cancelada) com concorrente identificado.
	measure 'CI Disputas c/ Concorrente' = CALCULATE ( [CI Encerradas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[concorrente] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: b6ef537b-6aad-46e9-bf3a-0a747ecee9ca

	measure 'CI % P+C c/ Concorrente' = DIVIDE ( [CI P+C c/ Concorrente], [CI Perdidas + Canceladas] )
		formatString: 0.0%
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: ceea8270-c311-4908-9d8f-5fe78b54e262

	measure 'CI % P+C sem Concorrente' = IF ( [CI Perdidas + Canceladas] > 0, 1 - [CI % P+C c/ Concorrente] )
		formatString: 0.0%
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: 807b909d-9b2a-48c8-95ae-8d8c971d242d

	/// Ganhas / (ganhas + perdidas) nos negócios com concorrente identificado.
	measure 'CI Vitória Confronto %' = DIVIDE ( [CI Ganhas c/ Concorrente], [CI Ganhas c/ Concorrente] + [CI Perdidas c/ Concorrente] )
		formatString: 0.0%
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: ce02fed0-0587-4da4-8ced-cf439d8dd8dc

	measure 'CI Concorrentes Distintos' = CALCULATE ( DISTINCTCOUNT ( ci_oportunidades[concorrente] ), KEEPFILTERS ( ci_oportunidades[resultado] IN { "Ganha", "Perdida", "Cancelada" } ), KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[concorrente] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: 4c697748-57a0-4ad7-b528-f35c44764b0d

	/// Concorrente com mais perdidas + canceladas no contexto.
	measure 'CI Concorrente Nº1' =
			VAR _t =
			    TOPN (
			        1,
			        FILTER ( VALUES ( ci_oportunidades[concorrente] ), NOT ISBLANK ( ci_oportunidades[concorrente] ) && [CI P+C c/ Concorrente] > 0 ),
			        [CI P+C c/ Concorrente], DESC,
			        ci_oportunidades[concorrente], ASC
			    )
			RETURN MAXX ( _t, ci_oportunidades[concorrente] )
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: d28d673d-66d9-4c43-8cec-416ccf3c4a23

	/// Concorrente nº 1 ou 'Não informado' (mapa e tabelas).
	measure 'CI Concorrente Principal' = IF ( [CI Perdidas + Canceladas] > 0, COALESCE ( [CI Concorrente Nº1], "Não informado" ) )
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: cbc3fa25-1393-444a-bbd8-16ea7167054e

	measure 'CI Cor Concorrente' =
			SWITCH (
			    [CI Concorrente Principal],
			    "Massey Ferguson", "#C0392B",
			    "Case IH", "#7B1E1E",
			    "Case", "#7B1E1E",
			    "John Deere A&T", "#C9A227",
			    "New Holland", "#5DA5DA",
			    "Valtra", "#2B4C9B",
			    "Stara", "#E67E22",
			    "Caterpillar", "#D4A017",
			    "Komatsu", "#1F5FAD",
			    "Volvo", "#1B2A4A",
			    "JCB", "#E67E22",
			    "Não informado", "#E3E3E3",
			    "#95A5A6"
			)
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 30bc4464-250f-4bfa-a3fa-05463ef12dc2

	/// Perdidas + canceladas apenas para os 5 maiores concorrentes do período selecionado (gráfico de tendência).
	measure 'CI P+C Top 5 Concorrentes' =
			VAR _c = SELECTEDVALUE ( ci_oportunidades[concorrente] )
			VAR _top =
			    TOPN (
			        5,
			        FILTER ( ALLSELECTED ( ci_oportunidades[concorrente] ), NOT ISBLANK ( ci_oportunidades[concorrente] ) ),
			        CALCULATE ( [CI P+C c/ Concorrente], ALLSELECTED ( ci_oportunidades[mes_label], ci_oportunidades[mes] ) ), DESC
			    )
			RETURN IF ( NOT ISBLANK ( _c ) && _c IN _top, [CI P+C c/ Concorrente] + 0 )
		formatString: #,0
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: 455025f1-7539-4383-803b-ac9c138f683c

	measure 'CI % Perdidas c/ Concorrente desde set/26' = CALCULATE ( DIVIDE ( [CI Perdidas c/ Concorrente], [CI Perdidas] ), KEEPFILTERS ( ci_oportunidades[data_ref] >= DATE ( 2026, 9, 1 ) ) )
		formatString: 0%
		displayFolder: Inteligência Competitiva\2. Concorrência
		lineageTag: 22cc20ff-81fe-4876-8e46-f6771ffef700

	measure 'CI Perdidas c/ Motivo' = CALCULATE ( [CI Perdidas], KEEPFILTERS ( ci_oportunidades[motivo_perda] <> "(Sem motivo)" ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: 72a0913c-edf5-425d-bfbd-b412c8cd1898

	measure 'CI % Perdidas c/ Motivo' = DIVIDE ( [CI Perdidas c/ Motivo], [CI Perdidas] )
		formatString: 0.0%
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: c72231ff-86db-4496-9595-5442cd3d7e27

	measure 'CI Canceladas c/ Motivo' = CALCULATE ( [CI Canceladas], KEEPFILTERS ( ci_oportunidades[motivo_cancelamento] <> "(Sem motivo)" ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: 1d1025e9-1e52-4fab-b6c0-6d415774fa43

	measure 'CI % Canceladas c/ Motivo' = DIVIDE ( [CI Canceladas c/ Motivo], [CI Canceladas] )
		formatString: 0.0%
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: bf07dd6c-63f3-4c85-b6e2-5b70c8707483

	/// Perdidas + canceladas com motivo preenchido / perdidas + canceladas.
	measure 'CI % c/ Motivo (P+C)' = DIVIDE ( [CI Perdidas c/ Motivo] + [CI Canceladas c/ Motivo], [CI Perdidas + Canceladas] )
		formatString: 0%
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: 8d391f3a-17b2-46c1-8eb6-5edbf43efad2

	measure 'CI Motivo Nº1 Perda' =
			MAXX (
			    TOPN (
			        1,
			        FILTER ( VALUES ( ci_motivo_perda[motivo] ), ci_motivo_perda[motivo] <> "(Sem motivo)" && [CI Perdidas] > 0 ),
			        [CI Perdidas], DESC, ci_motivo_perda[motivo], ASC
			    ),
			    ci_motivo_perda[motivo]
			)
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: 2d7ab43c-7fa1-441c-bada-ee95b408555c

	/// Motivo de perda mais frequente, ignorando 'Outros' e '(Sem motivo)'.
	measure 'CI Motivo Nº1 Identificável' =
			MAXX (
			    TOPN (
			        1,
			        FILTER ( VALUES ( ci_motivo_perda[motivo] ), NOT ci_motivo_perda[motivo] IN { "(Sem motivo)", "Outros" } && [CI Perdidas] > 0 ),
			        [CI Perdidas], DESC, ci_motivo_perda[motivo], ASC
			    ),
			    ci_motivo_perda[motivo]
			)
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: 97892f49-cd5b-4806-a088-82edb091bb8d

	measure 'CI Pareto % Acumulado' =
			VAR _cur = [CI Perdidas]
			VAR _nm = SELECTEDVALUE ( ci_motivo_perda[motivo] )
			VAR _tb = ADDCOLUMNS ( ALLSELECTED ( ci_motivo_perda ), "@v", [CI Perdidas] )
			VAR _tot = SUMX ( _tb, [@v] )
			VAR _acc = SUMX ( FILTER ( _tb, [@v] > _cur || ( [@v] = _cur && ci_motivo_perda[motivo] <= _nm ) ), [@v] )
			RETURN IF ( NOT ISBLANK ( _cur ), DIVIDE ( _acc, _tot ) )
		formatString: 0%
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: 7857b12f-3da7-4cc0-8662-491d60f88881

	measure 'CI Filial Principal (Canceladas)' = MAXX ( TOPN ( 1, FILTER ( VALUES ( ci_oportunidades[filial] ), [CI Canceladas] > 0 ), [CI Canceladas], DESC, ci_oportunidades[filial], ASC ), ci_oportunidades[filial] )
		displayFolder: Inteligência Competitiva\3. Motivos
		lineageTag: fbd21139-2de2-4839-ac1e-11c6dae1c2ae

	/// Sigla da filial com mais negócios encerrados no contexto.
	measure 'CI Filial Principal' = MAXX ( TOPN ( 1, FILTER ( VALUES ( ci_oportunidades[filial_sigla] ), [CI Encerradas] > 0 ), [CI Encerradas], DESC, ci_oportunidades[filial_sigla], ASC ), ci_oportunidades[filial_sigla] )
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: 0d38cd90-b7dd-46f8-bf5d-acaf876571ce

	measure 'CI Município Top' = MAXX ( TOPN ( 1, FILTER ( VALUES ( ci_oportunidades[cidade] ), NOT ISBLANK ( ci_oportunidades[cidade] ) && [CI Perdidas + Canceladas] > 0 ), [CI Perdidas + Canceladas], DESC, ci_oportunidades[cidade], ASC ), ci_oportunidades[cidade] )
		displayFolder: Inteligência Competitiva\4. Onde perdemos
		lineageTag: acfced2c-a728-4c43-b1cb-fd2bd0bcef1c

	measure 'CI Filial Top' = MAXX ( TOPN ( 1, FILTER ( VALUES ( ci_oportunidades[filial] ), [CI Perdidas + Canceladas] > 0 ), [CI Perdidas + Canceladas], DESC, ci_oportunidades[filial], ASC ), ci_oportunidades[filial] )
		displayFolder: Inteligência Competitiva\4. Onde perdemos
		lineageTag: cc345127-2ab1-450c-8e56-8d63b88f9971

	measure 'CI Municípios c/ P+C' = COUNTROWS ( FILTER ( VALUES ( ci_oportunidades[id_ibge] ), NOT ISBLANK ( ci_oportunidades[id_ibge] ) && [CI Perdidas + Canceladas] > 0 ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\4. Onde perdemos
		lineageTag: 0650cbef-dcd1-42c3-8536-3bf5d2243680

	/// Encerradas com preço do concorrente válido (> R$ 1.000 e razão 0,4×–2,5×).
	measure 'CI Negócios c/ Preço' = CALCULATE ( [CI Encerradas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
