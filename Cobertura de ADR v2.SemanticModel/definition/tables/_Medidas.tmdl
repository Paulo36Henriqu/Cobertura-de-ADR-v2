	measure 'CI Ganhas c/ Preço' = CALCULATE ( [CI Ganhas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\5. Preço
