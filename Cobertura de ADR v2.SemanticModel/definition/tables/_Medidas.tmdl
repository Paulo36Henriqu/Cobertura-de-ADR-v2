	measure 'CI Sub Perdidas c/ Motivo' =
			VAR p = [CI % Perdidas c/ Motivo]
			VAR st = SWITCH ( TRUE (), ISBLANK ( p ), "", p < 0.50, "Crítico · ", p < 0.80, "Atenção · ", "Bom · " )
			RETURN st & FORMAT ( [CI Perdidas c/ Motivo] + 0, "#,0" ) & " de " & FORMAT ( [CI Perdidas] + 0, "#,0" ) & " perdidas"
