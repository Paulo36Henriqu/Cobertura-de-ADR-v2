	measure 'CI Perdidas c/ Preço' = CALCULATE ( [CI Perdidas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: 04e495d4-5b2a-46ee-af13-72026ed75846

	measure 'CI Canceladas c/ Preço' = CALCULATE ( [CI Canceladas], KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: cda4689b-33f1-49cc-9120-dc27462f006b

	measure 'CI Preço JD' = CALCULATE ( AVERAGE ( ci_oportunidades[preco_unitario] ), KEEPFILTERS ( ci_oportunidades[resultado] IN { "Ganha", "Perdida", "Cancelada" } ), KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
		formatString: "R$" #,0
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: 8498f3fd-6c5a-4f8e-a284-fddadbfaac7f

	measure 'CI Preço Concorrente' = CALCULATE ( AVERAGE ( ci_oportunidades[preco_concorrente] ), KEEPFILTERS ( ci_oportunidades[resultado] IN { "Ganha", "Perdida", "Cancelada" } ), KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
		formatString: "R$" #,0
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: d4501569-e098-48c7-8d34-f06da4422d25

	/// Preço JD médio / preço do concorrente médio - 1 (positivo = JD mais caro).
	measure 'CI Δ Preço %' = IF ( NOT ISBLANK ( [CI Preço Concorrente] ), DIVIDE ( [CI Preço JD], [CI Preço Concorrente] ) - 1 )
		formatString: +0%;-0%;0%
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: 6adb333e-c8f3-43e4-b233-ca3a74636589

	measure 'CI Δ Preço Mediano' =
			VAR _t = CALCULATETABLE ( ci_oportunidades, KEEPFILTERS ( ci_oportunidades[resultado] IN { "Ganha", "Perdida", "Cancelada" } ), KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
			RETURN MEDIANX ( _t, ci_oportunidades[delta_preco] )
		formatString: +0%;-0%;0%
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: 84e5842c-6f5e-4bda-894f-933047fccfad

	measure 'CI Perdas por Preço' = CALCULATE ( [CI Perdidas], KEEPFILTERS ( ci_oportunidades[motivo_perda] = "Preço" ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: 9232ab36-3968-4ef5-a3b2-229b6f437db6

	/// Eixo Y do gráfico de dispersão (um ponto por oportunidade).
	measure 'CI Preço JD (ponto)' = [CI Preço JD]
		formatString: "R$" #,0
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: 188cddfd-a9c1-4035-806d-d19a40858b73

	/// Eixo X do gráfico de dispersão (um ponto por oportunidade).
	measure 'CI Preço Concorrente (ponto)' = [CI Preço Concorrente]
		formatString: "R$" #,0
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: 245f56b0-201c-4642-a7ba-d08e0138d097

	measure 'CI Cor Conversão' =
			VAR p = [CI Conversão %]
			RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#FFFFFF", p < 0.30, "#C0392B", p < 0.34, "#E67E22", p < 0.38, "#A4C639", "#2E7D32" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 5c79ef0c-1bf4-48b2-8068-1541f57d7595

	measure 'CI Cor Vitória' =
			VAR p = [CI Vitória Confronto %]
			RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#FFFFFF", p < 0.15, "#C0392B", p < 0.30, "#E67E22", p < 0.40, "#A4C639", "#2E7D32" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: f713e996-7a54-4f28-bb24-35d4bb707d03

	measure 'CI Cor % c/ Motivo' =
			VAR p = [CI % c/ Motivo (P+C)]
			RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#FFFFFF", p < 0.30, "#C0392B", p < 0.50, "#E67E22", p < 0.75, "#A4C639", "#2E7D32" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 940f015b-176f-4807-b820-f5b7f78feee9

	measure 'CI Cor % c/ Concorrente' =
			VAR p = [CI % P+C c/ Concorrente]
			RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#FFFFFF", p < 0.30, "#C0392B", p < 0.50, "#E67E22", p < 0.75, "#A4C639", "#2E7D32" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 34abc8e5-5b3a-447f-98bd-787fbcba378e

	measure 'CI Cor Motivo Perda' = SWITCH ( SELECTEDVALUE ( ci_motivo_perda[motivo] ), "Outros", "#E67E22", "(Sem motivo)", "#7F8C8D", "#C0392B" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: bc3e8117-8323-4959-bc77-92177ae77ed2

	measure 'CI Cor Motivo Cancelamento' = IF ( SELECTEDVALUE ( ci_motivo_cancelamento[motivo] ) = "(Sem motivo)", "#7F8C8D", "#C0392B" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: df8c4286-874b-49a3-8306-b610ea9cbaa3

	/// Barras de Δ de preço: ≥ 15% vermelho, > 0 laranja, ≤ 0 verde.
	measure 'CI Cor Δ Preço' =
			VAR d = [CI Δ Preço Mediano]
			RETURN SWITCH ( TRUE (), ISBLANK ( d ), "#BDBDBD", d >= 0.15, "#C0392B", d > 0, "#E67E22", "#2E7D32" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 75c17bb7-ef8b-4a99-80b0-ea54d6753d77

	measure 'CI Fundo Δ Preço' = IF ( [CI Δ Preço %] >= 0.15, "#C0392B", "#FFFFFF" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: cdc56e8d-62de-409e-ba07-136d6d3a67de

	measure 'CI Fonte Δ Preço' =
			VAR d = [CI Δ Preço %]
			RETURN SWITCH ( TRUE (), d >= 0.15, "#FFFFFF", d > 0, "#C0392B", "#2E7D32" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 966c8b04-cbb4-4c28-afea-7c726eac05b0

	measure 'CI Cor Resultado (ponto)' = SWITCH ( SELECTEDVALUE ( ci_oportunidades[resultado] ), "Ganha", "#2E7D32", "Perdida", "#C0392B", "Cancelada", "#7F8C8D", "#A4C639" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: b65dd13c-bdc1-4228-94db-64dc8719e310

	measure 'CI Heat Conc × Produto' =
			VAR v = [CI P+C c/ Concorrente]
			VAR mx = MAXX ( CROSSJOIN ( ALLSELECTED ( ci_oportunidades[concorrente] ), ALLSELECTED ( ci_oportunidades[produto] ) ), [CI P+C c/ Concorrente] )
			VAR r = DIVIDE ( v, mx )
			RETURN SWITCH ( TRUE (), NOT ( ISINSCOPE ( ci_oportunidades[concorrente] ) && ISINSCOPE ( ci_oportunidades[produto] ) ), "#FFFFFF", ISBLANK ( v ), "#FAFAFA", r <= 0.25, "#F6DCD8", r <= 0.5, "#EBB0A8", r <= 0.75, "#D9786C", "#C0392B" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: f93b0a6e-2cbd-484b-be95-1befeff68877

	measure 'CI Heat Filial × Conc' =
			VAR v = [CI P+C c/ Concorrente]
			VAR mx = MAXX ( CROSSJOIN ( ALLSELECTED ( ci_oportunidades[filial_sigla] ), ALLSELECTED ( ci_oportunidades[concorrente] ) ), [CI P+C c/ Concorrente] )
			VAR r = DIVIDE ( v, mx )
			RETURN SWITCH ( TRUE (), NOT ( ISINSCOPE ( ci_oportunidades[filial_sigla] ) && ISINSCOPE ( ci_oportunidades[concorrente] ) ), "#FFFFFF", ISBLANK ( v ), "#FAFAFA", r <= 0.25, "#F6DCD8", r <= 0.5, "#EBB0A8", r <= 0.75, "#D9786C", "#C0392B" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: ab005db3-94f8-4dfd-b7b9-68721d1e0809

	measure 'CI Heat Motivo × Produto' =
			VAR v = [CI Perdidas]
			VAR mx = MAXX ( CROSSJOIN ( ALLSELECTED ( ci_motivo_perda[motivo] ), ALLSELECTED ( ci_oportunidades[produto] ) ), [CI Perdidas] )
			VAR r = DIVIDE ( v, mx )
			RETURN SWITCH ( TRUE (), NOT ( ISINSCOPE ( ci_motivo_perda[motivo] ) && ISINSCOPE ( ci_oportunidades[produto] ) ), "#FFFFFF", ISBLANK ( v ), "#FAFAFA", r <= 0.25, "#F6DCD8", r <= 0.5, "#EBB0A8", r <= 0.75, "#D9786C", "#C0392B" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 1b47a4f1-0ee5-4638-9b2b-8e825dec781c

	measure 'CI Heat Fonte Conc × Produto' =
			VAR mx = MAXX ( CROSSJOIN ( ALLSELECTED ( ci_oportunidades[concorrente] ), ALLSELECTED ( ci_oportunidades[produto] ) ), [CI P+C c/ Concorrente] )
			RETURN IF ( ISINSCOPE ( ci_oportunidades[concorrente] ) && ISINSCOPE ( ci_oportunidades[produto] ) && DIVIDE ( [CI P+C c/ Concorrente], mx ) > 0.5, "#FFFFFF", "#222222" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 0d00e814-b7d3-42f6-bf3c-0bd5f11ccd23

	measure 'CI Heat Fonte Filial × Conc' =
			VAR mx = MAXX ( CROSSJOIN ( ALLSELECTED ( ci_oportunidades[filial_sigla] ), ALLSELECTED ( ci_oportunidades[concorrente] ) ), [CI P+C c/ Concorrente] )
			RETURN IF ( ISINSCOPE ( ci_oportunidades[filial_sigla] ) && ISINSCOPE ( ci_oportunidades[concorrente] ) && DIVIDE ( [CI P+C c/ Concorrente], mx ) > 0.5, "#FFFFFF", "#222222" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 1ff12e79-b221-4299-855c-f7ddbcd20be8

	measure 'CI Heat Fonte Motivo × Produto' =
			VAR mx = MAXX ( CROSSJOIN ( ALLSELECTED ( ci_motivo_perda[motivo] ), ALLSELECTED ( ci_oportunidades[produto] ) ), [CI Perdidas] )
			RETURN IF ( ISINSCOPE ( ci_motivo_perda[motivo] ) && ISINSCOPE ( ci_oportunidades[produto] ) && DIVIDE ( [CI Perdidas], mx ) > 0.5, "#FFFFFF", "#222222" )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: 4c700829-6f6e-4c40-ad0e-c73e35efe4ac

	measure 'CI Linha' = CONCATENATEX ( VALUES ( ci_oportunidades[linha] ), ci_oportunidades[linha], "+", ci_oportunidades[linha], ASC )
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: 58d69228-baa6-4f01-a870-f41ccf4f6bc0

	measure 'CI Rótulo Período' =
			VAR f = SELECTEDVALUE ( ci_oportunidades[fy] )
			VAR y = VALUE ( RIGHT ( f, 2 ) )
			RETURN
			    IF ( ISBLANK ( f ), "todos os FY", f & " (nov/" & FORMAT ( y - 1, "00" ) & "–out/" & FORMAT ( y, "00" ) & ")" )
			        & " · linha " & [CI Linha]
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: 90ef46f5-ff7b-425f-9162-6db277a5dc78

	measure 'CI Referência' = "Linha " & [CI Linha] & " · Referência: " & FORMAT ( TODAY (), "dd/mm/yyyy" )
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: 60479875-f047-4372-b3ee-bf68475c7473

	measure 'CI Insight Visão Geral' =
			VAR p = [CI Perdidas] + 0
			VAR c = [CI Canceladas] + 0
			VAR _min = TOPN ( 1, FILTER ( VALUES ( ci_oportunidades[produto] ), [CI Encerradas] >= 10 ), COALESCE ( [CI Conversão %], 0 ), ASC, ci_oportunidades[produto], ASC )
			VAR pn = MAXX ( _min, ci_oportunidades[produto] )
			VAR pc = MAXX ( _min, COALESCE ( [CI Conversão %], 0 ) )
			RETURN
			    "<style>html,body{margin:0;overflow:hidden}</style><div style='font-family:Segoe UI,Arial,sans-serif;font-size:14px;line-height:20px;color:#333;background:#FDF2F1;border:1px solid #C0392B;border-radius:4px;padding:8px 12px'>"
			        & "<b style='color:#C0392B'>" & IF ( p >= c, "A perda", "O cancelamento" ) & " é o principal desfecho negativo em " & [CI Linha] & ":</b> "
			        & FORMAT ( p, "#,0" ) & " perdidas (" & FORMAT ( [CI % Perdidas], "0.0%" ) & ") × " & FORMAT ( c, "#,0" ) & " canceladas (" & FORMAT ( [CI % Canceladas], "0.0%" ) & ")."
			        & IF ( NOT ISBLANK ( pn ), "<br>" & pn & " tem a menor conversão (" & FORMAT ( pc, "0.0%" ) & ")." )
			        & "</div>"
		displayFolder: Inteligência Competitiva\8. HTML
		lineageTag: a172a26c-13f7-4f69-a13d-adca6c7a3eac

	measure 'CI Insight Perdas' =
			VAR m = [CI Motivo Nº1 Identificável]
			VAR mq = CALCULATE ( [CI Perdidas], ci_motivo_perda[motivo] = m )
			VAR _tp = CALCULATETABLE ( TOPN ( 1, FILTER ( VALUES ( ci_oportunidades[produto] ), [CI Perdidas] > 0 ), [CI Perdidas], DESC, ci_oportunidades[produto], ASC ), ci_motivo_perda[motivo] = m )
			VAR tpn = MAXX ( _tp, ci_oportunidades[produto] )
			VAR tpq = CALCULATE ( [CI Perdidas], ci_motivo_perda[motivo] = m, ci_oportunidades[produto] = tpn )
			VAR sm = CALCULATE ( [CI Perdidas], ci_motivo_perda[motivo] = "(Sem motivo)" ) + 0
			VAR o = CALCULATE ( [CI Perdidas], ci_motivo_perda[motivo] = "Outros" ) + 0
			VAR cm = [CI Perdidas c/ Motivo] + 0
			VAR box = "<div style='font-family:Segoe UI,Arial,sans-serif;font-size:13px;line-height:18px;color:#333;border-radius:4px;padding:7px 11px;margin-bottom:8px;"
			RETURN
			    "<style>html,body{margin:0;overflow:hidden}</style>"
			        & IF ( NOT ISBLANK ( m ), box & "background:#FDF2F1;border:1px solid #C0392B'><b style='color:#C0392B'>" & m & "</b> é o 1º motivo identificável (" & FORMAT ( mq, "#,0" ) & ")" & IF ( NOT ISBLANK ( tpn ), " e se concentra em " & tpn & " (" & FORMAT ( tpq, "#,0" ) & ")" ) & ". " & FORMAT ( sm, "#,0" ) & " perdidas seguem sem motivo.</div>" )
			        & IF ( o > 0, box & "background:#FEF5EC;border:1px solid #E67E22'><b style='color:#E67E22'>“Outros”</b> responde por " & FORMAT ( o, "#,0" ) & " de " & FORMAT ( cm, "#,0" ) & " perdas com motivo (" & FORMAT ( DIVIDE ( o, cm ), "0%" ) & "). Revisar a lista de motivos com o comercial.</div>" )
		displayFolder: Inteligência Competitiva\8. HTML
		lineageTag: ee24939c-3df9-48ae-8312-e2ec9258e145

	measure 'CI Alerta Cancelamento' =
			VAR q = [CI Canceladas c/ Concorrente] + 0
			VAR _top = TOPN ( 2, FILTER ( VALUES ( ci_oportunidades[concorrente] ), NOT ISBLANK ( ci_oportunidades[concorrente] ) && [CI Canceladas c/ Concorrente] > 0 ), [CI Canceladas c/ Concorrente], DESC, ci_oportunidades[concorrente], ASC )
			VAR lst = CONCATENATEX ( _top, ci_oportunidades[concorrente] & " " & FORMAT ( [CI Canceladas c/ Concorrente], "#,0" ), ", ", [CI Canceladas c/ Concorrente], DESC )
			RETURN
			    "<style>html,body{margin:0;overflow:hidden}</style><div style='font-family:Segoe UI,Arial,sans-serif;font-size:13px;line-height:18px;color:#333;background:#FFF4CC;border:1px solid #FFDE00;border-radius:4px;padding:8px 12px'>⚠️ O motivo de cancelamento passou a existir no CRM em <b>09/10/2026</b>. As canceladas anteriores não têm motivo"
			        & IF ( q = 0, ", e <b>nenhuma</b> cancelada " & [CI Linha] & " tem concorrente informado.", "; <b>" & FORMAT ( q, "#,0" ) & "</b> delas têm concorrente informado (" & lst & ")." )
			        & "</div>"
		displayFolder: Inteligência Competitiva\8. HTML
		lineageTag: acec8813-f14a-4176-a4ab-2a56dff4ef09

	measure 'CI Legenda Mapa' =
			VAR _top = TOPN ( 7, FILTER ( VALUES ( ci_oportunidades[concorrente] ), NOT ISBLANK ( ci_oportunidades[concorrente] ) && [CI P+C c/ Concorrente] > 0 ), [CI P+C c/ Concorrente], DESC, ci_oportunidades[concorrente], ASC )
			VAR it = "<div style='display:flex;align-items:center;gap:6px;white-space:nowrap'><span style='width:12px;height:12px;border-radius:50%;background:{c};display:inline-block;border:1px solid #999'></span>{n}</div>"
			RETURN
			    "<style>html,body{margin:0;overflow:hidden}</style><div style='font-family:Segoe UI,Arial,sans-serif;font-size:12px;color:#222;background:rgba(255,255,255,0.92);border-radius:4px;padding:6px 10px'><b>Concorrente principal</b><div style='display:grid;grid-template-columns:1fr 1fr;gap:3px 14px;margin-top:4px'>"
			        & CONCATENATEX ( _top, SUBSTITUTE ( SUBSTITUTE ( it, "{c}", [CI Cor Concorrente] ), "{n}", SUBSTITUTE ( ci_oportunidades[concorrente], "&", "&amp;" ) ), "", [CI P+C c/ Concorrente], DESC )
			        & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#95A5A6" ), "{n}", "Outros" )
			        & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#E3E3E3" ), "{n}", "Não informado" )
			        & "</div></div>"
		displayFolder: Inteligência Competitiva\8. HTML
		lineageTag: a5418ae1-a9d9-42bf-8479-82e4e0840605

	measure 'CI Legenda Conversão' =
			VAR it = "<span style='display:inline-flex;align-items:center;gap:4px;margin-right:12px'><span style='width:11px;height:11px;background:{c};display:inline-block'></span>{n}</span>"
			RETURN "<style>html,body{margin:0;overflow:hidden}</style><div style='font-family:Segoe UI,Arial,sans-serif;font-size:12px;color:#444;padding:2px 6px'>Conversão:  "
			    & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#C0392B" ), "{n}", "&lt; 30%" )
			    & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#E67E22" ), "{n}", "30–34%" )
			    & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#A4C639" ), "{n}", "34–38%" )
			    & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#2E7D32" ), "{n}", "≥ 38%" ) & "</div>"
		displayFolder: Inteligência Competitiva\8. HTML
		lineageTag: dc5824c4-7026-4241-8a1c-bae0264e5145

	measure 'CI Legenda Preenchimento' =
			VAR it = "<div style='display:flex;align-items:center;gap:6px;margin-top:5px'><span style='width:12px;height:12px;background:{c};display:inline-block'></span>{n}</div>"
			RETURN "<style>html,body{margin:0;overflow:hidden}</style><div style='font-family:Segoe UI,Arial,sans-serif;font-size:12px;color:#333;padding:4px 8px'><b>Meta de preenchimento</b>"
			    & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#C0392B" ), "{n}", "&lt; 30%" )
			    & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#E67E22" ), "{n}", "30–50%" )
			    & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#A4C639" ), "{n}", "50–75%" )
			    & SUBSTITUTE ( SUBSTITUTE ( it, "{c}", "#2E7D32" ), "{n}", "≥ 75% (meta)" ) & "</div>"
		displayFolder: Inteligência Competitiva\8. HTML
		lineageTag: 1e19540c-1d4c-45a9-a612-34b786d33f9b

	measure 'CI Nota Dispersão' =
			VAR _t = CALCULATETABLE ( ci_oportunidades, KEEPFILTERS ( ci_oportunidades[resultado] IN { "Ganha", "Perdida", "Cancelada" } ), KEEPFILTERS ( NOT ISBLANK ( ci_oportunidades[delta_preco] ) ) )
			VAR n = COUNTROWS ( _t )
			VAR a = COUNTROWS ( FILTER ( _t, ci_oportunidades[delta_preco] > 0 ) )
			RETURN IF ( n > 0, FORMAT ( DIVIDE ( a, n ), "0%" ) & " dos " & FORMAT ( n, "#,0" ) & " negócios ficam acima da paridade (JD mais caro) · apenas preço do concorrente > R$ 1.000", "Sem negócios com preço do concorrente no filtro" )
		displayFolder: Inteligência Competitiva\5. Preço
		lineageTag: 10875d88-6b18-4a97-91ba-64bbfdb69a1c

	measure 'CI Filial Principal (P+C)' = MAXX ( TOPN ( 1, FILTER ( VALUES ( ci_oportunidades[filial_sigla] ), [CI Perdidas + Canceladas] > 0 ), [CI Perdidas + Canceladas], DESC, ci_oportunidades[filial_sigla], ASC ), ci_oportunidades[filial_sigla] )
		displayFolder: Inteligência Competitiva\4. Onde perdemos
		lineageTag: 4a8eaa9e-d146-49ef-b2a8-cf0a947ce98e

	/// Cor do texto do concorrente principal (mais escura que a bolha para o cinza-claro).
	measure 'CI Fonte Concorrente Principal' = IF ( [CI Concorrente Principal] = "Não informado", "#9E9E9E", [CI Cor Concorrente] )
		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: e111e769-5376-4f26-9778-9cfcfd3b5fb0

