		lineageTag: c84b21a4-46e2-4e3f-931e-a7abc3e2751e

	/// Canceladas com zero explícito (mostra todos os motivos da lista oficial).
	measure 'CI Canceladas (0)' = [CI Canceladas] + 0
		formatString: #,0
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: d52694cc-333b-4de3-bd9a-667b10e269d4

	measure 'CI Perdidas + Canceladas' = CALCULATE ( COUNTROWS ( ci_oportunidades ), KEEPFILTERS ( ci_oportunidades[resultado] IN { "Perdida", "Cancelada" } ) )
		formatString: #,0
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: 039fff86-3b74-4423-a836-996dbd594435

	measure 'CI Conversão %' = DIVIDE ( [CI Ganhas], [CI Encerradas] )
		formatString: 0.0%
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: b08bd7ee-fb01-43f1-a95e-f510721dc126

	measure 'CI % Perdidas' = DIVIDE ( [CI Perdidas], [CI Encerradas] )
