	measure 'CI Sub Motivo Identificável' =
			VAR m = [CI Motivo Nº1 Identificável]
			VAR q = CALCULATE ( [CI Perdidas], ci_motivo_perda[motivo] = m )
			RETURN IF ( ISBLANK ( m ), "", FORMAT ( q, "#,0" ) & " perdas · " & FORMAT ( DIVIDE ( q, [CI Perdidas c/ Motivo] ), "0.0%" ) & " das com motivo" )
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: 9153072c-d9d9-451d-94fe-329349da83bb

	measure 'CI Sub Município Top' =
			VAR m = [CI Município Top]
			VAR q = CALCULATE ( [CI Perdidas + Canceladas], ci_oportunidades[cidade] = m )
			VAR uf = CALCULATE ( MAX ( ci_oportunidades[uf] ), ci_oportunidades[cidade] = m )
			RETURN IF ( ISBLANK ( m ), "", FORMAT ( q, "#,0" ) & " negócios · " & uf )
		displayFolder: Inteligência Competitiva\8. Cards
