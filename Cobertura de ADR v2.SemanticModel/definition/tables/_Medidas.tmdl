			VAR p = [CI % Canceladas c/ Motivo]
			VAR st = SWITCH ( TRUE (), ISBLANK ( p ), "", p < 0.50, "Crítico · ", p < 0.80, "Atenção · ", "Bom · " )
			RETURN st & FORMAT ( [CI Canceladas c/ Motivo] + 0, "#,0" ) & " de " & FORMAT ( [CI Canceladas] + 0, "#,0" ) & " · campo criado em out/26"
