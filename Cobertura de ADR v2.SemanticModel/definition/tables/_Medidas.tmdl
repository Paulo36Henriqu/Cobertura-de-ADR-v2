	/// Dias desde a última agenda concluída no CRM.
	measure 'C360 Dias sem Contato' =
			VAR _u = [C360 Última Visita]
			RETURN IF ( NOT ISBLANK ( _u ), INT ( NOW () - _u ) )
		formatString: #,0 "d"
		displayFolder: Cliente 360\1. Cartões
