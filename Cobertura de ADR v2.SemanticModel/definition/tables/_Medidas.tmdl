	/// Valor das oportunidades em aberto no CRM.
	measure 'C360 Pipeline Aberto' = COALESCE ( CALCULATE ( SUM ( c360_oportunidades[preco_total] ), c360_oportunidades[resultado] = "Aberta" ), 0 )
