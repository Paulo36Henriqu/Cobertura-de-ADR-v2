	measure '% Meta Vendas' = DIVIDE ( [Ganhas FY (base M.S.)], [Vendas Meta] )
		formatString: 0%
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: bd0e135c-1ff6-40c3-be5e-51d65511574a

	/// Fração das vendas do ano fiscal (nov–out) esperada até a data de referência, pela sazonalidade de cada produto (dSazonalidade: meses fechados + fração do mês corrente). Com vários produtos, média ponderada pelas Vendas Meta.
	measure '% Esperado FY' =
			VAR af = MAX ( siscobertura_projecao_industria[ano_fiscal] )
			VAR ref = INT ( CALCULATE ( MAX ( siscobertura_projecao_industria[data_atualizacao] ), REMOVEFILTERS () ) )
			VAR ini = DATE ( af - 1, 11, 1 )
			VAR fim = DATE ( af, 11, 1 )
			-- mês fiscal da data de referência (1 = nov … 12 = out) e fração já decorrida desse mês
			VAR mf = ( YEAR ( ref ) - YEAR ( ini ) ) * 12 + MONTH ( ref ) - 10
			VAR frac = DIVIDE ( DAY ( ref ) - 1, DAY ( EOMONTH ( ref, 0 ) ) )
			VAR _Curva =
			    ADDCOLUMNS (
			        VALUES ( dProduto[produto] ),
			        "@vm", [Vendas Meta],
			        "@acum",
			            VAR p = dProduto[produto]
			            RETURN
			                SUMX ( FILTER ( dSazonalidade, dSazonalidade[produto] = p && dSazonalidade[mes_fiscal] < mf ), dSazonalidade[peso] )
			                    + frac * SUMX ( FILTER ( dSazonalidade, dSazonalidade[produto] = p && dSazonalidade[mes_fiscal] = mf ), dSazonalidade[peso] )
			    )
			VAR _tot = SUMX ( _Curva, [@vm] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( af ), BLANK (),
			        ref < ini, 0,
			        ref >= fim, 1,
			        _tot > 0, DIVIDE ( SUMX ( _Curva, [@vm] * [@acum] ), _tot ),
			        AVERAGEX ( _Curva, [@acum] )
			    )
		formatString: 0%
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: e91ff4d5-1943-40ca-8b45-8a193da3a9e2

	/// Meta CEN (TR + CA). Com filtro de produto, rateada pelo mix de vendas da meta projetada da sub-região.
	measure 'Meta CEN' =
			-- Meta CEN é de TR + CA. Com filtro de produto, a meta de cada sub-região é rateada
			-- pelo mix de vendas da meta (projeção) dos produtos selecionados nessa sub-região.
			SUMX (
			    VALUES ( siscobertura_param_metas_cen[chave_sr] ),
			    VAR _meta = CALCULATE ( SUM ( siscobertura_param_metas_cen[meta] ) )
			    VAR _sr = TREATAS ( { siscobertura_param_metas_cen[chave_sr] }, siscobertura_projecao_produto[chave_sr] )
			    VAR _sel = CALCULATE ( [Vendas Meta], _sr, KEEPFILTERS ( dProduto[grupo] IN { "TR", "CA" } ) )
			    VAR _tot = CALCULATE ( [Vendas Meta], _sr, REMOVEFILTERS ( dProduto ), dProduto[grupo] IN { "TR", "CA" } )
			    RETURN IF ( ISFILTERED ( dProduto ), _meta * DIVIDE ( _sel, _tot ), _meta )
			)
		formatString: #,0
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: 1add808a-15cb-4cc2-85a8-43053720671f

	/// Ganhas FY por sub-região da meta CEN (a meta CEN cobre TR + CA).
	measure 'Ganhas FY (CEN)' =
			CALCULATE (
			    [Ganhas FY],
			    TREATAS ( VALUES ( siscobertura_param_metas_cen[chave_sr] ), siscobertura_projecao_produto[chave_sr] ),
			    KEEPFILTERS ( dProduto[grupo] IN { "TR", "CA" } )
			)
		formatString: #,0
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: d590f2fd-db47-40ee-838c-cf265f5b537f

	/// Meta CEN × sazonalidade dos produtos da meta (TR + CA).
	measure 'Meta Esperada até Hoje' = [Meta CEN] * CALCULATE ( [% Esperado FY], KEEPFILTERS ( dProduto[grupo] IN { "TR", "CA" } ) )
		formatString: #,0
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: a9acc5fc-5b65-4c17-988a-1c9cc0bc581a

	measure 'Cor Meta' =
			VAR pe = DIVIDE ( [Ganhas FY (CEN)], [Meta Esperada até Hoje] )
			RETURN SWITCH ( TRUE (), pe >= 1, "#367C2B", pe >= 0.8, "#A8C23A", pe >= 0.5, "#E67E22", "#C0392B" )
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: d92be4f7-b454-41c1-8e93-6ab02b90789d

	measure 'Cor % Meta Cidade' =
			VAR pm = [% Meta Vendas]
			VAR e = [% Esperado FY]
			RETURN SWITCH ( TRUE (), ISBLANK ( pm ), BLANK (), pm >= e, "#367C2B", pm >= e * 0.8, "#A8C23A", pm >= e * 0.5, "#E67E22", "#C0392B" )
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: 8337462b-2725-41b2-b2e7-0386586dc43c

