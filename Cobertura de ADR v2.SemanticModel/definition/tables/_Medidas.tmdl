			VAR _con = SUM ( c360_maquinas[conectada] )
			RETURN FORMAT ( COALESCE ( _jd, 0 ), "#,0" ) & " JD · " & FORMAT ( COALESCE ( _con, 0 ), "#,0" ) & " comunicando"
