	/// Indústria do contexto ÷ indústria do(s) estado(s)/grupo(s) envolvidos. Na linha cidade x produto = fatia da cidade no estado; no total geral = 100%; com um produto filtrado = participação do produto na indústria do grupo.
	measure 'Participação Estado' =
			VAR _ind = [Indústria Projetada]
			VAR _base =
			    SUMX (
			        SUMMARIZE ( siscobertura_projecao_produto, siscobertura_projecao_produto[estado], siscobertura_projecao_produto[chave_param] ),
			        CALCULATE ( MAX ( siscobertura_projecao_produto[industria_estado] ) )
			    )
			RETURN DIVIDE ( _ind, _base )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Cobertura\4. Indústria e meta
		lineageTag: cd300b8a-9023-477a-a3c1-e9e4d02d418d

