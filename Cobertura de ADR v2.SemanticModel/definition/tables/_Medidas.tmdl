	measure 'CI Cor KPI Sem Concorrente' = VAR p = [CI % P+C sem Concorrente] RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#222222", p > 0.70, "#C0392B", p > 0.40, "#E67E22", "#2E7D32" )
