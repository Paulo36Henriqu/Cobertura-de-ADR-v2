			VAR _at = MAX ( c360_erp[maior_atraso_dias] )
			RETURN "Em aberto R$ " & FORMAT ( COALESCE ( _ab, 0 ), "#,0" ) & IF ( _at > 0, " · atraso " & _at & " d" )
		displayFolder: Cliente 360\1. Cartões
