		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: cd6b04a2-e6d6-417a-b51a-4ef1544631e2

	measure 'CI Valor Perdidas' = CALCULATE ( SUM ( ci_oportunidades[preco_total] ), KEEPFILTERS ( ci_oportunidades[resultado] = "Perdida" ) )
		formatString: "R$" #,0
		displayFolder: Inteligência Competitiva\1. Base
		lineageTag: 013b48b3-a521-4ca6-b54a-26019b9ce6f9

	measure 'CI Valor Canceladas' = CALCULATE ( SUM ( ci_oportunidades[preco_total] ), KEEPFILTERS ( ci_oportunidades[resultado] = "Cancelada" ) )
		formatString: "R$" #,0
		displayFolder: Inteligência Competitiva\1. Base
