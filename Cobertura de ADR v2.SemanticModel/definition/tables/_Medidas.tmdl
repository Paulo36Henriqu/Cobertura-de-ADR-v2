	measure 'CI Sub Δ Preço' = VAR d = [CI Δ Preço Mediano] RETURN IF ( ISBLANK ( d ), "sem preço de concorrente", IF ( d > 0, "JD mais caro", "JD mais barato" ) & " em " & [CI Linha] )
		displayFolder: Inteligência Competitiva\8. Cards
