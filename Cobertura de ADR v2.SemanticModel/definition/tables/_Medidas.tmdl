		displayFolder: Inteligência Competitiva\9. Cores
		lineageTag: b6a44fcb-d7b8-4b72-8f84-0f392ad1413d

	/// Demanda por grupo econômico: soma as máquinas fracionadas de todos os clientes do grupo (unidade da segmentação) e só então arredonda para cima, com a regra de área mínima aplicada à área somada do grupo (exceto TRCE) — mesma regra do Sistema de Cobertura (calculos._demanda). Se o parque do grupo passa da demanda, a demanda sobe até o parque (cobertura máxima de 100%). PL (linhas) só entra quando o contexto é apenas PL.
	measure 'Demanda Grupos' = ```
			
					VAR _min = VALUE ( LOOKUPVALUE ( siscobertura_param_geral[valor], siscobertura_param_geral[chave], "area_minima_ha" ) )
					VAR _soPL = SELECTEDVALUE ( dProduto[produto] ) = "PL"
					VAR _t =
					    FILTER (
					        SUMMARIZE ( siscobertura_cliente_produto, siscobertura_cliente_produto[grupo_chave], siscobertura_cliente_produto[produto] ),
					        _soPL || siscobertura_cliente_produto[produto] <> "PL"
					    )
					RETURN
					    SUMX (
					        _t,
					        VAR _f = CALCULATE ( SUM ( siscobertura_cliente_produto[demanda_fracionada] ) )
					        VAR _a = CALCULATE ( SUM ( siscobertura_cliente_produto[area_base_ha] ) )
					        VAR _d = IF ( _a >= _min || siscobertura_cliente_produto[produto] = "TRCE", ROUNDUP ( ROUND ( _f, 6 ), 0 ), 0 )
					        VAR _p = CALCULATE ( SUM ( siscobertura_cliente_produto[parque_valido] ) )
					        RETURN MAX ( _d, _p )
					    )
			```
		formatString: #,0
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: 767c15d7-6fe2-4d0c-b1c9-ff6a9826a606

	/// Parque válido dos clientes do grupo (soma por CPF/CNPJ). PL só entra quando o contexto é apenas PL.
	measure 'Parque Grupos' = [Parque Clientes]
		formatString: #,0
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: 03bb5236-ebf5-4bdd-9257-f78966ec44bc

	measure '% Cobertura Grupos' = DIVIDE ( [Parque Grupos], [Demanda Grupos] )
		formatString: 0.0%
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: 7a434ad1-7f1c-4ea8-98b1-fc9c8f1ae090

	measure '% Cobertura Grupos (≤150%)' = MIN ( [% Cobertura Grupos], 1.5 )
		formatString: 0%
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: 2701e91d-e35a-4725-8ada-38f4cf7fb8f1

	/// Gap por grupo econômico e produto: max(0, demanda do grupo − parque do grupo). O excedente de um cliente compensa a falta de outro do mesmo grupo.
	measure 'Gap Grupos' =
			VAR _min = VALUE ( LOOKUPVALUE ( siscobertura_param_geral[valor], siscobertura_param_geral[chave], "area_minima_ha" ) )
			VAR _soPL = SELECTEDVALUE ( dProduto[produto] ) = "PL"
			VAR _t =
			    FILTER (
			        SUMMARIZE ( siscobertura_cliente_produto, siscobertura_cliente_produto[grupo_chave], siscobertura_cliente_produto[produto] ),
			        _soPL || siscobertura_cliente_produto[produto] <> "PL"
			    )
			RETURN
			    SUMX (
			        _t,
			        VAR _f = CALCULATE ( SUM ( siscobertura_cliente_produto[demanda_fracionada] ) )
			        VAR _a = CALCULATE ( SUM ( siscobertura_cliente_produto[area_base_ha] ) )
			        VAR _d = IF ( _a >= _min || siscobertura_cliente_produto[produto] = "TRCE", ROUNDUP ( ROUND ( _f, 6 ), 0 ), 0 )
			        VAR _p = CALCULATE ( SUM ( siscobertura_cliente_produto[parque_valido] ) )
			        RETURN MAX ( 0, _d - _p )
			    )
		formatString: #,0
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: 1b730b6d-f425-4811-97d4-b861d8e9314e

	/// Grupos econômicos / unidades da segmentação com propriedades no sistema de cobertura.
	measure 'Grupos Cobertura' = DISTINCTCOUNT ( siscobertura_cliente_produto[grupo_chave] )
		formatString: #,0
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: dfc5250a-c69f-4022-b1ac-2d526a8eda09

	/// Grupos com 2 ou mais clientes (CPF/CNPJ) na cobertura.
	measure 'Grupos Multicliente' = COUNTROWS ( FILTER ( VALUES ( siscobertura_cliente_produto[grupo_chave] ), CALCULATE ( DISTINCTCOUNT ( siscobertura_cliente_produto[cliente_id] ) ) > 1 ) )
		formatString: #,0
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: fc00ecb0-be9e-4d8f-8f35-009e48d6e956

	measure 'Grupos com Gap' = COUNTROWS ( FILTER ( VALUES ( siscobertura_cliente_produto[grupo_chave] ), [Gap Grupos] > 0 ) )
		formatString: #,0
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: a2030ba1-e1f2-4b36-84d7-0b0879ed796d

	/// Demanda calculada no grupo menos a soma das demandas por cliente (efeito do arredondamento e da área mínima aplicados ao grupo).
	measure 'Demanda Consolidação' = [Demanda Grupos] - [Demanda Clientes]
		formatString: +#,0;-#,0;0
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: 77dfa37c-c94c-49e0-a63a-4c233aa5d064

	measure 'Cor Cobertura Grupos' = ```
			
					VAR p = [% Cobertura Grupos]
					RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#BDBDBD", p < 0.1, "#C0392B", p < 0.2, "#E67E22", p < 0.4, "#A8C23A", "#367C2B" )
			```
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: c2f95cf6-16f1-43ee-989f-aecf3fc3008b

	/// Potencial anual (segmentação) das unidades presentes no contexto da cobertura, contado uma vez por unidade.
	measure 'Potencial Grupos' = CALCULATE ( [Potencial Total], siscobertura_cliente_produto )
		formatString: \R$ #,0.0
		displayFolder: Cobertura\10. Grupos econômicos
		lineageTag: 3a3faf3a-4c5d-4db5-93e7-8e745bab412a

	/// Faturamento anualizado (segmentação) das unidades presentes no contexto da cobertura.
