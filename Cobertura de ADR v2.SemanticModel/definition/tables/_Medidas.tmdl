			VAR _n = CALCULATE ( COUNTROWS ( c360_oportunidades ), c360_oportunidades[resultado] = "Aberta" )
			VAR _q = CALCULATE ( COUNTROWS ( c360_oportunidades ), c360_oportunidades[resultado] = "Aberta", c360_oportunidades[temperatura] = "QUENTE" )
			RETURN FORMAT ( COALESCE ( _n, 0 ), "#,0" ) & " negócios · " & FORMAT ( COALESCE ( _q, 0 ), "#,0" ) & " quentes"
		displayFolder: Cliente 360\1. Cartões
		lineageTag: 112d3fdd-fa71-4824-a6a4-6d69efa7b0a3

	/// Valor das oportunidades ganhas (faturadas) nos últimos 24 meses.
	measure 'C360 Ganhas 24m' = COALESCE ( CALCULATE ( SUM ( c360_oportunidades[preco_total] ), c360_oportunidades[resultado] = "Ganha", c360_oportunidades[data_ref] >= EDATE ( TODAY (), -24 ) ), 0 )
		formatString: "R$"\ #,0
		displayFolder: Cliente 360\1. Cartões
		lineageTag: 4e81ae55-17bc-444e-9013-df6a063ff2d1

	measure 'C360 Sub Ganhas' =
			VAR _ini = EDATE ( TODAY (), -24 )
			VAR _g = CALCULATE ( COUNTROWS ( c360_oportunidades ), c360_oportunidades[resultado] = "Ganha", c360_oportunidades[data_ref] >= _ini )
			VAR _p = CALCULATE ( COUNTROWS ( c360_oportunidades ), c360_oportunidades[resultado] = "Perdida", c360_oportunidades[data_ref] >= _ini )
			RETURN FORMAT ( COALESCE ( _g, 0 ), "#,0" ) & " ganhas · " & FORMAT ( COALESCE ( _p, 0 ), "#,0" ) & " perdidas"
		displayFolder: Cliente 360\1. Cartões
		lineageTag: cb716d62-ffb1-4769-bb78-8526f9edde14

	/// Títulos a receber vencidos no ERP (SE1, sem RA/NCC/abatimentos).
	measure 'C360 Saldo Vencido' = COALESCE ( SUM ( c360_erp[saldo_vencido] ), 0 )
