	measure 'CI Cor KPI Set26' = VAR p = [CI % Perdidas c/ Concorrente desde set/26] RETURN SWITCH ( TRUE (), ISBLANK ( p ), "#222222", p < 0.50, "#C0392B", p < 0.80, "#E67E22", "#2E7D32" )
