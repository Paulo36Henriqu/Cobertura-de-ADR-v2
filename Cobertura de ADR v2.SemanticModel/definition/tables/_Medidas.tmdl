	measure 'CI Sub % Concorrente' =
			VAR p = [CI % P+C c/ Concorrente]
			VAR st = SWITCH ( TRUE (), ISBLANK ( p ), "", p < 0.30, "Crítico · ", p < 0.60, "Atenção · ", "Bom · " )
			RETURN st & FORMAT ( [CI P+C c/ Concorrente] + 0, "#,0" ) & " de " & FORMAT ( [CI Perdidas + Canceladas] + 0, "#,0" ) & " perdidas + canceladas"
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: 2c238fdc-b612-41c4-88bc-3ba6beb5a54e

	measure 'CI Sub Concorrente Nº1' =
			VAR n1 = [CI Concorrente Nº1]
			VAR p = CALCULATE ( [CI Perdidas], ci_oportunidades[concorrente] = n1 ) + 0
			VAR c = CALCULATE ( [CI Canceladas], ci_oportunidades[concorrente] = n1 ) + 0
			RETURN IF ( ISBLANK ( n1 ), "sem concorrente informado", FORMAT ( p + c, "#,0" ) & " negócios (" & FORMAT ( p, "#,0" ) & " perdidos · " & FORMAT ( c, "#,0" ) & " cancelados)" )
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: a2897e97-351c-4627-8785-7ecb16fe7bd1

	measure 'CI Sub Concorrentes Distintos' = "marcas " & [CI Linha] & " após normalização de nomes"
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: c4ed0ffc-9870-44aa-bd05-1d80887ed1a2

	measure 'CI Sub Disputas' = FORMAT ( [CI Ganhas c/ Concorrente] + 0, "#,0" ) & " ganhas · " & FORMAT ( [CI Perdidas c/ Concorrente] + 0, "#,0" ) & " perdidas · " & FORMAT ( [CI Canceladas c/ Concorrente] + 0, "#,0" ) & " canceladas"
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: 8708da07-4aa8-4a6d-af70-c40777b079c5

	measure 'CI Sub Vitória' =
			VAR p = [CI Vitória Confronto %]
			VAR st = SWITCH ( TRUE (), ISBLANK ( p ), "", p < 0.25, "Crítico · ", p < 0.40, "Atenção · ", "Bom · " )
			RETURN st & FORMAT ( [CI Ganhas c/ Concorrente] + 0, "#,0" ) & " ganhas × " & FORMAT ( [CI Perdidas c/ Concorrente] + 0, "#,0" ) & " perdidas"
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: bd072fca-766b-4350-82d0-1eb6b1217d83

	measure 'CI Sub Líder' =
			VAR n1 = [CI Concorrente Nº1]
			VAR q = CALCULATE ( [CI P+C c/ Concorrente], ci_oportunidades[concorrente] = n1 )
			RETURN FORMAT ( q + 0, "#,0" ) & " perdidas + cancel. · " & FORMAT ( DIVIDE ( q, [CI P+C c/ Concorrente] ), "0.0%" ) & " das com concorrente"
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: 2692ca75-868a-452a-843e-02dc19df8a87

	measure 'CI Sub Set26' =
			VAR p = [CI % Perdidas c/ Concorrente desde set/26]
			VAR a = CALCULATE ( [CI Perdidas c/ Concorrente], KEEPFILTERS ( ci_oportunidades[data_ref] < DATE ( 2026, 9, 1 ) ) ) + 0
			VAR b = CALCULATE ( [CI Perdidas], KEEPFILTERS ( ci_oportunidades[data_ref] < DATE ( 2026, 9, 1 ) ) ) + 0
			VAR st = SWITCH ( TRUE (), ISBLANK ( p ), "", p < 0.50, "Crítico · ", p < 0.80, "Atenção · ", "Bom · " )
			RETURN st & "antes: " & FORMAT ( a, "#,0" ) & " de " & FORMAT ( b, "#,0" ) & " perdas (" & FORMAT ( DIVIDE ( a, b ), "0%" ) & ")"
		displayFolder: Inteligência Competitiva\8. Cards
		lineageTag: 4eeb5938-b07f-46fb-b629-648b51ab0b10

	measure 'CI Sub Perdidas Valor' = "R$ " & FORMAT ( [CI Valor Perdidas] / 1e6, "#,0" ) & " Mi · " & [CI Rótulo Período]
