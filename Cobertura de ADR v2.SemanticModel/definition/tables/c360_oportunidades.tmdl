	partition c360_oportunidades = m
		mode: import
		source =
				let
				  Fonte = Sql.Database("10.14.152.11", "DB_MKT", [Query = "SELECT o.id, o.cliente_id, o.linha, CASE WHEN fa.valor LIKE '%FATURADA%' OR fa.valor = 'REFATURADO' THEN 'Ganha' WHEN fa.valor LIKE '%PERDIDA%' THEN 'Perdida' WHEN fa.valor LIKE '%CANCELADA%' THEN 'Cancelada' ELSE 'Aberta' END AS resultado, ISNULL(fa.valor, '-') AS fase, ISNULL(tp.valor, '-') AS temperatura, ISNULL(tn.valor, '-') AS tipo_negocio, o.produto, o.modelo, o.quantidade, o.preco_total, o.data_criacao, o.data_estimada, o.data_encerramento, o.data_faturamento, COALESCE(o.data_encerramento, o.data_faturamento, o.data_criacao) AS data_ref, ISNULL(u.nome, '(Sem vendedor)') AS vendedor, NULLIF(LTRIM(RTRIM(o.concorrente)), '') AS concorrente, NULLIF(LTRIM(RTRIM(o.modelo_concorrente)), '') AS modelo_concorrente, CASE WHEN fa.valor LIKE '%PERDIDA%' THEN mp.valor END AS motivo_perda, o.chassi FROM DB_MKT_CRM_JD_CE.dbo.oportunidades o JOIN DB_MKT.dbo.segclientes_vw_clientes_atual c ON c.cliente_id = o.cliente_id LEFT JOIN DB_MKT_CRM_JD_CE.dbo.configuracao_valores fa ON fa.id = o.fase_id LEFT JOIN DB_MKT_CRM_JD_CE.dbo.configuracao_valores tp ON tp.id = o.temperatura_id LEFT JOIN DB_MKT_CRM_JD_CE.dbo.configuracao_valores tn ON tn.id = o.tipo_negocio_id LEFT JOIN DB_MKT_CRM_JD_CE.dbo.configuracao_valores mp ON mp.id = o.motivo_perda_id LEFT JOIN DB_MKT_CRM_JD_CE.dbo.usuarios u ON u.id = o.vendedor_id WHERE o.deletado = 0"])
				in
				  Fonte

