/// Faixas de área do grupo econômico (unidade da Segmentação) para a tabela de oportunidade por município. Grupos < 100 ha ficam fora. venda_media = faturamento anualizado médio dos grupos da faixa que compraram (faturamento_base > 0).
table dFaixaArea
	lineageTag: fc42e40c-28d9-4ed1-92cc-3185f00aed8c

	column faixa
		lineageTag: b62b96da-ead3-4f8c-8e4f-09c4e3437bbe
		isNameInferred
		sourceColumn: [faixa]
		sortByColumn: ordem

	column ordem
		isHidden
		lineageTag: 8f2fa742-2475-497f-a72d-a9b9e5c9fb0e
		isNameInferred
		sourceColumn: [ordem]

	column min_ha
		isHidden
		lineageTag: 2b6b2c94-e44b-4d08-9ae8-0c3dbed4b3b5
		isNameInferred
		sourceColumn: [min_ha]

	column max_ha
		isHidden
		lineageTag: 0c484cd7-4dc4-43e2-a2f2-55dea70e3601
		isNameInferred
		sourceColumn: [max_ha]

	column venda_media
		isHidden
		lineageTag: a1214d88-dc25-41e6-83df-f939967affeb
		isNameInferred
		sourceColumn: [venda_media]

	partition dFaixaArea = calculated
		mode: import
		source =
				VAR _fx = DATATABLE ( "faixa", STRING, "ordem", INTEGER, "min_ha", DOUBLE, "max_ha", DOUBLE, { { "100 a 500 ha", 1, 100, 500 }, { "500 a 1.000 ha", 2, 500, 1000 }, { "1.000 a 3.000 ha", 3, 1000, 3000 }, { "Acima de 3.000 ha", 4, 3000, 999999999 } } )
				RETURN
				    ADDCOLUMNS (
				        _fx,
				        "venda_media",
				            AVERAGEX (
				                FILTER (
				                    segclientes_vw_unidades_atual,
				                    segclientes_vw_unidades_atual[area_ha] >= [min_ha]
				                        && segclientes_vw_unidades_atual[area_ha] < [max_ha]
				                        && segclientes_vw_unidades_atual[faturamento_base] > 0
				                ),
				                segclientes_vw_unidades_atual[faturamento_base]
				            )
				    )

