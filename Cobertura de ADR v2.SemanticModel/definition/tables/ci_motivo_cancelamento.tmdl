/// Lista oficial de motivos de cancelamento do CRM (Inteligência Competitiva).
table ci_motivo_cancelamento
	lineageTag: ff2d07d2-c898-4b93-9667-489d49514d9b

	column motivo
		lineageTag: ad87650e-99ec-4c55-9927-fb1bcf698210
		isNameInferred
		sourceColumn: [motivo]
		sortByColumn: ordem

	column ordem
		isHidden
		lineageTag: 72c4c7fb-a560-46c7-be30-d854a6e693c6
		summarizeBy: none
		isNameInferred
		sourceColumn: [ordem]

	partition ci_motivo_cancelamento = calculated
		mode: import
		source = DATATABLE ( "motivo", STRING, "ordem", INTEGER, { { "Desistiu da compra", 1 }, { "Adiou a compra", 2 }, { "Sem recurso / crédito", 3 }, { "Mudança de projeto ou prioridade", 4 }, { "Comprou usado", 5 }, { "Outros", 6 }, { "(Sem motivo)", 7 } } )

