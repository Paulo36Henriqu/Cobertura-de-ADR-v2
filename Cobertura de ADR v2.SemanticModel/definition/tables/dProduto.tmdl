		isNameInferred
		sourceColumn: [ordem]

	column descricao
		lineageTag: 5691e27e-9982-4162-bb33-684034540edf
		isNameInferred
		sourceColumn: [descricao]

	/// Produto agrupado (TR, CA, PV, PL): é o filtro "Produto" das páginas de Cobertura.
	column grupo
		lineageTag: d4fe9ef0-7026-4d1f-9d40-1fad95284941
