				        { "CA M", 6, "Colheitadeiras médias (S5)", "CA", "#3FA7A7", "Médio", 2, 0.49, "CA M", 2 },
				        { "CA P", 7, "Colheitadeiras pequenas (S4)", "CA", "#8FD1C9", "Pequeno", 1, 0.49, "CA P", 2 },
