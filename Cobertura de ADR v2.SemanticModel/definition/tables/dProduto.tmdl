				    {
				        { "TR G", 1, "Tratores grandes (grãos)", "TR", "#1F3A5F", "Grande", 3, 0.60, "TR G", 1 },
				        { "TR6", 2, "Tratores série 6 maiores (grãos)", "TR", "#3E6FB0", "Médio", 2, 0.40, "TR6", 1 },
