		sourceColumn: [cor]

	/// Porte para a meta de M.S. acordada com a John Deere (até 2030): TR5/TRCE = Pequeno, TR6 = Médio, TR G = Grande; CA pela série (S4/S5/S6-S7-X9). PV/PL = Sem porte.
	column porte
		lineageTag: 66d50c6a-491d-45f3-9191-249dc89e2a68
		isNameInferred
		sourceColumn: [porte]
		sortByColumn: porte_ordem

	column porte_ordem
