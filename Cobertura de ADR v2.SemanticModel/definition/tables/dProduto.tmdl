		lineageTag: f678c905-edfb-457c-b130-1f738cdd5caf
		summarizeBy: none
		isNameInferred
		sourceColumn: [porte_ordem]

	/// Meta de M.S. acordada com a John Deere até 2030 (TR 34/40/60%, CA 49/49/60%). Vazio = usa a meta do grupo em siscobertura_param_industria.
	column meta_ms
		formatString: 0%
		lineageTag: 418b52e3-0a0e-41fc-9cf0-21a8eaa97303
		summarizeBy: none
		isNameInferred
		sourceColumn: [meta_ms]

	/// Segmentação detalhada do produto (TR G, TR6, TR5, TRCE, CA G, CA M, CA P, PV, PL): é o filtro "Segmento" das páginas de Cobertura.
	column segmento
		lineageTag: c14371c1-e569-4ce9-9cba-da215c062ef5
		isNameInferred
		sourceColumn: [segmento]
		sortByColumn: ordem

	column grupo_ordem
		isHidden
		lineageTag: d4e52320-fcc5-4523-a92b-007c5448ada4
		summarizeBy: none
		isNameInferred
		sourceColumn: [grupo_ordem]

	partition dProduto = calculated
