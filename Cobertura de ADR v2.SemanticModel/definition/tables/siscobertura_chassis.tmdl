		variation Variation
			isDefault
			relationship: f7fbda3a-d726-4c7e-bfed-5db0fe3ef04c
			defaultHierarchy: LocalDateTable_2bf18502-43dd-4bb1-b54d-93bd675ec7b7.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column ano_ordem = IF ( ISBLANK ( siscobertura_chassis[ano_modelo] ), BLANK (), MAX ( siscobertura_chassis[ano_modelo], 2005 ) )
		dataType: int64
		isHidden
		lineageTag: 5bd893b5-7c75-48ba-8b07-47e42fdc1d1d
		summarizeBy: none

	column situacao = IF ( siscobertura_chassis[valido], "Válido", "Vencido" )
		dataType: string
		lineageTag: 0d8f3ece-b030-43c8-b3f8-64bc7f7a09a1

	column origem_cidade = SWITCH ( siscobertura_chassis[origem_ibge], "planilha cidades corrigidas", "Planilha corrigida", "municipio do ERP", "Município do ERP", "Sem cidade" )
		dataType: string
		lineageTag: 76daf7dd-763f-48cc-a0ce-ab0f75577231

	column ano_faixa = IF ( ISBLANK ( siscobertura_chassis[ano_modelo] ), BLANK (), IF ( siscobertura_chassis[ano_modelo] <= 2005, "≤05", "'" & RIGHT ( FORMAT ( siscobertura_chassis[ano_modelo], "0" ), 2 ) ) )
		dataType: string
		lineageTag: eca68b4a-0580-4d87-82a0-9ab7572d5183
		sortByColumn: ano_ordem

	column corrigir = ISBLANK ( siscobertura_chassis[id_ibge] ) && siscobertura_chassis[produto] <> ""
		dataType: boolean
		isHidden
		lineageTag: 3d080388-5497-4a04-ad06-fd41107a0557

