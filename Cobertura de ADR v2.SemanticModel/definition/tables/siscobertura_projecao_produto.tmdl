	/// Share de frota JD na cidade×produto = MIN(100%, parque válido ÷ demanda). Base dos cenários de meta de M.S.
	column share_frota
		formatString: 0.0%
		lineageTag: fe7541df-f95b-4be8-8a0f-b73cf3a6ffed
		summarizeBy: none
		isNameInferred
		sourceColumn: [share_frota]

	partition siscobertura_projecao_produto = calculated
		mode: import
		source =
				VAR _Mapa =
				    DATATABLE (
				        "m_produto", STRING, "m_grupo", STRING,
				        { { "TR G", "TR" }, { "TR6", "TR" }, { "TR5", "TR" }, { "TRCE", "TR" }, { "CA G", "CA" }, { "CA M", "CA" }, { "CA P", "CA" } }
				    )
				-- PV e PL não têm indústria oficial: indústria = demanda × renovação de 10%/ano (PL em linhas ÷ 22 = unidades); meta de M.S. e conversão do TR
				VAR _SemIndustria = { "PV", "PL" }
				VAR _TaxaRenovacao = 0.10
				VAR _LinhasPorPL = 22
				VAR _Chaves = DISTINCT ( siscobertura_param_industria[grupo] )
				VAR _AnoFiscal = MAX ( siscobertura_projecao_industria[ano_fiscal] )
				VAR _Base =
				    ADDCOLUMNS (
				        SELECTCOLUMNS (
				            siscobertura_cidade_produto,
				            "id_ibge", siscobertura_cidade_produto[id_ibge],
				            "produto", siscobertura_cidade_produto[produto],
				            "estado", siscobertura_cidade_produto[estado],
				            "chave_sr", UPPER ( siscobertura_cidade_produto[filial] ) & "|" & siscobertura_cidade_produto[sub_regiao],
				            "demanda", siscobertura_cidade_produto[demanda_calculada],
				            "parque_valido", siscobertura_cidade_produto[parque_valido],
				            "crm_ganhas_fy", siscobertura_cidade_produto[crm_ganhas_fy],
				            "crm_perdidas_fy", siscobertura_cidade_produto[crm_perdidas_fy],
				            "crm_abertas", siscobertura_cidade_produto[crm_abertas]
				        ),
				        "chave_param",
				            VAR p = [produto]
				            RETURN IF ( p IN _Chaves || p IN _SemIndustria, p, MAXX ( FILTER ( _Mapa, [m_produto] = p ), [m_grupo] ) ),
				        "base_ms",
				            VAR p = [produto]
				            RETURN p IN _Chaves || p IN _SemIndustria || LOOKUPVALUE ( dProduto[grupo], dProduto[produto], p ) IN _Chaves
				    )
				VAR _Estado =
				    ADDCOLUMNS (
				        _Base,
				        "demanda_estado",
				            VAR c = [chave_param]
				            VAR e = [estado]
				            RETURN IF ( ISBLANK ( c ), 0, SUMX ( FILTER ( _Base, [chave_param] = c && [estado] = e ), [demanda] ) ),
				        "industria_estado",
				            VAR c = [chave_param]
				            VAR e = [estado]
				            RETURN
				                IF (
				                    c IN _SemIndustria,
				                    SUMX ( FILTER ( _Base, [chave_param] = c && [estado] = e ), [demanda] ) * _TaxaRenovacao / IF ( c = "PL", _LinhasPorPL, 1 ),
				                    SUMX (
				                        FILTER ( siscobertura_param_industria,
				                            siscobertura_param_industria[grupo] = c && siscobertura_param_industria[estado] = e ),
				                        siscobertura_param_industria[industria_adr] * siscobertura_param_industria[pct_estado] ) + 0
				                ),
				        "meta_ms",
				            VAR c = IF ( [chave_param] IN _SemIndustria, "TR", [chave_param] )
				            VAR e = [estado]
				            VAR v = MAXX ( FILTER ( siscobertura_param_industria,
				                    siscobertura_param_industria[grupo] = c && siscobertura_param_industria[estado] = e ),
				                siscobertura_param_industria[meta_ms] )
				            -- meta acordada com a John Deere por porte (dProduto[meta_ms]); sem porte usa a do grupo
				            VAR porte = LOOKUPVALUE ( dProduto[meta_ms], dProduto[produto], [produto] )
				            RETURN COALESCE ( porte, v, MAXX ( FILTER ( siscobertura_param_industria, siscobertura_param_industria[grupo] = c ), siscobertura_param_industria[meta_ms] ), 0 ),
				        "taxa_conversao",
				            VAR c = IF ( [chave_param] IN _SemIndustria, "TR", [chave_param] )
				            VAR e = [estado]
				            VAR v = MAXX ( FILTER ( siscobertura_param_industria,
				                    siscobertura_param_industria[grupo] = c && siscobertura_param_industria[estado] = e ),
				                siscobertura_param_industria[taxa_conversao] )
				            RETURN COALESCE ( v, MAXX ( FILTER ( siscobertura_param_industria, siscobertura_param_industria[grupo] = c ), siscobertura_param_industria[taxa_conversao] ), 0 )
				    )
				VAR _Industria =
				    ADDCOLUMNS (
				        _Estado,
				        "participacao_estado", DIVIDE ( [demanda], [demanda_estado], 0 ),
				        "industria_cidade", [industria_estado] * DIVIDE ( [demanda], [demanda_estado], 0 )
				    )
				VAR _Meta =
				    ADDCOLUMNS ( _Industria, "vendas_meta", [industria_cidade] * [meta_ms] )
				RETURN
				    ADDCOLUMNS (
				        _Meta,
				        "negocios_necessarios", DIVIDE ( [vendas_meta], [taxa_conversao], 0 ),
				        "ano_fiscal", _AnoFiscal,
				        "share_frota", MIN ( 1, DIVIDE ( [parque_valido], [demanda], 0 ) )
				    )

